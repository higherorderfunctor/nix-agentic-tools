#!/usr/bin/env bash
# Requires devenv — see https://devenv.sh/getting-started/
#
# This file is deliberate, not leftover scaffolding. Deleting it does not
# "clean up" a redundant layer — it migrates the repo to `devenv hook`, which
# watches nothing while a shell is active and so gives up in-shell reload for a
# manual exit-and-re-enter. It also strips `lib/traceSource.nix` of its only
# remaining consumer. The measurements and what would change the decision are
# in dev/fragments/shell-activation/activation-mechanism.md.
#
# No strict-mode header here: direnv sources this into the calling shell, which
# is the "DO NOT ADD" row of CLAUDE.md's shell table.

eval "$(devenv direnvrc)"
use devenv
