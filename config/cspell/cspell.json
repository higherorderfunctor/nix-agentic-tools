{
  "caseSensitive": false,
  "dictionaries": ["bash", "git", "project-terms"],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "name": "project-terms",
      "path": "config/cspell/project-terms.txt"
    }
  ],
  "ignorePaths": [
    "**/*package-lock.json",
    "**/go.mod",
    "**/go.sum",
    "*.lock",
    "*.patch",
    "*.png",
    ".direnv",
    ".git",
    ".github/instructions/**",
    "/AGENTS.md",
    "/CONTRIBUTING.md",
    "/README.md",
    "config/cspell",
    "devenv.yaml",
    "docs/**",
    "fixtures/kiro-primitives/evidence/**",
    "fixtures/kiro-primitives/records/**",
    "packages/*/*sources*.json",
    "packages/*/extracted/extracted.json",
    "packages/delegate-routing/docs/delegates/vendor-prompts/**",
    "packages/delegate-routing/probes/delegates/**",
    "packages/kimchi/egress-report.json",
    "packages/kiro-cli/usage/fixtures/codec-golden.json",
    "packages/kiro-cli/usage/rates.json",
    "result"
  ],
  "language": "en",
  "overrides": [
    {
      "dictionaries": ["python", "node", "npm", "rust"],
      "filename": ["**/*.md", "**/*.mjs", "**/*.nix", "**/*.py", "**/*.sh"]
    },
    {
      "filename": "packages/stacked-workflows/checks/scenario-tests/**",
      "words": ["localmain", "nonoverlap", "objectname", "topo"]
    }
  ],
  "version": "0.2"
}
