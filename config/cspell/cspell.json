{
  "caseSensitive": false,
  "dictionaries": ["bash", "git", "project-terms"],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "name": "project-terms",
      "path": "config/cspell/project-terms.txt"
    }
  ],
  "ignorePaths": [
    "**/*package-lock.json",
    "*.lock",
    "*.patch",
    "*.png",
    ".direnv",
    ".git",
    ".github/copilot-instructions.md",
    ".github/instructions/**",
    "/AGENTS.md",
    "/CONTRIBUTING.md",
    "/README.md",
    "config/ai-delivery-generated.nix",
    "config/cspell",
    "devenv.yaml",
    "docs/**",
    "fixtures/kiro-primitives/evidence/**",
    "fixtures/kiro-primitives/records/**",
    "packages/*/*sources*.json",
    "packages/*/extracted.json",
    "packages/*/model-catalog.json",
    "packages/kimchi/egress-report.json",
    "packages/semble/upstream-templates.json",
    "result"
  ],
  "language": "en",
  "overrides": [
    {
      "dictionaries": ["python", "node", "npm", "rust"],
      "filename": ["**/*.md", "**/*.mjs", "**/*.nix", "**/*.py", "**/*.sh"]
    },
    {
      "filename": "packages/stacked-workflows/checks/scenario-tests/**",
      "words": ["localmain", "nonoverlap", "objectname", "topo"]
    }
  ],
  "version": "0.2"
}
