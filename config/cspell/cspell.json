{
  "caseSensitive": false,
  "dictionaries": ["bash", "git", "project-terms"],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "name": "project-terms",
      "path": "config/cspell/project-terms.txt"
    }
  ],
  "ignorePaths": [
    "*.lock",
    "*.png",
    ".direnv",
    ".git",
    "config/cspell",
    "docs/**",
    "fixtures/kiro-primitives/evidence/**",
    "fixtures/kiro-primitives/records/**",
    "overlays/chatgpt-codex-extracted.json",
    "overlays/dev-tools/glab-extracted.json",
    "overlays/sources",
    "result"
  ],
  "language": "en",
  "overrides": [
    {
      "dictionaries": ["python", "node", "npm", "rust"],
      "filename": ["**/*.nix", "**/*.md"]
    }
  ],
  "version": "0.2"
}
