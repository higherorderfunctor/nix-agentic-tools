[GRAMMAR]
ELEMENTS:
- TAG: DECISION
  PROPERTIES:
    PREFIX: DEC-
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: AUTHORED_BY
    TYPE: SingleChoice(llm, llm-accepted, llm-adopted, human)
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(open, accepted, rejected, superseded)
    REQUIRED: True
  - TITLE: RETIRES_ON
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: NOTES
    TYPE: String
    REQUIRED: False
  - TITLE: COMPONENT
    TYPE: Tag
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: Superseded_By
    REVERSE_ROLE: Supersedes
  - TYPE: Parent
    ROLE: Backlogged_In
    REVERSE_ROLE: Backlogs
  - TYPE: Parent
    ROLE: Proven_By
    REVERSE_ROLE: Proves
