+import fs from "fs";
+import path from "path";
+// ─── Local addition (not upstream): save generated images to disk ───────────
+// Returns the absolute-or-relative paths written, [] when nothing was saved.
+//
+// `savePath` ending in an image extension is treated as a FILE:
+//   - one image  -> written to exactly that path
+//   - N images   -> written to <stem>-1<ext>, <stem>-2<ext>, ... <stem>-N<ext>
+// Anything else is treated as a DIRECTORY and each image gets a generated,
+// collision-free name inside it. Parent directories are created either way.
+//
+// The per-image suffix is the point: assigning every image the same target
+// makes writes 1..N-1 dead, and the caller cannot tell because the tool still
+// reports success. Suffixing is lossless and keeps the caller's chosen name.
+function saveGeneratedImages(contents, savePath) {
+    if (!savePath) {
+        return [];
+    }
+    const images = contents.filter((item) => item && item.type === "image" && item.data);
+    if (images.length === 0) {
+        return [];
+    }
+    // Honour the real payload type: `output_format` offers png/jpeg/webp and
+    // Gemini returns its own mimeType, so a hardcoded .png would mislabel.
+    const extensionFor = (mimeType) => {
+        const subtype = String(mimeType || "image/png").split("/")[1] || "png";
+        const cleaned = subtype.split(";")[0].trim().toLowerCase().replace(/[^a-z0-9]/g, "");
+        if (cleaned === "jpeg") {
+            return ".jpg";
+        }
+        return "." + (cleaned || "png");
+    };
+    const asFile = /\.(png|jpe?g|webp|gif)$/i.test(savePath);
+    const stamp = Date.now();
+    const written = [];
+    images.forEach((item, index) => {
+        let filePath;
+        if (asFile) {
+            if (images.length === 1) {
+                filePath = savePath;
+            }
+            else {
+                const ext = path.extname(savePath);
+                filePath = path.join(path.dirname(savePath), path.basename(savePath, ext) + "-" + (index + 1) + ext);
+            }
+        }
+        else {
+            filePath = path.join(savePath, "aihubmix-" + stamp + "-" + index + extensionFor(item.mimeType));
+        }
+        fs.mkdirSync(path.dirname(filePath), { recursive: true });
+        fs.writeFileSync(filePath, Buffer.from(item.data, "base64"));
+        written.push(filePath);
+    });
+    return written;
+}
