# Build artifacts
result
result-*
result-docs

# Bytecode from running checks/split-code-spans.py by hand. The check runs
# it through nix, but invoking it directly is the normal way to iterate.
__pycache__/

# Claude Code plugin state
.remember/

# Kimchi CLI project-local state (config, sessions, plans, ferments)
.kimchi/

# devenv state
.devenv/
.direnv/

# Local devenv overrides (host-specific, not committed)
devenv.local.nix

# devenv nix store symlinks inside skill source directories
packages/stacked-workflows/skills/*/[0-9a-z]*-*

# Generated on shell entry by generate:instructions:materialize.
# Instruction files are real file COPIES, not files.* symlinks: Kiro
# cannot read symlinked steering (it scans the dir and the scan skips
# symlinks). Skills / settings.json / MCP JSON below are still symlinks.
#
# NOT listed here, deliberately: AGENTS.md and .github/instructions/ are
# generated but COMMITTED, because Copilot reads them from the repo.
# `.agents/` is shared project-local agent space: devenv materializes Codex
# skills there, while Kiro workflows write worker tasks there. Neither is
# source-of-truth content in this repository.
.agents/
.claude/rules/
.claude/settings.json
.claude/settings.local.json
.claude/skills/
# Codex project config is a devenv `files.*` store symlink. Keep the Nix
# declaration in devenv.nix as the source of truth rather than committing the
# shell-entry artifact.
.codex/
.config/github-copilot/
.copilot/
.github/skills/
.kiro/hooks/
.kiro/settings/
.kiro/skills/
.kiro/steering/
.mcp.json
.pre-commit-config.yaml
CLAUDE.md

# Generated doc site (mdbook source, built from dev/docs/ + nix eval)
docs/src/

.ninja_lock
.ninja_log
.update-logs/
.update-version
.update.ninja
.update-report.txt

# Belt-and-suspenders: living-workflow working state now lives OUT-OF-REPO under XDG
# (see the master's STATE SUBSTRATE — <xdg-state-base>/<clone-name>/<workflow-name>/). Kept as
# cheap safety against any stray in-repo .living-workflows/ write, which should no longer happen.
.living-workflows/

# Local private working area (untracked journals, assessments, scratch)
/private/

# Node deps for packages/kiro-cli/schema, installed on demand by the manual
# check documented in that package's README. Nothing in the flake builds them.
# The rule lives here at the base of the stack rather than beside the package:
# the directory exists in the worktree whichever branch is checked out, so a
# sibling branch that does not carry the package would otherwise stage it.
#
# No trailing slash, deliberately. `node_modules/` matches DIRECTORIES ONLY, so
# it does not cover a SYMLINK named node_modules — the normal way to share one
# install across several worktrees, and how a stray symlink came within one
# `git add -A` of being committed here. Without the slash the rule matches a
# file, a directory and a symlink alike.
node_modules
