# Build artifacts
result
result-*
result-docs

# Bytecode from running the markdown scanners by hand. Running a scanner as
# __main__ caches nothing; the .pyc comes from the sibling module each one
# path-loads (see `_load` in checks/markdown/doubled-words.py).
__pycache__/

# Claude Code plugin state
.remember/

# Kimchi CLI project-local state (config, sessions, plans, ferments)
.kimchi/

# devenv state
.devenv/
.direnv/

# Local devenv overrides (host-specific, not committed)
devenv.local.nix

# devenv nix store symlinks inside skill source directories
packages/stacked-workflows/skills/*/[0-9a-z]*-*

# Generated local instruction/configuration projections require devshell
# activation. Only GitHub Copilot's selected .github/ instructions are committed.
# .agents/ contains generated skills and readable Codex/Kimchi rule indexes.
AGENTS.md
.agents/
.claude/CLAUDE.md
.claude/rules/
.claude/settings.json
.claude/settings.local.json
.claude/skills/
# Codex project config is a devenv `files.*` store symlink. Keep the Nix
# declaration in devenv.nix as the source of truth rather than committing the
# shell-entry artifact.
.codex/
.config/kimchi/
.copilot/
.kiro/hooks/
.kiro/settings/
.kiro/skills/
.kiro/steering/
.mcp.json
.pre-commit-config.yaml

# Generated doc site (mdbook source, built from dev/docs/ + nix eval)
docs/src/

.update-logs/
.update-version
.update-report.txt

# Local private working area (untracked journals, assessments, scratch)
/private/
