+//! Availability evidence shared by family resolution and one drain's dedup.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::time::Duration;
+
+use super::twirp::{DownloadUrl, TwirpClient};
+use super::{Error, blob};
+use crate::manifest::PackHash;
+
+pub(crate) struct PackAvailability<'a> {
+    twirp: &'a TwirpClient,
+    http: &'a reqwest::Client,
+    checked: tokio::sync::Mutex<BTreeMap<PackHash, bool>>,
+}
+
+impl<'a> PackAvailability<'a> {
+    pub(crate) fn new(twirp: &'a TwirpClient, http: &'a reqwest::Client) -> Self {
+        Self {
+            twirp,
+            http,
+            checked: Default::default(),
+        }
+    }
+
+    pub(crate) async fn contains(&self, pack: PackHash) -> Result<bool, Error> {
+        let mut checked = self.checked.lock().await;
+        if let Some(available) = checked.get(&pack) {
+            return Ok(*available);
+        }
+        let key = crate::chunker::pack_cache_key(&pack);
+        // Exact-key lookups can lag finalization. Require two absence results,
+        // separated by a short propagation window; errors never become misses.
+        for attempt in 0..2 {
+            let available = match self.twirp.get_download_url(&key, &[]).await? {
+                DownloadUrl::Miss => false,
+                DownloadUrl::Hit { url, .. } => {
+                    match blob::get_with_refresh(self.http, &url, Some(0..1), || async {
+                        match self.twirp.get_download_url(&key, &[]).await? {
+                            DownloadUrl::Hit { url, .. } => Ok(url),
+                            DownloadUrl::Miss => Err(Error::InvalidResponse(format!(
+                                "pack {key} vanished during URL refresh"
+                            ))),
+                        }
+                    })
+                    .await
+                    {
+                        Ok(_) => true,
+                        Err(Error::Status { status: 404, .. }) => false,
+                        Err(err) => return Err(err),
+                    }
+                }
+            };
+            if available {
+                checked.insert(pack, true);
+                return Ok(true);
+            }
+            if attempt == 0 {
+                tokio::time::sleep(Duration::from_millis(100)).await;
+            }
+        }
+        checked.insert(pack, false);
+        Ok(false)
+    }
+
+    pub(crate) async fn missing(&self) -> BTreeSet<PackHash> {
+        self.checked
+            .lock()
+            .await
+            .iter()
+            .filter_map(|(pack, available)| (!available).then_some(*pack))
+            .collect()
+    }
+}
