+/// Read the real HTTP body to completion, then validate each Nix export frame
+/// against the local file's NAR and metadata, including the final terminator.
+/// Every assertion runs without nix-store, including in the Nix build sandbox.
+async fn assert_closure(
+    fake: &FakeGha,
+    http: &reqwest::Client,
+    fixture: &Fixture,
+    view: hestia::substituter::ManifestStore,
+) {
+    use hestia::pipeline::AccessLog;
+    use hestia::refnorm::RefTable;
+    use hestia::substituter::Substituter;
+
+    let router = Substituter::new(
+        fixture.database.store_dir().clone(),
+        view,
+        AccessLog::new(),
+        fake.twirp(http),
+        http.clone(),
+    )
+    .into_router();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let task = tokio::spawn(async move {
+        axum::serve(listener, router).await.unwrap();
+    });
+    let response = http
+        .get(format!(
+            "http://{addr}/closure/{}",
+            path_hash_of(&fixture.top)
+        ))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(response.status(), 200);
+    let body = response
+        .bytes()
+        .await
+        .expect("healed closure export completes");
+    task.abort();
+    let mut input = body.as_ref();
+    fn u64_from(input: &mut &[u8]) -> u64 {
+        let (value, rest) = input.split_at_checked(8).expect("complete export integer");
+        *input = rest;
+        u64::from_le_bytes(value.try_into().unwrap())
+    }
+    fn string_from(input: &mut &[u8]) -> String {
+        let len = u64_from(input) as usize;
+        let (value, rest) = input
+            .split_at_checked(len.next_multiple_of(8))
+            .expect("complete export string");
+        *input = rest;
+        String::from_utf8(value[..len].to_vec()).unwrap()
+    }
+    for (path, references) in [(&fixture.dep, vec![]), (&fixture.top, vec![&fixture.dep])] {
+        assert_eq!(u64_from(&mut input), 1, "path frame marker");
+        let refs: Vec<_> = references
+            .iter()
+            .map(|path| {
+                fixture
+                    .database
+                    .store_dir()
+                    .parse(path.to_str().unwrap())
+                    .unwrap()
+            })
+            .collect();
+        let refs = RefTable::new(&refs);
+        let chunked = hestia::chunker::chunk_path(path, &refs).await.unwrap();
+        let nar = hestia::chunker::nar_from_chunks(&chunked.tree, &chunked.chunk_map(), &refs)
+            .await
+            .unwrap();
+        let (actual_nar, rest) = input.split_at_checked(nar.len()).expect("complete NAR");
+        assert_eq!(actual_nar, nar);
+        input = rest;
+        assert_eq!(u64_from(&mut input), 0x4558494e, "export magic");
+        assert_eq!(string_from(&mut input), path.to_str().unwrap());
+        assert_eq!(u64_from(&mut input), references.len() as u64);
+        for reference in references {
+            assert_eq!(string_from(&mut input), reference.to_str().unwrap());
+        }
+        assert_eq!(string_from(&mut input), "", "no deriver");
+        assert_eq!(u64_from(&mut input), 0, "no legacy signature");
+    }
+    assert_eq!(u64_from(&mut input), 0, "end-of-stream terminator");
+    assert!(input.is_empty(), "no trailing bytes after terminator");
+}
