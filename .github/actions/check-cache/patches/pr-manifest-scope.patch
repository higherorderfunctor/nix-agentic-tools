+async fn repair_and_export(stale_base: bool, lagging: bool) {
+    use hestia::substituter::ManifestStore;
+
+    for published in [false, true] {
+        let fixture = Fixture::new().await;
+        let fake = FakeGha::start().await;
+        let http = reqwest::Client::new();
+        let mut ctx = pipeline_context(&fake, &http, fixture.database.clone());
+        ctx.manifest_prefix = "m3pr".into();
+        ctx.base_manifest_prefix = Some("m3".into());
+        let view = ManifestStore::new();
+        if published {
+            ctx.publish = Some(view.clone());
+        }
+        seed(&fake, "m3#1000", &Manifest::new()).await;
+        let first = ctx
+            .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 10)
+            .await
+            .unwrap();
+        assert_eq!(first.pushed, 2);
+        let mut stale = ctx.load_manifest().await.unwrap();
+        // Stale GC counters must not defeat a live fresh upload.
+        for location in stale.chunks.values_mut() {
+            location.repacks_survived = 5;
+        }
+        seed(&fake, "m3pr#2", &stale).await;
+        if stale_base {
+            seed(&fake, "m3#1001", &stale).await;
+            ctx.pack_target_size = 1; // Force fresh locations in different packs.
+        }
+        if published {
+            view.set_version(stale.clone(), 2);
+        }
+        if lagging {
+            fake.set_stale_lookups_after(&http, 2, 1).await;
+        } else {
+            for pack in stale.packs.keys() {
+                fake.evict(&http, &hestia::chunker::pack_cache_key(pack))
+                    .await;
+            }
+        }
+        // No background verify_packs: exercise the readiness race too.
+        let healed = ctx
+            .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 20)
+            .await
+            .unwrap();
+        assert_eq!(healed.pushed, if lagging { 0 } else { 2 });
+        assert_eq!(healed.skipped_existing, if lagging { 2 } else { 0 });
+        if !lagging {
+            assert!(healed.packs_uploaded > 0);
+        }
+        let manifest = ctx.load_manifest().await.unwrap(); // NEXT family load.
+        assert!(
+            manifest
+                .chunks
+                .values()
+                .all(|location| location.repacks_survived == if lagging { 5 } else { 0 })
+        );
+        if stale_base {
+            assert!(
+                manifest
+                    .chunks
+                    .values()
+                    .all(|loc| !stale.packs.contains_key(&loc.pack)),
+                "repair used a different pack layout"
+            );
+        }
+        // An equal-index refresh of an unverified published view must not
+        // resurrect a stale location via Manifest::merge's repack counters.
+        if published {
+            view.set_version(stale.clone(), healed.manifest_version);
+        }
+        view.set_version_if_at_least(manifest.clone(), healed.manifest_version);
+        assert_closure(&fake, &http, &fixture, view.clone()).await;
+        if stale_base && published {
+            // Main has now healed too. Its live location must also win over
+            // an equal-version published PR view with old high counters.
+            seed(&fake, "m3#1002", &manifest).await;
+            seed(&fake, "m3pr#4", &stale).await;
+            view.set_version(stale, 4);
+            let stats = ctx
+                .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 30)
+                .await
+                .unwrap();
+            assert_eq!(
+                stats.pushed, 0,
+                "live main beats stale published counters during drain"
+            );
+            assert_eq!(stats.skipped_existing, 2);
+            assert_closure(&fake, &http, &fixture, view).await;
+        }
+    }
+}
