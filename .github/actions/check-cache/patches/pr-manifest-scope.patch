+//! The fake deliberately honors metadata.scope; real service support still needs a CI probe.
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use axum::{
+    Json, Router,
+    extract::{Path, State},
+    routing::{get, post, put},
+};
+use bytes::Bytes;
+use hestia::gha::{savemutable::SaveMutable, twirp::TwirpClient};
+use hestia::manifest::{ChunkHash, ChunkLocation, Manifest, PackHash, Root};
+use serde_json::{Value, json};
+
+#[derive(Default)]
+struct Seen {
+    lookups: Vec<Value>,
+    reservations: Vec<String>,
+    uploaded: Bytes,
+}
+
+#[derive(Clone)]
+struct Fake {
+    base: String,
+    fresh_pr: bool,
+    seen: Arc<Mutex<Seen>>,
+}
+
+fn manifest(name: &str) -> Manifest {
+    let mut manifest = Manifest::new();
+    manifest.roots.insert(
+        name.into(),
+        Root {
+            paths: Default::default(),
+            updated: 1,
+            run_id: None,
+        },
+    );
+    let own = name.starts_with("own");
+    manifest.chunks.insert(
+        ChunkHash::digest(b"chunk"),
+        ChunkLocation {
+            pack: PackHash::digest(if own { b"P" } else { b"Q" }),
+            repacks_survived: if own { 5 } else { 0 },
+            offset: 0,
+            compressed_size: 1,
+            uncompressed_size: 1,
+        },
+    );
+    manifest
+}
+
+async fn rpc(
+    State(fake): State<Fake>,
+    Path(method): Path<String>,
+    Json(request): Json<Value>,
+) -> Json<Value> {
+    let mut seen = fake.seen.lock().unwrap();
+    match method.as_str() {
+        "GetCacheEntryDownloadURL" => {
+            seen.lookups.push(request.clone());
+            let scope = request["metadata"]["scope"][0]["scope"].as_str();
+            if fake.fresh_pr && scope == Some("refs/pull/1/merge") {
+                return Json(json!({"ok": false}));
+            }
+            let changed = !seen.reservations.is_empty();
+            let (index, blob) = match scope {
+                Some("refs/pull/1/merge") if changed => (101, "own-new"),
+                Some("refs/pull/1/merge") => (100, "own-old"),
+                Some("refs/heads/main") if changed => (92, "main-stale"),
+                Some("refs/heads/main") | None => (102, "main-new"),
+                other => panic!("unexpected scope {other:?}"),
+            };
+            Json(json!({"ok": true, "matched_key": format!("m#{index}"),
+                "signed_download_url": format!("{}/blob/{blob}", fake.base)}))
+        }
+        "CreateCacheEntry" => {
+            seen.reservations
+                .push(request["key"].as_str().unwrap().into());
+            Json(if seen.reservations.len() == 1 {
+                json!({"ok": false})
+            } else {
+                json!({"ok": true, "signed_upload_url": format!("{}/upload", fake.base)})
+            })
+        }
+        "FinalizeCacheEntryUpload" => Json(json!({"ok": true, "entry_id": "1"})),
+        _ => panic!("unexpected RPC {method}"),
+    }
+}
+
+#[tokio::test]
+async fn pr_merges_scopes_and_retries_above_both_despite_gaps_and_regressed_reads() {
+    for fresh_pr in [false, true] {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let fake = Fake {
+            base: format!("http://{}", listener.local_addr().unwrap()),
+            fresh_pr,
+            seen: Default::default(),
+        };
+        let app = Router::new()
+            .route(
+                "/twirp/github.actions.results.api.v1.CacheService/{method}",
+                post(rpc),
+            )
+            .route(
+                "/blob/{name}",
+                get(|Path(name): Path<String>| async move {
+                    Bytes::from(manifest(&name).encode().unwrap())
+                }),
+            )
+            .route(
+                "/upload",
+                put(|State(fake): State<Fake>, data: Bytes| async move {
+                    fake.seen.lock().unwrap().uploaded = data;
+                }),
+            )
+            .with_state(fake.clone());
+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        let http = reqwest::Client::new();
+        let twirp = TwirpClient::new(http.clone(), &fake.base, "token").with_manifest_scopes(
+            "42",
+            "refs/pull/1/merge",
+            "refs/heads/main",
+        );
+        let save = SaveMutable::new(&twirp, &http, "m").with_retry(Duration::ZERO, 3, 3);
+        let (own_index, entry) = save.load_with_own_index(&Default::default()).await.unwrap();
+        let entry = entry.unwrap();
+        assert_eq!(own_index, if fresh_pr { 0 } else { 100 });
+        assert_eq!(entry.index, 102);
+        let loaded = Manifest::decode(&entry.data).unwrap();
+        assert!(loaded.roots.contains_key("main-new"));
+        assert_eq!(loaded.roots.contains_key("own-old"), !fresh_pr);
+        // Filtering EACH scope before union lets live Q beat evicted P's higher repack count.
+        let (_, filtered) = save
+            .load_with_own_index(&[PackHash::digest(b"P")].into())
+            .await
+            .unwrap();
+        let filtered = Manifest::decode(&filtered.unwrap().data).unwrap();
+        assert_eq!(
+            filtered.chunks[&ChunkHash::digest(b"chunk")].pack,
+            PackHash::digest(b"Q")
+        );
+        let index = save
+            .save(|entry| Ok(entry.unwrap().data.to_vec()))
+            .await
+            .unwrap();
+        assert_eq!(index, 103);
+        let seen = fake.seen.lock().unwrap();
+        assert_eq!(seen.reservations, ["m#103", "m#103"]);
+        let uploaded = Manifest::decode(&seen.uploaded).unwrap();
+        assert!(
+            uploaded.roots.contains_key("main-new"),
+            "retain the observed main state"
+        );
+        assert_eq!(uploaded.roots.contains_key("own-new"), !fresh_pr);
+        for request in &seen.lookups {
+            assert_eq!(request["metadata"]["repository_id"], "42");
+            assert!(request["metadata"].get("repositoryId").is_none());
+            assert_eq!(request["metadata"]["scope"][0]["permission"], "1");
+            assert_eq!(request["metadata"]["scope"].as_array().unwrap().len(), 1);
+        }
+        drop(seen);
+        // Unconfigured clients retain one unscoped lookup and the original blob.
+        let twirp = TwirpClient::new(http.clone(), &fake.base, "token");
+        fake.seen.lock().unwrap().lookups.clear();
+        let entry = SaveMutable::new(&twirp, &http, "m")
+            .load()
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(entry.data.as_ref(), manifest("main-new").encode().unwrap());
+        let seen = fake.seen.lock().unwrap();
+        assert_eq!(seen.lookups.len(), 1);
+        assert!(seen.lookups[0].get("metadata").is_none());
+        server.abort();
+    }
