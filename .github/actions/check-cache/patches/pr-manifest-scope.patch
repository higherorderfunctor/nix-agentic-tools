+/// Discard known-dead locations before merge can prefer their repack history.
+pub(crate) fn exclude_missing_pack_chunks(manifest: &mut Manifest, missing: &BTreeSet<PackHash>) {
+    manifest
+        .chunks
+        .retain(|_, location| !missing.contains(&location.pack));
+}
+
+fn encode_manifest(manifest: &Manifest) -> Result<Bytes, Error> {
+    manifest
+        .encode()
+        .map(Bytes::from)
+        .map_err(|err| Error::InvalidResponse(format!("encoding merged manifest: {err}")))
+}
+
+// Only PR manifests use this union; main keeps the original opaque-entry path.
+// The merged entry's key/index records the maximum observed version, so its next
+// reservation is above both scopes even when eviction has left arbitrary gaps.
+fn merge_entries(
+    a: Option<MutableEntry>,
+    b: Option<MutableEntry>,
+) -> Result<Option<MutableEntry>, Error> {
+    let (mut a, b) = match (a, b) {
+        (Some(a), Some(b)) => (a, b),
+        (a, b) => return Ok(a.or(b)),
+    };
+    let data = encode_manifest(
+        &decode_manifest_or_empty(&a.data).merge(decode_manifest_or_empty(&b.data)),
+    )?;
+    if b.index > a.index {
+        a.key = b.key;
+        a.index = b.index;
+    }
+    a.data = data;
+    Ok(Some(a))
+}
