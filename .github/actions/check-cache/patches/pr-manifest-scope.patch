+/// Prune locations rejected by dedup from working and commit snapshots so
+/// stale repack counters cannot win over this drain's fresh uploads.
+fn discard_missing_packs(manifest: &mut Manifest, missing: &BTreeSet<PackHash>) {
+    manifest.packs.retain(|pack, _| !missing.contains(pack));
+    manifest
+        .chunks
+        .retain(|_, location| !missing.contains(&location.pack));
+    manifest.paths.retain(|_, entry| {
+        entry_chunks(entry)
+            .iter()
+            .all(|chunk| manifest.chunks.contains_key(chunk))
+    });
+}
