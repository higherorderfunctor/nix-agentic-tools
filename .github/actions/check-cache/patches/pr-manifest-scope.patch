+//! Manifest families are selected by key, independent of GitHub ref precedence.
+#[path = "support/fake_gha.rs"]
+mod fake_gha;
+
+use std::time::Duration;
+
+use bytes::Bytes;
+use hestia::gha::{savemutable::SaveMutable, twirp::Reservation};
+use hestia::manifest::{ChunkHash, ChunkLocation, Manifest, PackHash, PackInfo, Root};
+use fake_gha::FakeGha;
+
+fn manifest(name: &str, repacks_survived: u32) -> Manifest {
+    let mut manifest = Manifest::new();
+    manifest.roots.insert(
+        name.into(),
+        Root {
+            paths: Default::default(),
+            updated: 1,
+            run_id: None,
+        },
+    );
+    let pack = PackHash::digest(name);
+    manifest.packs.insert(
+        pack,
+        PackInfo {
+            size: 1,
+            created: 1,
+            tier: 0,
+        },
+    );
+    let location = ChunkLocation {
+        pack,
+        repacks_survived,
+        offset: 0,
+        compressed_size: 1,
+        uncompressed_size: 1,
+    };
+    manifest
+        .chunks
+        .insert(ChunkHash::digest(b"shared"), location.clone());
+    manifest.chunks.insert(ChunkHash::digest(name), location);
+    manifest
+}
+
+async fn seed(fake: &FakeGha, key: &str, manifest: &Manifest) {
+    let http = reqwest::Client::new();
+    let twirp = fake.twirp(&http);
+    let Reservation::Created { upload_url } = twirp.create_cache_entry(key).await.unwrap() else {
+        panic!("seed key already exists");
+    };
+    twirp
+        .upload_and_finalize(
+            &http,
+            key,
+            upload_url,
+            Bytes::from(manifest.encode().unwrap()),
+        )
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn pr_family_unions_base_without_using_its_version_floor() {
+    for fresh in [false, true] {
+        let fake = FakeGha::start().await;
+        let http = reqwest::Client::new();
+        let twirp = fake.twirp(&http);
+        seed(&fake, "m3#274", &manifest("main", 0)).await;
+        if !fresh {
+            seed(&fake, "m3pr#2", &manifest("own", 5)).await;
+        }
+        let save = SaveMutable::new(&twirp, &http, "m3pr")
+            .with_base_family(Some("m3"))
+            .with_retry(Duration::ZERO, 3, 1);
+        // Refreshing an expired URL must repeat the same family lookup.
+        fake.dead_sigs(&http, 1).await;
+        let entry = save.load().await.unwrap().unwrap();
+        assert_eq!(entry.index, if fresh { 0 } else { 2 });
+        let loaded = Manifest::decode(&entry.data).unwrap();
+        assert!(loaded.roots.contains_key("main"));
+        assert_eq!(loaded.roots.contains_key("own"), !fresh);
+        assert_eq!(
+            loaded.chunks[&ChunkHash::digest(b"shared")].pack,
+            PackHash::digest("main")
+        );
+        if !fresh {
+            assert!(loaded.chunks.contains_key(&ChunkHash::digest("own")));
+        }
+        let blocked = if fresh { "m3pr#1" } else { "m3pr#3" };
+        twirp.create_cache_entry(blocked).await.unwrap();
+        seed(&fake, "m3#275", &manifest("new-main", 6)).await;
+        let index = save
+            .save(|entry| Ok(entry.unwrap().data.to_vec()))
+            .await
+            .unwrap();
+        assert_eq!(index, if fresh { 2 } else { 4 });
+        let loaded = Manifest::decode(&save.load().await.unwrap().unwrap().data).unwrap();
+        assert!(loaded.roots.contains_key("new-main"));
+        assert_eq!(
+            loaded.chunks[&ChunkHash::digest(b"shared")].pack,
+            PackHash::digest("new-main")
+        );
+        let entries = fake.rest(&http).list_caches("m3#").await.unwrap();
+        assert_eq!(entries.len(), 2, "PR saves must not write the base family");
+    }
+}
+
+#[tokio::test]
+async fn healed_base_location_overrides_stale_own_on_load_and_drain() {
+    let fake = FakeGha::start().await;
+    let http = reqwest::Client::new();
+    let twirp = fake.twirp(&http);
+    let save = SaveMutable::new(&twirp, &http, "m3pr").with_base_family(Some("m3"));
+    // The PR imported P/5 before main removed the missing pack and uploaded Q/0.
+    seed(&fake, "m3pr#1", &manifest("P", 5)).await;
+    seed(&fake, "m3#2", &manifest("Q", 0)).await;
+    let current = Manifest::decode(&save.load().await.unwrap().unwrap().data).unwrap();
+    let shared = ChunkHash::digest(b"shared");
+    assert_eq!(current.chunks[&shared].pack, PackHash::digest("Q"));
+    assert_eq!(current.chunks[&shared].repacks_survived, 0);
+    assert!(current.chunks.contains_key(&ChunkHash::digest("P")));
+    let index = save
+        .save(|existing| {
+            let base = existing
+                .map(|entry| Manifest::decode(&entry.data).unwrap())
+                .unwrap_or_default();
+            Ok(base.merge(current.clone()).encode().unwrap())
+        })
+        .await
+        .unwrap();
+    assert_eq!(index, 2);
+    let committed = Manifest::decode(&save.load().await.unwrap().unwrap().data).unwrap();
+    assert_eq!(committed.chunks[&shared].pack, PackHash::digest("Q"));
+    assert_eq!(committed.chunks[&shared].repacks_survived, 0);
+}
+
+#[tokio::test]
+async fn default_family_does_not_import_pr_state() {
+    let fake = FakeGha::start().await;
+    let http = reqwest::Client::new();
+    let twirp = fake.twirp(&http);
+    let fork = SaveMutable::new(&twirp, &http, "m3pr").with_base_family(Some("m3"));
+    assert!(fork.load().await.unwrap().is_none());
+    seed(&fake, "m3pr#274", &manifest("own", 5)).await;
+    assert_eq!(fork.load().await.unwrap().unwrap().index, 274);
+    let save = SaveMutable::new(&twirp, &http, "m3");
+    assert!(save.load().await.unwrap().is_none());
+    assert_eq!(
+        save.save(|_| Ok(manifest("main", 0).encode().unwrap()))
+            .await
+            .unwrap(),
+        1
+    );
+    let loaded = Manifest::decode(&save.load().await.unwrap().unwrap().data).unwrap();
+    assert!(!loaded.roots.contains_key("own"));
+}
