+/// Main wins shared entries unless its conflicting location is absent and own is live.
+/// Roots keep the upstream merge rule.
+/// The returned index belongs only to the own family, including zero on a fresh PR.
+async fn merge_fork_entries(
+    own: Option<MutableEntry>,
+    default: Option<MutableEntry>,
+    own_prefix: &str,
+    availability: &PackAvailability<'_>,
+) -> Result<Option<MutableEntry>, Error> {
+    if own.is_none() && default.is_none() {
+        return Ok(None);
+    }
+    let index = own.as_ref().map_or(0, |entry| entry.index);
+    let own_manifest = own
+        .as_ref()
+        .map(|entry| decode_manifest_or_empty(&entry.data))
+        .unwrap_or_default();
+    let default_manifest = default
+        .as_ref()
+        .map(|entry| decode_manifest_or_empty(&entry.data))
+        .unwrap_or_default();
+    let Manifest {
+        paths,
+        mut chunks,
+        packs,
+        roots,
+    } = default_manifest;
+    for (hash, location) in &mut chunks {
+        if let Some(own) = own_manifest.chunks.get(hash)
+            && own != location
+            && !availability.contains(location.pack).await?
+            && availability.contains(own.pack).await?
+        {
+            *location = own.clone();
+        }
+    }
+    let mut manifest = own_manifest;
+    manifest.paths.extend(paths);
+    manifest.chunks.extend(chunks);
+    manifest.packs.extend(packs);
+    let manifest = manifest.merge(Manifest {
+        roots,
+        ..Manifest::new()
+    });
+    let data = manifest
+        .encode()
+        .map(Bytes::from)
+        .map_err(|err| Error::InvalidResponse(format!("encoding merged manifest: {err}")))?;
+    eprintln!(
+        "hestia: manifest base {}, own {}",
+        default
+            .as_ref()
+            .map_or_else(|| "none".into(), |entry| entry.key.clone()),
+        own.as_ref()
+            .map_or_else(|| "none".into(), |entry| entry.key.clone()),
+    );
+    Ok(Some(MutableEntry {
+        key: key_for(own_prefix, index),
+        index,
+        data,
+    }))
+}
