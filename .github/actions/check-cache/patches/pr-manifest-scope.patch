+#[tokio::test]
+async fn pr_family_unions_base_without_using_its_version_floor() {
+    for fresh in [false, true] {
+        let fake = FakeGha::start().await;
+        let http = reqwest::Client::new();
+        let twirp = fake.twirp(&http);
+        seed(&fake, "m3#274", &manifest("main", 0)).await;
+        if !fresh {
+            seed(&fake, "m3pr#2", &manifest("own", 5)).await;
+        }
+        let save = SaveMutable::new(&twirp, &http, "m3pr")
+            .with_base_family(Some("m3"))
+            .with_retry(Duration::ZERO, 3, 1);
+        // Refreshing an expired URL must repeat the same family lookup.
+        fake.dead_sigs(&http, 1).await;
+        let entry = save.load().await.unwrap().unwrap();
+        assert_eq!(entry.index, if fresh { 0 } else { 2 });
+        let loaded = Manifest::decode(&entry.data).unwrap();
+        assert!(loaded.roots.contains_key("main"));
+        assert_eq!(loaded.roots.contains_key("own"), !fresh);
+        assert_eq!(
+            loaded.chunks[&ChunkHash::digest(b"shared")].pack,
+            PackHash::digest("main")
+        );
+        if !fresh {
+            assert!(loaded.chunks.contains_key(&ChunkHash::digest("own")));
+        }
+        let blocked = if fresh { "m3pr#1" } else { "m3pr#3" };
+        twirp.create_cache_entry(blocked).await.unwrap();
+        seed(&fake, "m3#275", &manifest("new-main", 6)).await;
+        let index = save
+            .save(|entry| Ok(entry.unwrap().data.to_vec()))
+            .await
+            .unwrap();
+        assert_eq!(index, if fresh { 2 } else { 4 });
+        let loaded = Manifest::decode(&save.load().await.unwrap().unwrap().data).unwrap();
+        assert!(loaded.roots.contains_key("new-main"));
+        assert_eq!(
+            loaded.chunks[&ChunkHash::digest(b"shared")].pack,
+            PackHash::digest("new-main")
+        );
+        let entries = fake.rest(&http).list_caches("m3#").await.unwrap();
+        assert_eq!(entries.len(), 2, "PR saves must not write the base family");
+    }
