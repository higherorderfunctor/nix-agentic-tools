+        .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 20)
+        .await
+        .unwrap();
+    assert_eq!(stats.skipped_existing, 2);
+    let requests = fake.download_requests()[start..].to_vec();
+    let packs: Vec<_> = requests
+        .iter()
+        .filter(|key| key.starts_with("pack-"))
+        .collect();
+    assert_eq!(packs.len(), 1, "two skipped paths share one checked pack");
+    assert_eq!(
+        fake.blob_requests()[blobs..]
+            .iter()
+            .filter(|req| req.key.starts_with("pack-"))
+            .count(),
+        1
+    );
+    // An access-only worker drain relies on no pack for write dedup.
+    let start = fake.download_requests().len();
+    ctx.run(
+        BTreeSet::new(),
+        BTreeSet::from([path_hash_of(&fixture.top)]),
+        30,
+    )
+    .await
+    .unwrap();
+    assert!(
+        fake.download_requests()[start..]
+            .iter()
+            .all(|key| !key.starts_with("pack-"))
+    );
+    // Remove just one path entry: its newly prepared chunks reuse the same
+    // checked pack as the skipped dependency (no second request).
+    current.paths.remove(&path_hash_of(&fixture.top));
+    seed(&fake, "m3#4", &current).await;
+    let start = fake.download_requests().len();
+    let stats = ctx
+        .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 40)
+        .await
+        .unwrap();
+    assert_eq!(stats.pushed, 1);
+    assert_eq!(stats.skipped_existing, 1);
+    assert_eq!(stats.new_chunks, 0);
+    assert_eq!(
+        fake.download_requests()[start..]
+            .iter()
+            .filter(|key| key.starts_with("pack-"))
+            .count(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn new_path_does_not_reuse_evicted_chunks() {
+    let (fixture, fake, http, ctx) = populated_fixture().await;
+    let mut current = ctx.load_manifest().await.unwrap();
+    current.paths.remove(&path_hash_of(&fixture.top));
+    current.paths.remove(&path_hash_of(&fixture.dep));
+    for loc in current.chunks.values_mut() {
+        loc.repacks_survived = 5;
+    }
+    seed(&fake, "m3#2", &current).await;
+    for pack in current.packs.keys() {
+        fake.evict(&http, &hestia::chunker::pack_cache_key(pack))
+            .await;
+    }
+    let stats = ctx
+        .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 20)
+        .await
+        .unwrap();
+    assert_eq!(stats.pushed, 2);
+    assert!(stats.new_chunks > 0);
+    assert!(stats.packs_uploaded > 0);
+    let view = hestia::substituter::ManifestStore::new();
+    view.set(ctx.load_manifest().await.unwrap());
+    assert_closure(&fake, &http, &fixture, view).await;
+}
+
+#[tokio::test]
+async fn pack_lookup_errors_remain_fatal() {
+    let (fixture, fake, http, ctx) = populated_fixture().await;
+    // The family lookup succeeds; the dedup pack lookup gets HTTP 401.
+    fake.expire_token_after(&http, 1).await;
+    let err = ctx
+        .run(to_path_set(&[&fixture.top]), BTreeSet::new(), 10)
+        .await
+        .unwrap_err();
+    assert!(err.to_string().contains("expired"), "{err}");
+}
