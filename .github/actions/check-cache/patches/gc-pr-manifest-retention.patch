+    /// Seed REST-visible entries in independent refs without broadening the
+    /// fake's single-scope Twirp lookup semantics.
+    pub fn insert_cache_entry(
+        &self,
+        key: &str,
+        cache_ref: &str,
+        version: &str,
+        data: &[u8],
+        created: u64,
+    ) -> u64 {
+        let mut inner = self.inner.lock().unwrap();
+        inner.next_id += 1;
+        let id = inner.next_id;
+        std::fs::write(inner.blob_path(id), data).unwrap();
+        inner.entries.push(Entry {
+            id,
+            cache_ref: cache_ref.to_string(),
+            key: key.to_string(),
+            version: version.to_string(),
+            finalized: true,
+            size: data.len() as u64,
+            created_at: created,
+            last_accessed_at: created,
+        });
+        id
+    }
