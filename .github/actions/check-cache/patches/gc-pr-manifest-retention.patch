diff --git a/tests/gc_pr_retention.rs b/tests/gc_pr_retention.rs
new file mode 100644
index 0000000..07bf8b1
--- /dev/null
+++ b/tests/gc_pr_retention.rs
@@ -0,0 +1,184 @@
+//! Manifest retention uses repository-wide REST identities, never key deletion.
+mod support;
+
+use std::collections::BTreeSet;
+use std::time::Duration;
+
+use hestia::gc::{GcContext, GcPolicy, SECS_PER_HOUR};
+use support::fake_gha::FakeGha;
+use support::sim::SimCache;
+
+const NOW: u64 = 1_800_000_000;
+
+async fn fixture() -> (FakeGha, GcContext) {
+    let fake = FakeGha::start().await;
+    let gc = SimCache::new(&fake, &reqwest::Client::new()).gc(GcPolicy::default());
+    (fake, gc)
+}
+
+async fn ids(gc: &GcContext) -> BTreeSet<u64> {
+    gc.rest
+        .list_caches("")
+        .await
+        .unwrap()
+        .into_iter()
+        .map(|entry| entry.id)
+        .collect()
+}
+
+#[tokio::test]
+async fn retains_each_ref_head_and_supersession_grace_in_own_namespace() {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let (fake, gc) = fixture().await;
+        let version = gc.twirp.version();
+        let old = NOW - 2 * SECS_PER_HOUR;
+        let a = "refs/pull/1/merge";
+        let b = "refs/pull/2/merge";
+        let main = "refs/heads/main";
+        // A's #1/#2 are superseded while B's identically keyed #2 is its head.
+        // Numeric ordering matters: #10, not #9, is A's head.
+        let rows = [
+            ("m3pr#1", a, version, old, false),
+            ("m3pr#2", a, version, old, false),
+            ("m3pr#2", b, version, old, true),
+            ("m3pr#1", b, version, old, false),
+            ("m3pr#10", a, version, NOW + 30, true),
+            ("m3pr#9", a, version, NOW - 30, true),
+            ("m3pr#8", a, version, NOW - SECS_PER_HOUR, true),
+            ("m3pr#7", a, version, old, true),
+            ("m3pr#100", a, "foreign", old, true),
+            ("m3pr#1", a, "foreign", old, true),
+            ("m3pr#010", a, version, old, true),
+            ("m3pr#99", "", version, old, true),
+            ("m3#1", main, version, old, false),
+            ("m3#2", main, version, old, true),
+            ("m3#3", main, version, NOW - 30, true),
+            ("m3#1", main, "foreign", old, true),
+            ("pack-unrelated", main, version, old, true),
+        ];
+        let mut expected = BTreeSet::new();
+        for (key, cache_ref, namespace, created, keep) in rows {
+            let id = fake.insert_cache_entry(key, cache_ref, namespace, b"metadata only", created);
+            if keep {
+                expected.insert(id);
+            }
+        }
+        assert_eq!(gc.cleanup_manifests(NOW).await.unwrap(), 4);
+        assert_eq!(ids(&gc).await, expected);
+        assert_eq!(
+            gc.cleanup_manifests(NOW).await.unwrap(),
+            0,
+            "idempotent cleanup"
+        );
+        assert!(
+            fake.blob_requests().is_empty(),
+            "retention is metadata only"
+        );
+        // Exercise the real empty 204 response and already-deleted 404 path.
+        let id = fake.insert_cache_entry("other", a, version, b"", old);
+        assert!(gc.rest.delete_by_id(id).await.unwrap());
+        assert!(!gc.rest.delete_by_id(id).await.unwrap());
+    })
+    .await
+    .expect("retention test timed out");
+}
+
+#[tokio::test]
+async fn cleanup_precedes_failed_planning_but_dry_run_never_deletes() {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let (fake, gc) = fixture().await;
+        let version = gc.twirp.version();
+        let old = NOW - 2 * SECS_PER_HOUR;
+        fake.insert_cache_entry("m3#1", "refs/heads/main", version, b"bad manifest", old);
+        let head =
+            fake.insert_cache_entry("m3#2", "refs/heads/main", version, b"bad manifest", old);
+        fake.insert_cache_entry("m3pr#1", "refs/pull/1/merge", version, b"", old);
+        let pr_head = fake.insert_cache_entry("m3pr#2", "refs/pull/1/merge", version, b"", old);
+        let before = ids(&gc).await;
+        assert!(
+            gc.run(true, NOW).await.is_err(),
+            "invalid manifest must fail planning"
+        );
+        assert_eq!(ids(&gc).await, before, "dry run deleted entries");
+        assert!(
+            gc.run(false, NOW).await.is_err(),
+            "cleanup must not mask plan errors"
+        );
+        assert_eq!(ids(&gc).await, BTreeSet::from([head, pr_head]));
+    })
+    .await
+    .expect("early cleanup test timed out");
+}
+
+// Exercise both manifest families: an old head's own age does not start grace.
+#[tokio::test]
+async fn recently_superseded_old_head_survives() {
+    successor_grace(NOW - 60, false, false).await;
+}
+
+#[tokio::test]
+async fn aged_successor_allows_predecessor_deletion() {
+    successor_grace(NOW - 2 * SECS_PER_HOUR, false, true).await;
+}
+
+#[tokio::test]
+async fn fresh_rest_visible_reservation_keeps_predecessor() {
+    successor_grace(NOW - 60, true, false).await;
+}
+
+#[tokio::test]
+async fn unknown_successor_creation_keeps_predecessor() {
+    // The fake formats this outside the parser's supported timestamp range.
+    successor_grace(u64::MAX, false, false).await;
+}
+
+async fn successor_grace(created: u64, reserved: bool, delete: bool) {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        for family in ["m3", "m3pr"] {
+            let (fake, gc) = fixture().await;
+            let version = gc.twirp.version();
+            let cache_ref = "refs/heads/main";
+            let predecessor = fake.insert_cache_entry(
+                &format!("{family}#1"),
+                cache_ref,
+                version,
+                b"",
+                NOW - 2 * SECS_PER_HOUR,
+            );
+            let successor =
+                fake.insert_cache_entry(&format!("{family}#2"), cache_ref, version, b"", created);
+            if created == u64::MAX {
+                let entries = gc.rest.list_caches(&format!("{family}#")).await.unwrap();
+                assert!(
+                    entries
+                        .iter()
+                        .find(|entry| entry.id == successor)
+                        .unwrap()
+                        .created_unix()
+                        .is_none()
+                );
+            }
+            if reserved {
+                // Deliberately model REST exposing a reservation even though
+                // Twirp cannot restore it until it has been finalized.
+                fake.expose_reservation_in_rest(successor);
+                assert!(matches!(
+                    gc.twirp
+                        .get_download_url(&format!("{family}#2"), &[])
+                        .await
+                        .unwrap(),
+                    hestia::gha::twirp::DownloadUrl::Miss
+                ));
+            }
+            assert_eq!(
+                gc.cleanup_manifests(NOW).await.unwrap(),
+                usize::from(delete)
+            );
+            let remaining = ids(&gc).await;
+            assert!(remaining.contains(&successor), "highest index must survive");
+            assert_eq!(remaining.contains(&predecessor), !delete);
+        }
+    })
+    .await
+    .expect("successor grace test timed out");
+}
