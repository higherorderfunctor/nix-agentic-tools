{
  "description": "Each case selects a provider, configured keys or a trusted pin (null source), then supplies the pin and ordered CPA replies.",
  "instance": "http://cpa.test",
  "endpoint": "https://vendor.test/go",
  "request": {
    "method": "POST",
    "url": "https://vendor.test/usage",
    "headers": { "Accept": "text/plain", "authorization": "private" },
    "body": "query"
  },
  "surfaces": ["claude", "codex"],
  "replies": {
    "accounts": [
      200,
      {
        "files": [
          { "provider": "kiro", "account_type": "oauth", "auth_index": "one" },
          { "provider": "kiro", "account_type": "oauth", "auth_index": "two" },
          { "provider": "codex", "account_type": "oauth", "auth_index": "alt" },
          {
            "provider": "kiro",
            "account_type": "oauth",
            "auth_index": "disabled",
            "disabled": true
          }
        ]
      }
    ],
    "denied": [200, { "body": "private", "status_code": 403 }],
    "duplicate": [
      200,
      [
        {
          "base-url": "https://vendor.test/go/v1",
          "keys": [{ "api-key": "private-key", "auth_index": "one" }]
        },
        {
          "base-url": "https://vendor.test/gopher",
          "keys": [{ "api-key": "other-secret", "auth_index": "other" }]
        },
        {
          "base-url": "https://elsewhere.test/go",
          "keys": [{ "api-key": "elsewhere-key", "auth_index": "away" }]
        }
      ]
    ],
    "key": [
      200,
      [
        {
          "base-url": "https://vendor.test/go",
          "keys": [{ "api-key": "private-key", "auth_index": "two" }]
        }
      ]
    ],
    "malformed": [200, { "body": "private", "status_code": "200" }],
    "missing": [404, "private management error"],
    "offline": [503, { "body": "private", "status_code": 200 }],
    "ok": [200, { "body": "usage", "status_code": 200 }],
    "single": [
      200,
      {
        "files": [
          { "provider": "kiro", "account_type": "oauth", "auth_index": "two" }
        ]
      }
    ]
  },
  "direct": { "private network exception": "synthetic-secret" },
  "cases": {
    "ambiguous discovery": ["kiro", null, ["accounts"]],
    "correct pin sent": ["kiro", "two", ["accounts", "ok"]],
    "cross-origin key": ["keys", "away", ["missing", "duplicate", "ok"]],
    "crossed endpoint pin": ["keys", "other", ["missing", "duplicate"]],
    "crossed provider pin refused": ["kiro", "alt", ["accounts"]],
    "disabled pin refused": ["kiro", "disabled", ["accounts"]],
    "duplicate keys stay private": ["keys", null, ["key", "duplicate", "ok"]],
    "malformed auth files": ["kiro", null, ["malformed"]],
    "malformed private reply": ["kiro", "two", ["accounts", "malformed"]],
    "management HTTP failure": ["kiro", "two", ["accounts", "offline"]],
    "registered pin skips discovery": [null, "two", ["ok"]],
    "single provider login": ["kiro", null, ["single", "ok"]],
    "vendor HTTP failure": ["kiro", "two", ["accounts", "denied"]]
  }
}
