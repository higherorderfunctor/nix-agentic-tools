[
  {
    "match": "MAIN_KICKOFF",
    "not": ["orchestrated session"],
    "events": [
      {
        "toolUseId": "tu_c",
        "name": "subagent",
        "input": {
          "task": "T",
          "stages": [
            {
              "name": "st0",
              "role": "custom",
              "prompt_template": "CHILD_SLOW {task}"
            }
          ]
        }
      }
    ]
  },
  {
    "match": ["orchestrated session", "CHILD_SLOW"],
    "delay": 12,
    "events": [
      {
        "toolUseId": "cb1",
        "name": "shell",
        "input": { "command": "echo CHILD_BASH_RAN" }
      }
    ]
  },
  {
    "match": ["orchestrated session", "CHILD_SLOW"],
    "events": ["CHILD_SECOND_CALL_AFTER_CANCEL"]
  },
  {
    "match": ["SECOND_PROMPT"],
    "not": ["orchestrated session"],
    "events": ["MAIN_SECOND_DONE"]
  },
  {
    "match": "MAIN_KICKOFF",
    "not": ["orchestrated session"],
    "events": ["MAIN_DONE"]
  },
