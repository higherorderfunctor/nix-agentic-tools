{
  "steps": [
    {
      "op": "prompt",
      "text": "MAIN_KICKOFF USER_SENTINEL_1",
      "async": true,
      "tag": "p1"
    },
    { "op": "sleep", "s": 3 },
    {
      "op": "grab",
      "method": "_kiro.dev/subagent/list_update",
      "path": "params.subagents.0.sessionId",
      "as": "CHILD"
    },
    {
      "op": "call",
      "method": "_session/steer",
      "params": { "sessionId": "$CHILD", "message": "STEER_CHILD_SENTINEL" }
    },
    {
      "op": "call",
      "method": "_session/steer",
      "params": { "sessionId": "$SID", "message": "STEER_MAIN_SENTINEL" }
    },
    { "op": "wait", "tag": "p1", "timeout": 60 }
  ]
}
