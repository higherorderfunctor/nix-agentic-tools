[
  {
    "match": "MAIN_KICKOFF",
    "not": ["WFP_STEP do it"],
    "events": [
      {
        "toolUseId": "tw_p",
        "name": "run_workflow",
        "input": {
          "workflowPath": "@RUN@/ws/.kiro/workflows/wfp.workflow.json",
          "inputs": {}
        }
      }
    ]
  },
  {
    "match": "WFP_STEP do it",
    "not": ["STEP_BASH_RAN", "sb1"],
    "events": [
      {
        "toolUseId": "sb1",
        "name": "execute_bash",
        "input": {
          "command": "echo STEP_BASH_RAN"
        }
      }
    ]
  },
  {
    "match": "WFP_STEP do it",
    "events": ["STEP_AFTER_BASH"]
  },
  {
    "match": ["MAIN_KICKOFF", "started successfully"],
    "delay": 15,
    "events": ["MAIN_DONE"]
  },
  {
    "match": null,
    "events": ["MAIN_DONE"]
  },
  {
    "match": null,
    "events": ["MAIN_DONE"]
  },
  {
    "match": null,
    "events": ["MAIN_DONE"]
  },
  {
    "match": null,
    "events": ["MAIN_DONE"]
  }
]
