{
  "args": ["acp", "--agent-engine", "v3", "--auth-method", "cli"],
  "acp": true,
  "permission": "allow",
  "initSettings": {
    "inlineAgents": "on"
  },
  "new": {
    "_meta": {
      "kiro": {
        "modelId": "claude-sonnet-4"
      }
    }
  },
  "rules": [
    {
      "match": "INLINE_ROOT",
      "events": [
        {
          "toolUseId": "inline",
          "name": "invoke_sub_agent",
          "input": {
            "name": "anonymous",
            "prompt": "INLINE_TASK",
            "explanation": "offline pins",
            "inlineAgent": {
              "systemPrompt": "INLINE_SYSTEM",
              "model": "claude-haiku-4.5",
              "effort": "low"
            }
          }
        }
      ]
    },
    {
      "match": "INLINE_TASK",
      "events": [
        {
          "toolUseId": "result",
          "name": "subagent_response",
          "input": {
            "response": "INLINE_RESULT",
            "files": []
          }
        }
      ]
    },
    {
      "match": null,
      "events": ["ROOT_DONE"]
    }
  ],
  "steps": [
    {
      "method": "session/prompt",
      "params": {
        "sessionId": "$SID",
        "prompt": [
          {
            "type": "text",
            "text": "INLINE_ROOT"
          }
        ]
      }
    }
  ]
}
