{
  "args": [
    "--multi-model",
    "--mode",
    "json",
    "--no-session",
    "-p",
    "go PLAN=[[{\"name\": \"Agent\", \"args\": {\"prompt\": \"CHILD_MM_BUILDER\", \"description\": \"d\", \"subagent_type\": \"Builder\"}}, {\"name\": \"Agent\", \"args\": {\"prompt\": \"CHILD_MM_EXPLORE\", \"description\": \"d\", \"subagent_type\": \"Explore\"}}, {\"name\": \"Agent\", \"args\": {\"prompt\": \"CHILD_MM_OUTSIDE\", \"description\": \"d\", \"subagent_type\": \"Builder\", \"model\": \"kimchi-dev/fake-a\"}}]]"
  ],
  "timeout": 40,
  "settings": {
    "modelRoles": {
      "orchestrator": "kimchi-dev/fake-a",
      "planner": ["kimchi-dev/fake-b"],
      "builder": ["kimchi-dev/fake-b"],
      "reviewer": ["kimchi-dev/fake-b"],
      "explorer": ["kimchi-dev/fake-b"],
      "researcher": ["kimchi-dev/fake-b"],
      "judge": ["kimchi-dev/fake-b"]
    }
  }
}
