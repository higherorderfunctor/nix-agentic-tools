{
  "thread": {},
  "turn": "GO",
  "timeout": 40,
  "settle": 1,
  "actions": [
    {
      "at": 3,
      "method": "turn/interrupt",
      "params": { "threadId": "$THREAD", "turnId": "$TURN" }
    },
    {
      "at": 5,
      "after_done": true,
      "method": "turn/start",
      "params": {
        "threadId": "$THREAD",
        "input": [
          { "type": "text", "text": "SECOND-TURN", "text_elements": [] }
        ]
      }
    }
  ],
  "after": [{ "method": "thread/loaded/list", "params": {} }]
}
