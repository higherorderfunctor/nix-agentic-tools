{
  "/root": [
    {
      "calls": [
        [
          "spawn_agent",
          {
            "task_name": "c_none",
            "message": "TASK-NONE",
            "fork_turns": "none"
          },
          "collaboration"
        ],
        [
          "spawn_agent",
          { "task_name": "c_all", "message": "TASK-ALL", "fork_turns": "all" },
          "collaboration"
        ]
      ]
    },
    { "calls": [["wait_agent", { "timeout_ms": 20000 }, "collaboration"]] },
    { "msg": "ROOT DONE" }
  ],
  "/root/c_none": [
    { "calls": [["list_agents", {}, "collaboration"]] },
    { "msg": "NONE DONE" }
  ],
  "/root/c_all": [
    { "calls": [["list_agents", {}, "collaboration"]] },
    { "msg": "ALL DONE" }
  ]
}
