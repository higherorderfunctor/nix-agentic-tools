{
  "/root": [
    {
      "calls": [
        [
          "spawn_agent",
          { "task_name": "a", "message": "TASK-A", "fork_turns": "none" },
          "collaboration"
        ]
      ]
    },
    { "calls": [["wait_agent", { "timeout_ms": 30000 }, "collaboration"]] },
    { "calls": [["list_agents", {}, "collaboration"]] },
    { "msg": "ROOT DONE" }
  ],
  "/root/a": [{ "sleep": 20, "msg": "A SLOW DONE" }]
}
