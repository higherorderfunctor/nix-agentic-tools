+    ).toEqual([
+      ["zai_quota.five_hour", 58, reset],
+      ["zai_quota.weekly", 70, reset + 86400000],
+    ]);
+    request.mockResolvedValue({
+      statusCode: 401,
+      hasStatusCode: true,
+      body: null,
+      bodyText: "",
+      header: {},
