+  it.each([
+    {},
+    { code: 500, data: payload.data },
+    { code: 200, data: { limits: [] } },
+    {
+      code: 200,
+      data: {
+        limits: payload.data.limits.map((w) => ({
+          ...w,
+          nextResetTime: 1700000000,
+        })),
+      },
+    },
+  ])("rejects missing, failed and second-based quota payloads", (body) => {
+    expect(() => parseZaiQuotaPayload(body)).toThrow();
+  });
+  it("uses only the auth index and token placeholder, then publishes both native display windows", async () => {
+    const request = vi
+      .spyOn(apiCallApi, "request")
+      .mockResolvedValue({
+        statusCode: 200,
+        hasStatusCode: true,
+        body: payload,
+        bodyText: "",
+        header: {},
+      });
+    const states: string[] = [];
+    const setQuota = (
+      updater: Parameters<
+        ReturnType<typeof useQuotaStore.getState>["setZaiQuota"]
+      >[0],
+    ) => {
+      useQuotaStore.getState().setZaiQuota(updater);
+      states.push(
+        useQuotaStore.getState().zaiQuota[getQuotaCredentialStoreKey(file)]
