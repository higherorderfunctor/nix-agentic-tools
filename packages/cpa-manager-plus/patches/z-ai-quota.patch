+      config: ZAI_CONFIG,
+      file,
+      setQuota,
+      t,
+      isCurrent: () => true,
+    });
+    expect(states).toEqual(["loading", "success"]);
+    expect(request).toHaveBeenCalledWith(
+      {
+        authIndex: "actual-index",
+        method: "GET",
+        url: "https://api.z.ai/api/monitor/usage/quota/limit",
+        header: { Authorization: "Bearer $TOKEN$" },
+      },
+      undefined,
+    );
+    const stores = useQuotaStore.getState();
+    const row = buildAccountRows([file], stores)[0];
+    expect(row.accountLabel).toBe("arbitrary group");
+    expect(row.runtimeOnly).toBe(true);
+    expect(canRefreshCredentialQuota(file)).toBe(true);
+    expect(
+      canRefreshCredentialQuota({ ...file, credential_kind: undefined }),
+    ).toBe(false);
+    const windows = buildAccountQuotaDisplayWindows(row, {
+      stores,
+      t,
