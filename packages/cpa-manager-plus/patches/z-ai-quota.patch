+import type { TFunction } from "i18next";
+import { apiCallApi } from "@/services/api/apiCall";
+import type { AuthFilesApiRequestScope } from "@/services/api/authFiles";
+import { createScopedApiRequestConfig } from "@/services/api/client";
+import type { AuthFileItem, ZaiQuotaData } from "@/types";
+
+export const parseZaiQuotaPayload = (body: unknown): ZaiQuotaData => {
+  if (!body || typeof body !== "object")
+    throw new Error("Invalid z.ai quota response");
+  const root = body as { code?: unknown; data?: { limits?: unknown } };
+  if (root.code !== 200 || !Array.isArray(root.data?.limits))
+    throw new Error("Invalid z.ai quota response");
+  const limits = root.data.limits as Array<Record<string, unknown>>;
+  const windows = (
+    [
+      { id: "five_hour", unit: 3, number: 5, periodHours: 5 },
+      { id: "weekly", unit: 6, number: 1, periodHours: 168 },
+    ] as const
+  ).map(({ id, unit, number, periodHours }) => {
+    const limit = limits.find(
+      (item) => item.unit === unit && item.number === number,
+    );
+    const used = limit?.percentage;
+    const reset = limit?.nextResetTime;
+    if (
+      typeof used !== "number" ||
+      !Number.isFinite(used) ||
+      used < 0 ||
+      used > 100 ||
+      typeof reset !== "number" ||
+      !Number.isSafeInteger(reset) ||
+      reset < 1e12 ||
+      !Number.isFinite(new Date(reset).getTime())
+    )
+      throw new Error("Missing or invalid z.ai quota window");
+    return { id, periodHours, remainingPercent: 100 - used, resetAtMs: reset };
+  });
+  return { windows, observedAtMs: Date.now() };
+};
+
+export const fetchZaiQuota = async (
+  file: AuthFileItem,
+  _t: TFunction,
+  scope?: AuthFilesApiRequestScope,
+): Promise<ZaiQuotaData> => {
+  const authIndex = String(file.auth_index ?? file.authIndex ?? "").trim();
+  if (!authIndex) throw new Error("Missing z.ai credential identity");
+  const result = await apiCallApi.request(
+    {
+      authIndex,
+      method: "GET",
+      url: "https://api.z.ai/api/monitor/usage/quota/limit",
+      header: { Authorization: "Bearer $TOKEN$" },
+    },
+    scope ? createScopedApiRequestConfig(scope) : undefined,
+  );
+  if (
+    !result.hasStatusCode ||
+    result.statusCode < 200 ||
+    result.statusCode >= 300
+  )
+    throw Object.assign(new Error("z.ai quota request failed"), {
+      status: result.statusCode,
+    });
+  return parseZaiQuotaPayload(result.body);
+};
