+        nextResetTime: reset,
+      },
+      {
+        type: "changed-type",
+        unit: 6,
+        number: 1,
+        percentage: 30,
+        nextResetTime: reset + 86400000,
+      },
+      {
+        type: "same-type",
+        unit: 3,
+        number: 5,
+        percentage: 42,
