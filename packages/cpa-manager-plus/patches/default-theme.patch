+func TestLoadDefaultTheme(t *testing.T) {
+	for _, test := range []struct {
+		contents string
+		want     string
+	}{
+		{contents: `{}`, want: "auto"},
+		{contents: `{"defaultTheme":"dark"}`, want: "dark"},
+		{contents: `{"defaultTheme":"white"}`, want: "white"},
+		{contents: `{"defaultTheme":"light"}`},
+		{contents: `{"defaultTheme":" dark"}`},
+	} {
+		t.Run(test.contents, func(t *testing.T) {
+			clearConfigEnv(t)
+			configPath := filepath.Join(t.TempDir(), "config.json")
+			if err := os.WriteFile(configPath, []byte(test.contents), 0o600); err != nil {
+				t.Fatalf("write config: %v", err)
+			}
+			t.Setenv(configEnvKey, configPath)
+			cfg, err := LoadWithoutCreatingDefault()
+			if test.want == "" {
+				if err == nil {
+					t.Fatalf("defaultTheme loaded as %q", cfg.DefaultTheme)
+				}
+				return
+			}
+			if err != nil || cfg.DefaultTheme != test.want {
+				t.Fatalf("defaultTheme = %q, %v; want %q", cfg.DefaultTheme, err, test.want)
+			}
+		})
+	}
+}
