diff --git a/apps/web/src/stores/useThemeStore.test.ts b/apps/web/src/stores/useThemeStore.test.ts
new file mode 100644
index 0000000..3bd1279
--- /dev/null
+++ b/apps/web/src/stores/useThemeStore.test.ts
@@ -0,0 +1,77 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { STORAGE_KEY_THEME } from '@/utils/constants';
+
+const storage = new Map<string, string>();
+
+const load = async (stored?: { state: object; version: number }) => {
+  storage.clear();
+  if (stored) {
+    storage.set(STORAGE_KEY_THEME, JSON.stringify(stored));
+  }
+  vi.resetModules();
+  const { useThemeStore } = await import('./useThemeStore');
+  useThemeStore.getState().initializeTheme();
+  return useThemeStore;
+};
+
+describe('useThemeStore defaultTheme', () => {
+  beforeEach(() => {
+    vi.stubGlobal('localStorage', {
+      getItem: (key: string) => storage.get(key) ?? null,
+      setItem: (key: string, value: string) => storage.set(key, value),
+      removeItem: (key: string) => storage.delete(key),
+    });
+    vi.stubGlobal('window', {
+      matchMedia: () => ({
+        matches: false,
+        addEventListener: () => {},
+        removeEventListener: () => {},
+      }),
+    });
+    vi.stubGlobal('document', {
+      documentElement: { setAttribute: vi.fn(), removeAttribute: vi.fn() },
+    });
+  });
+
+  it('applies the server default when nothing is stored, and keeps it unchosen', async () => {
+    const store = await load();
+    store.getState().applyDefaultTheme('dark');
+    expect(store.getState()).toMatchObject({ theme: 'dark', chosen: false });
+    expect(document.documentElement.setAttribute).toHaveBeenLastCalledWith('data-theme', 'dark');
+    expect(JSON.parse(storage.get(STORAGE_KEY_THEME) ?? '{}').state.chosen).toBe(false);
+  });
+
+  it('ignores a value that is not a theme', async () => {
+    const store = await load();
+    store.getState().applyDefaultTheme('light');
+    store.getState().applyDefaultTheme(undefined);
+    expect(store.getState().theme).toBe('auto');
+  });
+
+  it("keeps the user's choice, auto included", async () => {
+    const store = await load();
+    store.getState().setTheme('auto');
+    store.getState().applyDefaultTheme('dark');
+    expect(store.getState()).toMatchObject({ theme: 'auto', chosen: true });
+
+    const reloaded = await load({ state: { theme: 'white', chosen: true }, version: 1 });
+    reloaded.getState().applyDefaultTheme('dark');
+    expect(reloaded.getState().theme).toBe('white');
+  });
+
+  it('follows a changed server default for a theme the user never chose', async () => {
+    const store = await load({ state: { theme: 'dark', chosen: false }, version: 1 });
+    store.getState().applyDefaultTheme('auto');
+    expect(store.getState().theme).toBe('auto');
+  });
+
+  it("migrates version 0: a stored 'white' or 'dark' was chosen, 'auto' was not", async () => {
+    const dark = await load({ state: { theme: 'dark', resolvedTheme: 'dark' }, version: 0 });
+    dark.getState().applyDefaultTheme('white');
+    expect(dark.getState()).toMatchObject({ theme: 'dark', chosen: true });
+
+    const auto = await load({ state: { theme: 'auto', resolvedTheme: 'light' }, version: 0 });
+    auto.getState().applyDefaultTheme('dark');
+    expect(auto.getState()).toMatchObject({ theme: 'dark', chosen: false });
+  });
+});
