+// defaultThemes are the web panel's Theme values (apps/web/src/types/common.ts).
+var defaultThemes = []string{"auto", "dark", "white"}
+
+func resolveDefaultTheme(value string) (string, error) {
+	if value == "" {
+		return defaultThemes[0], nil
+	}
+	if !slices.Contains(defaultThemes, value) {
+		return "", fmt.Errorf("defaultTheme must be one of %s, not %q", strings.Join(defaultThemes, ", "), value)
+	}
+	return value, nil
+}
