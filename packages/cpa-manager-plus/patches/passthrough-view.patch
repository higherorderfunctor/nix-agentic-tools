+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { mocks } = vi.hoisted(() => ({
+  mocks: {
+    get: vi.fn(),
+  },
+}));
+
+vi.mock('./client', () => ({
+  apiClient: {
+    get: mocks.get,
+  },
+}));
+
+vi.mock('@/stores/useAuthStore', () => ({
+  useAuthStore: {
+    getState: () => ({ apiBase: 'https://cpa.example.com/v0/management' }),
+  },
+}));
+
+import { passthroughApi } from './passthrough';
+
+beforeEach(() => {
+  mocks.get.mockReset();
+});
+
+describe('passthroughApi.getGroups', () => {
+  it('requests the v8 passthrough projection outside the v0 base', async () => {
+    mocks.get.mockResolvedValue([]);
+
+    await passthroughApi.getGroups();
+
+    expect(mocks.get).toHaveBeenCalledWith(
+      'https://cpa.example.com/v8/management/config/api-keys/passthrough'
+    );
+  });
+
+  it('normalizes v8 groups and their key auth indexes', async () => {
+    mocks.get.mockResolvedValue([
+      {
+        name: ' Search API ',
+        'base-url': 'https://search.example.com',
+        path: '/v1/search',
+        priority: 3,
+        disabled: true,
+        models: [{ name: 'web-search', alias: 'search' }],
+        keys: [{ 'api-key': 'sk-one', auth_index: 'abc123' }, { 'api-key': 'sk-two' }],
+      },
+    ]);
+
+    await expect(passthroughApi.getGroups()).resolves.toEqual([
+      {
+        baseUrl: 'https://search.example.com',
+        disabled: true,
+        keys: [
+          { apiKey: 'sk-one', authIndex: 'abc123' },
+          { apiKey: 'sk-two', authIndex: undefined },
+        ],
+        models: [{ alias: 'search', name: 'web-search' }],
+        name: 'Search API',
+        path: '/v1/search',
+        priority: 3,
+        providerKey: 'passthrough-search api',
+      },
+    ]);
+  });
+
+  it('reads a 404 or any other failure as no groups', async () => {
+    mocks.get.mockRejectedValueOnce(Object.assign(new Error('not_found'), { status: 404 }));
+    await expect(passthroughApi.getGroups()).resolves.toEqual([]);
+
+    mocks.get.mockRejectedValueOnce(new Error('Network Error'));
+    await expect(passthroughApi.getGroups()).resolves.toEqual([]);
+  });
+});
