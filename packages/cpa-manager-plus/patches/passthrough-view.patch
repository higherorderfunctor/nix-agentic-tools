+
+describe('loadMonitoringMetaPayload passthrough channels', () => {
+  it('appends one channel per passthrough group after the OpenAI channels', async () => {
+    mocks.get.mockResolvedValue({
+      'openai-compatibility': [
+        {
+          name: 'search',
+          'base-url': 'https://openai.example.com',
+          'api-key-entries': [{ 'api-key': 'sk-openai', auth_index: 'oa-1' }],
