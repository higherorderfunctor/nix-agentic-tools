+      ],
+    });
+    mocks.getGroups.mockResolvedValueOnce([
+      { ...searchGroup, keys: [{ apiKey: 'sk-rerank', authIndex: 'pt-9' }], name: 'rerank' },
+    ]);
+    const shown = (await loadMonitoringMetaPayload(null)).channels;
+
+    mocks.get.mockRejectedValueOnce(new Error('openai down'));
+    mocks.getGroups.mockResolvedValueOnce([searchGroup]);
+    const refreshed = mergeRefreshedChannels(shown, await loadMonitoringMetaPayload(null));
+
+    expect(refreshed.map(({ authIndices, name }) => ({ authIndices, name }))).toEqual([
+      { authIndices: ['oa-1'], name: 'chat' },
+      { authIndices: ['pt-1', 'pt-2'], name: 'search' },
+    ]);
+  });
+});
