@@ -0,0 +1,118 @@
+import { act } from 'react';
+import { create, type ReactTestInstance, type ReactTestRenderer } from 'react-test-renderer';
+import { describe, expect, it, vi } from 'vitest';
+import type { PassthroughGroup } from '@/services/api/passthrough';
+import { buildRecentRequestCompositeKey } from '@/utils/recentRequests';
+import { ProviderStatusBar } from '../ProviderStatusBar';
+import type { ProviderRecentUsageMap } from '../utils';
+import { PassthroughTable } from './PassthroughTable';
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string) => key,
+  }),
+}));
+
+const groups: PassthroughGroup[] = [
+  {
+    baseUrl: 'https://zai.example/api',
+    disabled: false,
+    keys: [
+      { apiKey: 'secret-key-one', authIndex: 'a1' },
+      { apiKey: 'secret-key-two', authIndex: 'a2' },
+    ],
+    models: [{ alias: 'glm', name: 'glm-4.6' }, { name: 'glm-4.5' }],
+    name: 'Zai',
+    path: '/v1/chat/completions',
+    priority: 7,
+    providerKey: 'passthrough-zai',
+  },
+  {
+    baseUrl: 'https://off.example',
+    disabled: true,
+    keys: [{ apiKey: 'secret-key-three' }],
+    models: [{ name: 'claude-sonnet' }],
+    name: 'Off',
+    path: '/v1/messages',
+    providerKey: 'passthrough-off',
+  },
+];
+
+const getText = (node: ReactTestInstance): string =>
+  node.children.map((child) => (typeof child === 'string' ? child : getText(child))).join('');
+
+const getRows = (renderer: ReactTestRenderer) =>
+  renderer.root.findAll(
+    (node) => node.type === 'div' && node.props.role === 'row' && node.props['aria-label']
+  );
+
+const render = (usageByProvider: ProviderRecentUsageMap = new Map()) => {
+  let renderer!: ReactTestRenderer;
+  act(() => {
+    renderer = create(
+      <PassthroughTable
+        groups={groups}
+        usageByProvider={usageByProvider}
+        loading={false}
+        emptyState={<span>empty</span>}
+      />
+    );
+  });
+  return renderer;
+};
+
+describe('PassthroughTable', () => {
+  it('shows each group with its URL, path, models, priority, key count and state', () => {
+    const [zai, off] = getRows(render());
+
+    const zaiText = getText(zai);
+    expect(zaiText).toContain('Zai');
+    expect(zaiText).toContain('https://zai.example/api');
+    expect(zaiText).toContain('/v1/chat/completions');
+    expect(zaiText).toContain('ai_providers.openai_keys_count: 2');
+    const zaiCells = zai.findAll((node) => node.type === 'div' && node.props.role === 'cell');
+    expect(getText(zaiCells[4])).toBe('common.priority7');
+    expect(zaiText).toContain('common.enabled');
+    expect(zai.findByProps({ title: 'glm → glm-4.6\nglm-4.5' })).toBeTruthy();
+
+    const offCells = off.findAll((node) => node.type === 'div' && node.props.role === 'cell');
+    expect(getText(offCells[4])).toBe('common.priority—');
+    expect(getText(offCells[6])).toBe('common.disabled');
+  });
+
+  it('offers no control and never renders key text', () => {
+    const renderer = render();
+
+    expect(
+      renderer.root.findAll((node) => ['button', 'input', 'select'].includes(String(node.type)))
+    ).toHaveLength(0);
+    expect(
+      renderer.root.findAll((node) => typeof node.props.onClick === 'function')
+    ).toHaveLength(0);
+    expect(JSON.stringify(renderer.toJSON())).not.toContain('secret-key');
+  });
+
+  it('reads recent requests under the passthrough provider key', () => {
+    const usageByProvider: ProviderRecentUsageMap = new Map([
+      [
+        'passthrough-zai',
+        new Map([
+          [
+            buildRecentRequestCompositeKey('https://zai.example/api', 'secret-key-one'),
+            { success: 4, failed: 1, recentRequests: [] },
+          ],
+          [
+            buildRecentRequestCompositeKey('https://zai.example/api', 'secret-key-two'),
+            { success: 2, failed: 0, recentRequests: [] },
+          ],
+        ]),
+      ],
+    ]);
+    const [zai, off] = getRows(render(usageByProvider));
+
+    expect(getText(zai.findByProps({ title: 'stats.success' }))).toBe(' 6');
+    expect(getText(zai.findByProps({ title: 'stats.failure' }))).toBe(' 1');
+    expect(zai.findAllByType(ProviderStatusBar)).toHaveLength(1);
+    expect(getText(off)).toContain('status_bar.no_requests');
+  });
+});
diff --git a/apps/web/src/components/providers/PassthroughTable/PassthroughTable.tsx b/apps/web/src/components/providers/PassthroughTable/PassthroughTable.tsx
