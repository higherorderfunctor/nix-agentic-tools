+
+  it('keeps passthrough channels when the OpenAI fetch fails, reporting only that error', async () => {
+    mocks.get.mockRejectedValue(new Error('openai down'));
+    mocks.getGroups.mockResolvedValue([searchGroup]);
+
+    const payload = await loadMonitoringMetaPayload(null);
+
+    expect(payload.channels.map(({ name }) => name)).toEqual(['search']);
+    expect(payload.channelsLoaded).toBe(false);
+    expect(payload.error).toBe('openai down');
+  });
+});
+
+describe('mergeRefreshedChannels', () => {
+  it('keeps the shown OpenAI channels and takes fresh passthrough channels when only OpenAI fails', async () => {
+    mocks.get.mockResolvedValueOnce({
+      'openai-compatibility': [
+        {
+          name: 'chat',
+          'base-url': 'https://openai.example.com',
+          'api-key-entries': [{ 'api-key': 'sk-openai', auth_index: 'oa-1' }],
