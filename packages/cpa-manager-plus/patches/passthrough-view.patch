+import type { ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { IconCheck, IconX } from '@/components/ui/icons';
+import type { PassthroughGroup } from '@/services/api/passthrough';
+import { ProviderStatusBar } from '../ProviderStatusBar';
+import styles from '../ProviderTable/ProviderTable.module.scss';
+import {
+  getOpenAIProviderRecentStatusData,
+  getOpenAIProviderTotalStats,
+  type ProviderRecentUsageMap,
+} from '../utils';
+
+interface PassthroughTableProps {
+  groups: PassthroughGroup[];
+  usageByProvider: ProviderRecentUsageMap;
+  loading: boolean;
+  emptyState: ReactNode;
+}
+
+// Lists CPA passthrough groups read-only: the config file owns them, so no row
+// offers a control. Keys feed the status lookup only; the row shows their count.
+export function PassthroughTable({
+  groups,
+  usageByProvider,
+  loading,
+  emptyState,
+}: PassthroughTableProps) {
+  const { t } = useTranslation();
+
+  if (loading && groups.length === 0) {
+    return <div className="hint">{t('common.loading')}</div>;
+  }
+
+  if (groups.length === 0) {
+    return <>{emptyState}</>;
+  }
+
+  return (
+    <div className={styles.table} role="table" aria-label={t('ai_providers.table_aria_label')}>
+      <div className={styles.headerRow} role="row">
+        <span role="columnheader">{t('ai_providers.table_col_type')}</span>
+        <span role="columnheader">{t('ai_providers.table_col_identity')}</span>
+        <span role="columnheader">{t('common.base_url')}</span>
+        <span role="columnheader" className={styles.cellModelsHeader}>
+          {t('ai_providers.table_col_models')}
+        </span>
+        <span role="columnheader" className={styles.cellPriorityHeader}>
+          {t('common.priority')}
+        </span>
+        <span role="columnheader" className={styles.cellRecentHeader}>
+          {t('ai_providers.table_col_recent')}
+        </span>
+        <span role="columnheader">{t('ai_providers.config_toggle_label')}</span>
+        <span role="columnheader" className={styles.cellActionsHeader}>
+          {t('ai_providers.table_col_actions')}
+        </span>
+      </div>
+
+      {groups.map((group) => {
+        // CPA records usage under the provider key and each key's base_url|api_key.
+        const usageProvider = {
+          name: group.providerKey,
+          baseUrl: group.baseUrl,
+          apiKeyEntries: group.keys,
+        };
+        const stats = getOpenAIProviderTotalStats(usageProvider, usageByProvider);
+        return (
+          <div
+            key={group.providerKey}
+            role="row"
+            className={`${styles.row} ${group.disabled ? styles.rowDisabled : ''}`}
+            aria-label={`Passthrough ${group.name}`}
+          >
+            <div className={styles.cellType} role="cell">
+              <span className={styles.kindLabel}>Passthrough</span>
+            </div>
+
+            <div className={styles.cellIdentity} role="cell">
+              <div className={styles.identityMain}>
+                <span className={styles.identityLabel} title={group.name}>
+                  {group.name}
+                </span>
+                <span className={styles.identityMeta}>
+                  {t('ai_providers.openai_keys_count')}: {group.keys.length}
+                </span>
+              </div>
+            </div>
+
+            <div className={styles.cellUrl} role="cell" title={group.baseUrl || undefined}>
+              {group.baseUrl || '—'}
+              <div className={styles.identityMeta}>{group.path || '—'}</div>
+            </div>
+
+            <div
+              className={`${styles.cellModels} ${styles.cellNumeric}`}
+              role="cell"
+              title={group.models
+                .map((model) => (model.alias ? `${model.alias} → ${model.name}` : model.name))
+                .join('\n')}
+            >
+              <span className={styles.cellCaption}>{t('ai_providers.table_col_models')}</span>
+              {group.models.length}
+            </div>
+
+            <div className={`${styles.cellPriority} ${styles.cellNumeric}`} role="cell">
+              <span className={styles.cellCaption}>{t('common.priority')}</span>
+              {group.priority ?? '—'}
+            </div>
+
+            <div className={styles.cellRecent} role="cell">
+              {stats.success + stats.failure > 0 ? (
+                <>
+                  <span className={styles.statSuccess} title={t('stats.success')}>
+                    <IconCheck size={12} /> {stats.success}
+                  </span>
+                  <span className={styles.statFailure} title={t('stats.failure')}>
+                    <IconX size={12} /> {stats.failure}
+                  </span>
+                  <div className={styles.recentBarWrap}>
+                    <ProviderStatusBar
+                      statusData={getOpenAIProviderRecentStatusData(usageProvider, usageByProvider)}
+                    />
+                  </div>
+                </>
+              ) : (
+                <span className={styles.noRecent}>{t('status_bar.no_requests')}</span>
+              )}
+            </div>
+
+            <div className={styles.cellToggle} role="cell">
+              {group.disabled ? t('common.disabled') : t('common.enabled')}
+            </div>
+
+            <div className={styles.cellActions} role="cell">
+              <span className={styles.noRecent}>
+                {t('ai_providers.passthrough_managed', { defaultValue: 'Managed by Nix' })}
+              </span>
+            </div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
