diff --git a/apps/web/src/services/api/passthrough.ts b/apps/web/src/services/api/passthrough.ts
new file mode 100644
index 0000000..a773c00
--- /dev/null
+++ b/apps/web/src/services/api/passthrough.ts
@@ -0,0 +1,72 @@
+import { apiClient } from './client';
+import { useAuthStore } from '@/stores/useAuthStore';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import { normalizeApiBase } from '@/utils/connection';
+import { isRecord } from '@/utils/helpers';
+
+export interface PassthroughKey {
+  apiKey: string;
+  authIndex?: string;
+}
+
+export interface PassthroughModel {
+  alias?: string;
+  name: string;
+}
+
+export interface PassthroughGroup {
+  baseUrl: string;
+  disabled: boolean;
+  keys: PassthroughKey[];
+  models: PassthroughModel[];
+  name: string;
+  path: string;
+  priority?: number;
+  providerKey: string;
+}
+
+const readText = (value: unknown) => (typeof value === 'string' ? value.trim() : '');
+
+// Reads one group of CPA's v8 projection, whose keys carry the live auth_index.
+const normalizePassthroughGroup = (value: unknown): PassthroughGroup | null => {
+  if (!isRecord(value)) return null;
+  const name = readText(value.name);
+  if (!name) return null;
+
+  const keys = (Array.isArray(value.keys) ? value.keys : []).filter(isRecord).map((key) => ({
+    apiKey: readText(key['api-key']),
+    authIndex: normalizeAuthIndex(key.auth_index) ?? undefined,
+  }));
+  const models = (Array.isArray(value.models) ? value.models : [])
+    .filter(isRecord)
+    .map((model) => ({ alias: readText(model.alias) || undefined, name: readText(model.name) }))
+    .filter((model) => model.name);
+
+  return {
+    baseUrl: readText(value['base-url']),
+    disabled: value.disabled === true,
+    keys,
+    models,
+    name,
+    path: readText(value.path),
+    priority: typeof value.priority === 'number' ? value.priority : undefined,
+    providerKey: `passthrough-${name.toLowerCase()}`,
+  };
+};
+
+export const passthroughApi = {
+  // The v8 path sits outside the client's v0 base, so the URL is absolute; the
+  // client still adds the management key. A config without passthrough groups
+  // answers 404, so every failure reads as no groups.
+  getGroups: async (): Promise<PassthroughGroup[]> => {
+    const base = normalizeApiBase(useAuthStore.getState().apiBase);
+    try {
+      const data = await apiClient.get(`${base}/v8/management/config/api-keys/passthrough`);
+      return (Array.isArray(data) ? data : [])
+        .map(normalizePassthroughGroup)
+        .filter((group): group is PassthroughGroup => group !== null);
+    } catch {
+      return [];
+    }
+  },
+};
