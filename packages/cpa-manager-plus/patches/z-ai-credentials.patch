+package proxy
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestConfigCredentialsProjection(t *testing.T) {
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v8/management/config/api-keys/openai-compatibility" || r.Header.Get("Authorization") != "Bearer manager-secret" {
+			t.Errorf("unexpected configuration request: %s", r.URL.Path)
+		}
+		fmt.Fprint(w, `[
+   {"name":"arbitrary label","base-url":"https://api.z.ai/api/coding/paas/v4?key=query-secret","keys":[{"api-key":"upstream-secret","auth_index":"first"},{"auth_index":"second"},{"auth_index":""}]},
+   {"name":"z.ai","base-url":"https://elsewhere.invalid/api/z.ai","keys":[{"auth_index":"wrong-host"}]},
+   {"base-url":"https://api.z.ai.evil.invalid","keys":[{"auth_index":"suffix"}]},
+   {"base-url":"http://api.z.ai","keys":[{"auth_index":"insecure"}]},
+   {"base-url":"https://user:password@api.z.ai","keys":[{"auth_index":"userinfo"}]},
+   {"base-url":"https://api.z.ai:8443","keys":[{"auth_index":"port"}]},
+   {"base-url":"%","keys":[{"auth_index":"malformed"}]}
+  ]`)
+	}))
+	defer upstream.Close()
+	files, err := readConfigCredentials(context.Background(), upstream.Client(), upstream.URL, "manager-secret")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 2 {
+		t.Fatalf("got %d credentials, want 2", len(files))
+	}
+	if files[0].AuthIndex != "first" || files[0].Name != "config:z-ai:first" || files[0].Label != "arbitrary label" || files[0].Provider != "z-ai" || files[0].CredentialKind != "config-api-key" || !files[0].RuntimeOnly {
+		t.Fatalf("unexpected projection: %+v", files[0])
+	}
+	if files[1].AuthIndex != "second" {
+		t.Fatalf("second key missing: %+v", files[1])
+	}
+	encoded, err := json.Marshal(files)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var projected []map[string]json.RawMessage
+	if err := json.Unmarshal(encoded, &projected); err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range projected {
+		for _, field := range []string{"api-key", "base-url", "password"} {
+			if _, exists := row[field]; exists {
+				t.Fatalf("response includes forbidden property %s", field)
+			}
+		}
+	}
+	for _, secret := range []string{"upstream-secret", "manager-secret", "query-secret", "password"} {
+		if strings.Contains(string(encoded), secret) {
+			t.Fatalf("response leaks %s", secret)
+		}
+	}
+}
+
+func TestConfigCredentialsUpstreamFailures(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		status    int
+		body      string
+		wantError bool
+	}{
+		{"absent endpoint", 404, "secret", false},
+		{"empty config", 200, "[]", false},
+		{"denied", 401, "secret", true},
+		{"server failure", 500, "secret", true},
+		{"malformed", 200, `[{"api-key":"secret"`, true},
+		{"wrong envelope", 200, `{"api-key":"secret"}`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(tc.status); fmt.Fprint(w, tc.body) }))
+			defer upstream.Close()
+			files, err := readConfigCredentials(context.Background(), upstream.Client(), upstream.URL, "key")
+			if (err != nil) != tc.wantError {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if err != nil && strings.Contains(err.Error(), "secret") {
+				t.Fatal("upstream body leaked")
+			}
+			if !tc.wantError && (files == nil || len(files) != 0) {
+				t.Fatalf("want empty array, got %+v", files)
+			}
+		})
+	}
+}
+
+func TestConfigCredentialsReserved(t *testing.T) {
+	if IsCPAPluginManagementPath("/v0/management/config-credentials") {
+		t.Fatal("config credentials must require Manager admin authentication")
+	}
+}
