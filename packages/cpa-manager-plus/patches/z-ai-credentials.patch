+package proxy
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// ConfigCredential is a read-only runtime identity, never an OAuth auth file.
+// Keep this an allowlist: the upstream configuration also contains API keys.
+type ConfigCredential struct {
+	AuthIndex      string `json:"auth_index"`
+	CredentialKind string `json:"credential_kind"`
+	Label          string `json:"label"`
+	Name           string `json:"name"`
+	Provider       string `json:"provider"`
+	RuntimeOnly    bool   `json:"runtime_only"`
+}
+
+type configCredentialGroup struct {
+	BaseURL string `json:"base-url"`
+	Keys    []struct {
+		AuthIndex string `json:"auth_index"`
+	} `json:"keys"`
+	Name string `json:"name"`
+}
+
+func (s *Service) ConfigCredentials(w http.ResponseWriter, r *http.Request, writeError func(http.ResponseWriter, int, error)) {
+	setup, ok, err := s.resolveSetup(r.Context())
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, err)
+		return
+	}
+	if !ok {
+		writeError(w, http.StatusPreconditionRequired, errors.New("usage service is not configured"))
+		return
+	}
+	client := &http.Client{Timeout: 15 * time.Second, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	files, err := readConfigCredentials(r.Context(), client, setup.CPAUpstreamURL, setup.ManagementKey)
+	if err != nil {
+		writeError(w, http.StatusBadGateway, err)
+		return
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(struct {
+		Files []ConfigCredential `json:"files"`
+	}{Files: files})
+}
+
+func readConfigCredentials(ctx context.Context, client *http.Client, upstream, managementKey string) ([]ConfigCredential, error) {
+	target, err := url.Parse(upstream)
+	if err != nil {
+		return nil, errors.New("invalid CPA upstream URL")
+	}
+	target.Path = strings.TrimRight(target.Path, "/") + "/v8/management/config/api-keys/openai-compatibility"
+	target.RawPath, target.RawQuery, target.Fragment = "", "", ""
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return nil, errors.New("invalid CPA configuration request")
+	}
+	req.Header.Set("Authorization", "Bearer "+managementKey)
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, errors.New("CPA configuration request failed")
+	}
+	defer resp.Body.Close()
+	// Older CPA releases lack v8. No configuration credentials are discoverable.
+	if resp.StatusCode == http.StatusNotFound {
+		return []ConfigCredential{}, nil
+	}
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("CPA configuration returned HTTP %d", resp.StatusCode)
+	}
+	var groups []configCredentialGroup
+	decoder := json.NewDecoder(resp.Body)
+	if err := decoder.Decode(&groups); err != nil {
+		// Do not forward decode errors or upstream bodies: either may contain keys.
+		return nil, errors.New("invalid CPA configuration response")
+	}
+	files := make([]ConfigCredential, 0)
+	for _, group := range groups {
+		base, err := url.Parse(group.BaseURL)
+		if err != nil || base.Scheme != "https" || !strings.EqualFold(base.Hostname(), "api.z.ai") || (base.Port() != "" && base.Port() != "443") || base.User != nil {
+			continue
+		}
+		for _, key := range group.Keys {
+			index := strings.TrimSpace(key.AuthIndex)
+			if index == "" {
+				continue
+			}
+			id := "config:z-ai:" + index
+			files = append(files, ConfigCredential{AuthIndex: index, CredentialKind: "config-api-key", Label: group.Name, Name: id, Provider: "z-ai", RuntimeOnly: true})
+		}
+	}
+	return files, nil
+}
