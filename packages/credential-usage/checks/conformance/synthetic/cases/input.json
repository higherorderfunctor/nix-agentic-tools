{
  "transports": ["cpa", "direct"],
  "now": "2026-11-01T00:00:00Z",
  "credentials": { "login": "sample-private-value\n" },
  "executables": { "reader-plan": "printf '%s\\n' standard" },
  "replies": {
    "meter": {
      "status": 200,
      "body": "{\"budget\":50,\"cost\":12.5,\"currency\":\"USD\"}"
    },
    "proxy-meter": {
      "status": 200,
      "body": { "status_code": 200, "body_from": "meter" }
    }
  },
  "scenarios": {
    "success": {
      "extends": null,
      "env": { "CREDENTIAL_FILE": "${credentials:login}" },
      "direct": { "env": { "TRANSPORT": "direct" }, "replies": ["meter"] },
      "cpa": { "env": { "TRANSPORT": "cpa" }, "replies": ["proxy-meter"] }
    }
  }
}
