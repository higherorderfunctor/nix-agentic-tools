+def _embed_gpu_layers() -> int:
+    """Resolve GPU offload without letting a bad setting disable embeddings.
+
+    llama.cpp accepts -1 for all layers, or a nonnegative signed 32-bit count.
+    Bound the integer before passing it through ctypes, which would otherwise
+    wrap a very large value rather than report a configuration error.
+    """
+    raw = os.environ.get(_N_GPU_LAYERS_ENV)
+    if raw is None:
+        return _DEFAULT_N_GPU_LAYERS
+    try:
+        value = int(raw)
+        if -1 <= value <= 0x7FFFFFFF:
+            return value
+    except ValueError:
+        pass
+    logger.warning(
+        "Invalid %s=%r; expected -1 or a nonnegative 32-bit integer; using %d",
+        _N_GPU_LAYERS_ENV, raw, _DEFAULT_N_GPU_LAYERS,
+    )
+    return _DEFAULT_N_GPU_LAYERS
+
