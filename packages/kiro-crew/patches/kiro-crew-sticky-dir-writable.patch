+++ b/src/kiro_crew/dashboard/terminal_commands.py
@@ -392,14 +392,20 @@ def _trusted_owner(st: os.stat_result, own_uid: int | None) -> bool:
       already exposes. A tool this user installed is inside the same trust
       boundary as the shell that is about to run it.
 
-    Write access held by anyone ELSE disqualifies the node whoever owns it:
-    world-writable always, and group-writable only for an administrator group
-    (``_ADMIN_WRITE_GIDS``) when this gateway is NOT root.
+    Write access held by anyone ELSE disqualifies a non-sticky node whoever
+    owns it, except for an administrator group (``_ADMIN_WRITE_GIDS``) when
+    this gateway is NOT root. Sticky directories protect the child entries
+    whose ownership the same walk checks.
     """
     mode = st.st_mode
-    if mode & stat.S_IWOTH:
+    # A sticky directory (for example /tmp or /nix/store) lets other accounts
+    # create entries, not replace entries owned by root or this user. The walk
+    # checks each child owner too, so this does not admit an attacker's binary.
+    # Sticky on a regular file offers no protection against writes.
+    sticky_dir = stat.S_ISDIR(mode) and bool(mode & stat.S_ISVTX)
+    if not sticky_dir and mode & stat.S_IWOTH:
         return False
-    if mode & stat.S_IWGRP:
+    if not sticky_dir and mode & stat.S_IWGRP:
         # The administrator-group exemption is for a gateway running as an
         # ordinary user, where an admin-group member can already sudo and so
         # gains nothing from the write bit. A ROOT gateway is the opposite case:
