+    @pytest.mark.parametrize("mode", [0o41775, 0o41777])
+    def test_sticky_directory_keeps_child_ownership_boundary(self, mode):
+        # Even a root gateway may traverse the store: sticky prevents another
+        # account from replacing its root-owned children. Files stay protected.
+        assert tc._trusted_owner(_fake_st(0, 0, mode), 1000) is True
+        assert tc._trusted_owner(_fake_st(0, 0, mode), 0) is True
+        assert tc._trusted_owner(_fake_st(1000, 0, mode), 1000) is True
+        assert tc._trusted_owner(_fake_st(2000, 0, mode), 1000) is False
+        assert tc._trusted_owner(_fake_st(0, 0, 0o101777), 1000) is False
+
     def test_ownership_on_a_host_without_uids_keeps_the_administrator_branch(self):
         # `own_uid=None` is Windows, where every st_uid reads 0.
         assert tc._trusted_owner(_fake_st(0, 0, 0o40755), None) is True
