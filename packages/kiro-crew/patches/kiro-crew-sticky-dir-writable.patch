+    @pytest.mark.parametrize("mode", [0o41775, 0o41777])
+    def test_sticky_directory_keeps_child_ownership_boundary(self, mode):
+        # Even a root gateway may traverse the store: in a root-owned sticky
+        # directory, only root may replace a root-owned child. A THIRD PARTY's
+        # sticky directory is refused (uid 2000) precisely because a directory
+        # owner may replace entries it does not own. Files stay protected.
+        assert tc._trusted_owner(_fake_st(0, 0, mode), 1000) is True
+        assert tc._trusted_owner(_fake_st(0, 0, mode), 0) is True
+        assert tc._trusted_owner(_fake_st(1000, 0, mode), 1000) is True
+        assert tc._trusted_owner(_fake_st(2000, 0, mode), 1000) is False
+        assert tc._trusted_owner(_fake_st(0, 0, 0o101777), 1000) is False
+
+    @pytest.mark.skipif(sys.platform == "win32", reason="uid 0 has no meaning on Windows")
+    @pytest.mark.parametrize("mode", [0o1775, 0o1777])
+    def test_an_attacker_owned_sticky_parent_is_refused_by_the_walk(
+        self, mode, tmp_path, monkeypatch,
+    ):
+        # The predicate above is only half the answer: the sticky exemption
+        # skips the write bits, so a third party's sticky directory is kept out
+        # by the ownership check alone. Assert that at the WALK, because the
+        # child being root-owned does NOT make it safe — the directory's owner
+        # may replace an entry it does not own — and a sticky short-circuit
+        # would admit this tree while the unit assertions above still passed.
+        parent = tmp_path / "parent"
+        leaf = parent / "bin"
+        leaf.mkdir(parents=True)
+        own = os.geteuid()
+        monkeypatch.setattr(
+            tc.os, "stat", _stat_chain(
+                own, {str(parent): (own + 4242, 0, mode), str(leaf): (0, 0, 0o755)},
+            ),
+        )
+        assert tc._is_trusted_dir(str(leaf)) is False
+
     def test_ownership_on_a_host_without_uids_keeps_the_administrator_branch(self):
         # `own_uid=None` is Windows, where every st_uid reads 0.
         assert tc._trusted_owner(_fake_st(0, 0, 0o40755), None) is True
