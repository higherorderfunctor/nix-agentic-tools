+@pytest.mark.parametrize("directory", [
+    "/nix/store/hash-bash/bin",
+    "/run/current-system/sw/bin",
+    "/etc/profiles/per-user/alice/bin",
+    "/home/alice/.nix-profile/bin",
+    "/nix/var/nix/profiles/default/bin",
+])
+def test_trusted_system_bin_pins_nix_profile_targets(directory, monkeypatch):
+    from kiro_crew import platform_compat as pc
+
+    monkeypatch.setattr(pc, "IS_WINDOWS", False)
+    monkeypatch.setattr(pc, "_TRUSTED_SYSTEM_BIN_DIRS", ())
+    monkeypatch.setenv("HOME", "/home/alice")
+    monkeypatch.setenv("PATH", directory)
+    target = "/nix/store/hash-bash/bin/bash"
+    monkeypatch.setattr(pc.os.path, "realpath", lambda path: target)
+    monkeypatch.setattr(pc.os.path, "isfile", lambda path: path == target)
+    monkeypatch.setattr(pc.os, "access", lambda path, mode: path == target)
+    assert pc.trusted_system_bin("bash") == target
+
+
+@pytest.mark.parametrize("directory,target", [
+    ("/tmp/bin", "/nix/store/hash-bash/bin/bash"),
+    ("/nix/store-lookalike/bin", "/nix/store/hash-bash/bin/bash"),
+    ("/nix/store/../../tmp/bin", "/nix/store/hash-bash/bin/bash"),
+    ("/home/alice/.nix-profile/bin", "/tmp/planted-bash"),
+])
+def test_trusted_system_bin_refuses_nix_lookalikes(directory, target, monkeypatch):
+    from kiro_crew import platform_compat as pc
+
+    monkeypatch.setattr(pc, "IS_WINDOWS", False)
+    monkeypatch.setattr(pc, "_TRUSTED_SYSTEM_BIN_DIRS", ())
+    monkeypatch.setattr(pc, "_log_tool_outside_trusted_dirs", lambda *args: None)
+    monkeypatch.setenv("HOME", "/home/alice")
+    monkeypatch.setenv("PATH", directory)
+    monkeypatch.setattr(pc.os.path, "realpath", lambda path: target)
+    monkeypatch.setattr(pc.os.path, "isfile", lambda path: True)
+    monkeypatch.setattr(pc.os, "access", lambda path, mode: True)
+    assert pc.trusted_system_bin("bash") is None
+
+
