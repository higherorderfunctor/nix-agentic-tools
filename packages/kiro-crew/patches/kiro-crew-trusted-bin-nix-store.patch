+    if not IS_WINDOWS and name == os.path.basename(name):
+        # Nix tools need not have an FHS alias. Admit only store paths or the
+        # conventional profile namespaces, never arbitrary PATH directories.
+        # Content-addressed store objects are read-only and cannot be rewritten
+        # in place: a stronger immutability guarantee than an ordinary /usr/bin
+        # entry. Profiles themselves are mutable symlinks, so pin the resolved
+        # store object, not the alias an agent could subsequently retarget.
+        prefixes = (
+            "/nix/store/",
+            "/run/current-system/sw/",
+            "/etc/profiles/per-user/",
+            os.path.expanduser("~/.nix-profile/"),
+            "/nix/var/nix/profiles/",
+        )
+        for directory in os.environ.get("PATH", "").split(os.pathsep):
+            if not os.path.isabs(directory):
+                continue
+            candidate = os.path.normpath(os.path.join(directory, name))
+            if not candidate.startswith(prefixes):
+                continue
+            resolved = os.path.realpath(candidate)
+            if (
+                resolved.startswith("/nix/store/")
+                and os.path.isfile(resolved)
+                and os.access(resolved, os.X_OK)
+            ):
+                return resolved
     _log_tool_outside_trusted_dirs(name, directories)
