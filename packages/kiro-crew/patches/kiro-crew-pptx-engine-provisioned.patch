+def test_static_copy_makes_files_and_directories_writable(tmp_path):
+    source, target = tmp_path / "source", tmp_path / "target"
+    source.mkdir()
+    (source / "prompt").write_text("original")
+    (source / "prompt").chmod(0o444)
+    source.chmod(0o555)
+    try:
+        provision._copy_tree(source, target)
+        assert target.stat().st_mode & 0o700 == 0o700
+        assert (target / "prompt").stat().st_mode & 0o600 == 0o600
+        (target / "prompt").write_text("editable")
+        assert (source / "prompt").read_text() == "original"
+    finally:
+        source.chmod(0o755)
+        (source / "prompt").chmod(0o644)
