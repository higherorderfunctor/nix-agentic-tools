+def test_provisioned_engine_uses_isolated_interpreter(provisioned_tree, monkeypatch):
+    calls = []
+    def run(argv, **kwargs):
+        calls.append(argv)
+        return 0, ""
+    monkeypatch.setattr(provision, "_run", run)
+    assert provision._validate_provisioned_engine(provisioned_tree, [])
+    assert calls[0][:3] == [str(provision.paths.venv_python(provisioned_tree)), "-I", "-c"]
