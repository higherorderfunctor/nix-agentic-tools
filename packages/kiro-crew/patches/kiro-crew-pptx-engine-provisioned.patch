+])
+def test_provisioned_engine_rejects_incomplete_tree(provisioned_tree, missing, monkeypatch):
+    (provisioned_tree / missing).unlink()
+    def unexpected(*args, **kwargs):
+        pytest.fail("incomplete engine must fail before executing Python")
+    monkeypatch.setattr(provision, "_run", unexpected)
+    assert not provision._validate_provisioned_engine(provisioned_tree, [])
+
