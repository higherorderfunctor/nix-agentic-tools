+def _validate_provisioned_engine(engine_root: Path, log: list[str]) -> bool:
+    """Check the pin, entry points and runnable dependencies before skipping uv.
+
+    The marker retains the normal install's pin contract; the external builder
+    is responsible for verifying the archive before writing it. A marker and a
+    Python executable alone do not demonstrate that the venv is populated.
+    """
+    required = (
+        "mcp-local/pyproject.toml",
+        "mcp-local/server_acp.py",
+        "skill/pyproject.toml",
+        "skill/sdpm/api.py",
+    )
+    if not engine_source.is_installed(engine_root) or not all(
+        (engine_root / name).is_file() for name in required
+    ):
+        log.append("the provisioned engine is incomplete or does not match the pinned source")
+        return False
+    if not _venv_ready(engine_root):
+        log.append("the provisioned engine has no venv interpreter")
+        return False
+    # Isolated mode excludes the gateway's PYTHONPATH and user site-packages:
+    # those must not make an otherwise empty environment look usable.
+    code, out = _run(
+        [
+            str(paths.venv_python(engine_root)), "-I", "-c",
+            "import mcp; import sdpm.api; import sdpm.config; import pptx; import pypdfium2",
+        ],
+        cwd=str(engine_root),
+        timeout=30,
+    )
+    if code != 0:
+        log.append(f"the provisioned engine failed its dependency check: {out}")
+        return False
+    log.append("using the validated provisioned engine; dependency installation skipped")
+    return True
+
