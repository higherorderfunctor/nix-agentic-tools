+@_POSIX_MODES
+def test_writable_tree_preserves_exec_and_never_chmods_links(tmp_path):
+    from kiro_crew.platform_compat import ensure_owner_writable_tree
+
+    root = tmp_path / "copy"
+    root.mkdir()
+    plain, executable, outside = root / "plain", root / "exec", tmp_path / "outside"
+    for file, mode in ((plain, 0o444), (executable, 0o555), (outside, 0o444)):
+        file.write_text("data")
+        file.chmod(mode)
+    (root / "link").symlink_to(outside)
+    (root / "dir-link").symlink_to(tmp_path, target_is_directory=True)
+    root.chmod(0o555)
+    try:
+        ensure_owner_writable_tree(root)
+        assert stat.S_IMODE(plain.stat().st_mode) == 0o644
+        assert stat.S_IMODE(executable.stat().st_mode) == 0o755
+        assert stat.S_IMODE(outside.stat().st_mode) == 0o444
+        plain.write_text("edited")
+    finally:
+        root.chmod(0o755)
+        outside.chmod(0o644)
+
+
