+def ensure_owner_writable_tree(root: str | os.PathLike) -> None:
+    """Make a private working copy writable without changing source permissions.
+
+    Use only after copying into a destination the caller owns, never on an
+    archive whose modes are part of its fidelity contract. Preserve executable
+    and group/other bits. Links and Windows junctions must not carry the repair
+    outside the copy; copytree(symlinks=True) intentionally preserves them.
+    """
+    if is_link_or_junction(root):
+        return
+    ensure_owner_rwx_dirs(root)
+    for directory, dirs, files in os.walk(root):
+        dirs[:] = [
+            name for name in dirs
+            if not is_link_or_junction(os.path.join(directory, name))
+        ]
+        for name in files:
+            entry = os.path.join(directory, name)
+            if is_link_or_junction(entry):
+                continue
+            mode = os.lstat(entry).st_mode
+            if stat.S_ISREG(mode):
+                # Owner read as well as write: a hardened source may be read
+                # through its group permissions, which need not survive install.
+                os.chmod(entry, stat.S_IMODE(mode) | stat.S_IRUSR | stat.S_IWUSR)
+
+
