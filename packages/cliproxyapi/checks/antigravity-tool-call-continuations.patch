Update the Issue 6825 executor tests to upstream's split tool-call stream.

Upstream 4df055de9504 (fix(openai): preserve antigravity tool call
continuations) makes the Antigravity-to-OpenAI stream translator send a
tool call's arguments as an open fragment and close it with "}" at the
same index on the terminal chunk. That commit updated only the
translator's own test. antigravity_issue6825_test.go in CPA 8.1.2 still
expects one complete delta per call, so it fails.

This check-only patch keeps the tests and moves them to the new
contract: the stream test expects indices [0 1 2 0 1 2] with the
fragments and closing braces, and the stream reader appends a delta at
a known index to that call's arguments. Drop it once an upstream
release updates this test file.

--- a/internal/runtime/executor/antigravity_issue6825_test.go
+++ b/internal/runtime/executor/antigravity_issue6825_test.go
@@ -42,10 +42,12 @@
 			}
 		}
 	}
-	if want := []int64{0, 1, 2}; !reflect.DeepEqual(indices, want) {
+	// Each call opens at its own index; the terminal chunk then closes every
+	// open argument object at that same index.
+	if want := []int64{0, 1, 2, 0, 1, 2}; !reflect.DeepEqual(indices, want) {
 		t.Errorf("stream tool indices = %v, want %v; clients must not merge distinct calls", indices, want)
 	}
-	if want := []string{`{"tz":"UTC"}`, `{"tz":"America/Santiago"}`, `{"tz":"Asia/Tokyo"}`}; !reflect.DeepEqual(arguments, want) {
+	if want := []string{`{"tz":"UTC"`, `{"tz":"America/Santiago"`, `{"tz":"Asia/Tokyo"`, `}`, `}`, `}`}; !reflect.DeepEqual(arguments, want) {
 		t.Errorf("tool arguments = %v, want %v", arguments, want)
 	}
 }
@@ -141,6 +143,11 @@
 			reasoning += delta.Get("reasoning_content").String()
 			for _, call := range delta.Get("tool_calls").Array() {
 				index := int(call.Get("index").Int())
+				// A delta at a known index continues that call's arguments.
+				if index < len(calls) {
+					calls[index]["function"].(map[string]string)["arguments"] += call.Get("function.arguments").String()
+					continue
+				}
 				if index != len(calls) {
 					c.t.Fatalf("unexpected new tool index %d, want %d", index, len(calls))
 				}
