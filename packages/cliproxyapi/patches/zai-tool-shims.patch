new file mode 100644
index 00000000..4e71c0be
--- /dev/null
+++ b/internal/watcher/synthesizer/claude_tool_aliases_test.go
@@ -0,0 +1,22 @@
+package synthesizer
+
+import (
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"testing"
+)
+
+func TestSynthesizeClaudeToolAliases(t *testing.T) {
+	ctx := &SynthesisContext{Config: &config.Config{ClaudeKey: []config.ClaudeKey{{APIKey: "dummy-a", ToolAliases: map[string]string{"ToolSearch": "ToolSearch_"}}, {APIKey: "dummy-b"}}}, IDGenerator: NewStableIDGenerator()}
+	auths, err := NewConfigSynthesizer().Synthesize(ctx)
+	if err != nil || len(auths) != 2 {
+		t.Fatalf("auths=%v err=%v", auths, err)
+	}
+	var aliases map[string]string
+	if err := json.Unmarshal([]byte(auths[0].Attributes["tool_aliases"]), &aliases); err != nil || aliases["ToolSearch"] != "ToolSearch_" {
+		t.Fatalf("attribute=%v err=%v", aliases, err)
+	}
+	if _, exists := auths[1].Attributes["tool_aliases"]; exists {
+		t.Fatal("leaked aliases to other credential")
+	}
+}
