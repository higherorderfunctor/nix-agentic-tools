@@ -0,0 +1,124 @@
+package responses
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+func TestCodexShellArgCleanup(t *testing.T) {
+	for _, tc := range []struct {
+		name, tool, args, want string
+		enabled                bool
+	}{
+		{"absent permissions", "exec_command", `{"cmd":"pwd","justification":"inspect","prefix_rule":[]}`, `{"cmd":"pwd"}`, true},
+		{"shell command", "shell_command", `{"command":"pwd","justification":"inspect"}`, `{"command":"pwd"}`, true},
+		{"empty justification", "exec_command", `{"cmd":"pwd","sandbox_permissions":"require_escalated","justification":"","prefix_rule":[]}`, `{"cmd":"pwd","sandbox_permissions":"require_escalated"}`, true},
+		{"legitimate escalation", "exec_command", `{"cmd":"pwd","sandbox_permissions":"require_escalated","justification":"Allow inspection?","prefix_rule":["pwd"]}`, `{"cmd":"pwd","sandbox_permissions":"require_escalated","justification":"Allow inspection?","prefix_rule":["pwd"]}`, true},
+		{"explicit default permissions", "exec_command", `{"cmd":"pwd","sandbox_permissions":"use_default","justification":"inspect"}`, `{"cmd":"pwd","sandbox_permissions":"use_default","justification":"inspect"}`, true},
+		{"retain nonempty prefix", "exec_command", `{"cmd":"pwd","prefix_rule":["pwd"]}`, `{"cmd":"pwd","prefix_rule":["pwd"]}`, true},
+		{"unrelated tool", "lookup", `{"justification":"inspect","prefix_rule":[]}`, `{"justification":"inspect","prefix_rule":[]}`, true},
+		{"disabled", "exec_command", `{"cmd":"pwd","justification":"","prefix_rule":[]}`, `{"cmd":"pwd","justification":"","prefix_rule":[]}`, false},
+		{"invalid arguments", "exec_command", `{"cmd":`, `{"cmd":`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tc.enabled {
+				ctx = WithCodexShellArgCleanup(ctx)
+			}
+			request := []byte(fmt.Sprintf(`{"tools":[{"type":"function","name":%q,"parameters":{}}]}`, tc.tool))
+			assertCodexShellCleanup(t, ctx, request, tc.tool, tc.args, tc.want, false)
+		})
+	}
+}
+
+func TestCodexShellArgCleanupNamespaces(t *testing.T) {
+	args := `{"cmd":"pwd","justification":"inspect","prefix_rule":[]}`
+	for _, namespace := range []string{"functions", "mcp"} {
+		for _, custom := range []bool{false, true} {
+			kind := "function"
+			if custom {
+				kind = "custom"
+			}
+			request := []byte(fmt.Sprintf(`{"tools":[{"type":"namespace","name":%q,"tools":[{"type":%q,"name":"exec_command","parameters":{}}]}]}`, namespace, kind))
+			for _, name := range []string{namespace + "__exec_command", "exec_command"} {
+				t.Run(fmt.Sprintf("%s/%s/%s", namespace, kind, name), func(t *testing.T) {
+					want := args
+					if namespace == "functions" && !custom {
+						want = `{"cmd":"pwd"}`
+					}
+					assertCodexShellCleanup(t, WithCodexShellArgCleanup(context.Background()), request, name, args, want, custom)
+				})
+			}
+		}
+	}
+}
+
+func assertCodexShellCleanup(t *testing.T, ctx context.Context, request []byte, name, arguments, want string, custom bool) {
+	t.Helper()
+	field, deltaKind, doneKind := "arguments", "response.function_call_arguments.delta", "response.function_call_arguments.done"
+	if custom {
+		field, deltaKind, doneKind = "input", "response.custom_tool_call_input.delta", "response.custom_tool_call_input.done"
+	}
+	upstream := []byte(`{"id":"resp_test","choices":[{"index":0,"finish_reason":"tool_calls","message":{"role":"assistant","tool_calls":[]}}]}`)
+	upstream, _ = ojson.SetRawBytes(upstream, "choices.0.message.tool_calls.0", shellUpstreamCall(name, arguments))
+	out := ConvertOpenAIChatCompletionsResponseToOpenAIResponsesNonStream(ctx, "test", request, nil, upstream, nil)
+	if got := ojson.GetBytes(out, "output.0."+field).String(); got != want {
+		t.Fatalf("nonstream arguments=%s want=%s", got, want)
+	}
+	var state any
+	var delta strings.Builder
+	counts := map[string]int{}
+	push := func(chunk []byte) {
+		for _, event := range ConvertOpenAIChatCompletionsResponseToOpenAIResponses(ctx, "test", request, nil, chunk, &state) {
+			for _, line := range strings.Split(string(event), "\n") {
+				if !strings.HasPrefix(line, "data: ") {
+					continue
+				}
+				root := ojson.Parse(strings.TrimPrefix(line, "data: "))
+				kind := root.Get("type").String()
+				path := ""
+				switch kind {
+				case deltaKind:
+					delta.WriteString(root.Get("delta").String())
+				case doneKind:
+					path = field
+				case "response.output_item.done":
+					path = "item." + field
+				case "response.completed":
+					path = "response.output.0." + field
+				}
+				if path != "" {
+					counts[kind]++
+					if got := root.Get(path).String(); got != want {
+						t.Errorf("%s arguments=%s want=%s", kind, got, want)
+					}
+				}
+			}
+		}
+	}
+	for i, fragment := range []string{arguments[:len(arguments)/2], arguments[len(arguments)/2:]} {
+		chunk := []byte(`{"id":"resp_test","choices":[{"index":0,"delta":{"tool_calls":[]}}]}`)
+		call := shellUpstreamCall(name, fragment)
+		if i == 1 {
+			call, _ = ojson.DeleteBytes(call, "id")
+			call, _ = ojson.DeleteBytes(call, "function.name")
+		}
+		chunk, _ = ojson.SetRawBytes(chunk, "choices.0.delta.tool_calls.0", call)
+		push(chunk)
+	}
+	push([]byte(`{"id":"resp_test","choices":[{"index":0,"delta":{},"finish_reason":"tool_calls"}]}`))
+	push([]byte("[DONE]"))
+	for _, kind := range []string{doneKind, "response.output_item.done", "response.completed"} {
+		if counts[kind] != 1 {
+			t.Errorf("%s count=%d", kind, counts[kind])
+		}
+	}
+	// Codex ignores these deltas; terminal arguments above are authoritative.
+	if !custom && delta.String() != arguments {
+		t.Errorf("deltas=%q want original %q", delta.String(), arguments)
+	}
+}
