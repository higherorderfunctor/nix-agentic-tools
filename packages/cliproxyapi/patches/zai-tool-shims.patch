+// prepareClaudeAPIKeyToolNames uses only the selected credential's static map;
+// no OAuth thread state is read or written.
+func prepareClaudeAPIKeyToolNames(body []byte, auth *cliproxyauth.Auth) ([]byte, map[string]string, error) {
+	if auth == nil || auth.Attributes["tool_aliases"] == "" {
+		return body, nil, nil
+	}
+	var aliases map[string]string
+	if err := json.Unmarshal([]byte(auth.Attributes["tool_aliases"]), &aliases); err != nil {
+		return nil, nil, fmt.Errorf("invalid tool-aliases attribute: %w", err)
+	}
+	// Also protect SDK callers which synthesize Auth without loading a config.
+	cfg := &config.Config{ClaudeKey: []config.ClaudeKey{{ToolAliases: aliases}}}
+	if err := cfg.ValidateClaudeToolAliases(); err != nil {
+		return nil, nil, err
+	}
+	declared := make(map[string]bool)
+	ojson.GetBytes(body, "tools").ForEach(func(_, tool ojson.Result) bool { declared[tool.Get("name").String()] = true; return true })
+	for client, upstream := range aliases {
+		if client != upstream && declared[upstream] {
+			return nil, nil, statusErr{code: http.StatusBadRequest, msg: "tool-aliases upstream name collides with a declared tool"}
+		}
+	}
+	if len(aliases) == 0 {
+		return body, nil, nil
+	}
+	remapped, reverse, ok := remapOAuthToolNamesWithBatchedEdits(body, claudeMCPAliasOptions{static: aliases})
+	if !ok {
+		return nil, nil, statusErr{code: http.StatusBadRequest, msg: "invalid JSON for tool-aliases"}
+	}
+	return remapped, reverse, nil
+}
+
+// prepareClaudeAPIKeyToolNamesDoc applies the static map to the executors'
+// ojson.Doc request pipeline (Execute, ExecuteStream, CountTokens).
+func prepareClaudeAPIKeyToolNamesDoc(doc *ojson.Doc, auth *cliproxyauth.Auth) (*ojson.Doc, map[string]string, error) {
+	remapped, reverse, err := prepareClaudeAPIKeyToolNames(doc.Bytes(), auth)
+	if err != nil {
+		return nil, nil, err
+	}
+	return ojson.NewDoc(remapped), reverse, nil
+}
+
+func claudeAPIKeyToolAliasesEnabled(auth *cliproxyauth.Auth, apiKey string) bool {
+	return auth != nil && auth.Attributes["tool_aliases"] != "" && !claudeCredentialUsesOAuth(auth, apiKey)
+}
diff --git a/internal/runtime/executor/claude_executor_static_alias_test.go b/internal/runtime/executor/claude_executor_static_alias_test.go
new file mode 100644
index 00000000..5edd0f7d
--- /dev/null
+++ b/internal/runtime/executor/claude_executor_static_alias_test.go
@@ -0,0 +1,103 @@
+package executor
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"strings"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestClaudeAPIKeyToolAliases(t *testing.T) {
+	body := []byte(`{"tools":[{"name":"ToolSearch","input_schema":{"type":"object"}},{"name":"lookup","defer_loading":true}],"tool_choice":{"type":"tool","name":"ToolSearch"},"messages":[{"role":"assistant","content":[{"type":"tool_use","name":"ToolSearch","id":"t1","input":{}},{"type":"tool_reference","tool_name":"ToolSearch"}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"t1","content":[{"type":"tool_reference","tool_name":"ToolSearch"}]}]}]}`)
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"tool_aliases": `{"ToolSearch":"ToolSearch_"}`}}
+	out, reverse, err := prepareClaudeAPIKeyToolNames(body, auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"tools.0.name", "tool_choice.name", "messages.0.content.0.name", "messages.0.content.1.tool_name", "messages.1.content.0.content.0.tool_name"} {
+		if got := ojson.GetBytes(out, path).String(); got != "ToolSearch_" {
+			t.Fatalf("%s = %q", path, got)
+		}
+	}
+	if !ojson.GetBytes(out, "tools.1.defer_loading").Bool() {
+		t.Fatal("lost deferred tool")
+	}
+	response := []byte(`{"content":[{"type":"tool_use","name":"ToolSearch_","id":"t2","input":{}}]}`)
+	restored, err := restoreClaudeOAuthToolNamesFromResponse(response, reverse)
+	if err != nil || ojson.GetBytes(restored, "content.0.name").String() != "ToolSearch" {
+		t.Fatalf("response=%s, err=%v", restored, err)
+	}
+	line := []byte(`data: {"type":"content_block_start","index":0,"content_block":{"type":"tool_use","name":"ToolSearch_","id":"t2","input":{}}}`)
+	restored, err = restoreClaudeOAuthToolNamesFromStreamLine(line, reverse)
+	if err != nil || !bytes.Contains(restored, []byte(`"name":"ToolSearch"`)) {
+		t.Fatalf("stream=%s, err=%v", restored, err)
+	}
+	// History without tools[] still uses the credential map, without a session.
+	out, reverse, err = prepareClaudeAPIKeyToolNames([]byte(`{"messages":[{"content":[{"type":"tool_use","name":"ToolSearch"}]}]}`), auth)
+	if err != nil || ojson.GetBytes(out, "messages.0.content.0.name").String() != "ToolSearch_" || reverse["ToolSearch_"] != "ToolSearch" {
+		t.Fatalf("history=%s, reverse=%v, err=%v", out, reverse, err)
+	}
+	for _, absent := range []*cliproxyauth.Auth{nil, {}, {Attributes: map[string]string{"tool_aliases": "{}"}}} {
+		out, reverse, err = prepareClaudeAPIKeyToolNames(body, absent)
+		if err != nil || !bytes.Equal(out, body) || len(reverse) != 0 {
+			t.Fatalf("absent map changed body: %s %v", out, err)
+		}
+	}
+	if _, _, err = prepareClaudeAPIKeyToolNames([]byte(`{"tools":[{"name":"ToolSearch"},{"name":"ToolSearch_"}]}`), auth); err == nil {
+		t.Fatal("accepted declaration collision")
+	}
+	for _, aliases := range []map[string]string{{"A": "Z", "B": "Z"}, {"A": "B", "B": "C"}, {"A": strings.Repeat("x", 65)}} {
+		raw, _ := json.Marshal(aliases)
+		auth.Attributes["tool_aliases"] = string(raw)
+		if _, _, err = prepareClaudeAPIKeyToolNames(body, auth); err == nil {
+			t.Fatal("accepted invalid attribute")
+		}
+	}
+}
+
+func TestClaudeAPIKeyToolAliasesExecutorPaths(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		for _, profile := range []string{"", "claude-code-cli"} {
+			t.Run(fmt.Sprint(stream)+profile, func(t *testing.T) {
+				auth := &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "dummy-key", "cloak_mode": "never", "tool_aliases": `{"ToolSearch":"ToolSearch_"}`}}
+				auth.Attributes["fingerprint_profile"] = profile
+				if profile != "" {
+					auth.Attributes["cloak_mode"] = "always"
+				}
+				body := []byte(`{"thread":{"type":"create"},"model":"claude-sonnet-4-5","tools":[{"name":"ToolSearch","input_schema":{"type":"object"}}],"messages":[{"role":"user","content":"hello"}]}`)
+				ex := NewClaudeExecutor(&config.Config{})
+				up := &midSystemUpstream{}
+				req := cliproxyexecutor.Request{Model: "claude-sonnet-4-5", Payload: body}
+				opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude}
+				if stream {
+					result, err := ex.ExecuteStream(up.context(t, nil), auth, req, opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							t.Fatal(chunk.Err)
+						}
+					}
+				} else {
