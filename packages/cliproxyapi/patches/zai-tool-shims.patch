--- /dev/null
+++ b/internal/config/claude_tool_aliases.go
@@ -0,0 +1,30 @@
+package config
+
+import (
+	"fmt"
+	"regexp"
+)
+
+var claudeToolAliasName = regexp.MustCompile(`^[a-zA-Z0-9_-]{1,64}$`)
+
+// ValidateClaudeToolAliases rejects ambiguous static maps at config load.
+// Collision with an unaliased tools[] declaration is checked per request: those
+// declarations are supplied by the caller and do not exist in configuration.
+func (cfg *Config) ValidateClaudeToolAliases() error {
+	for i, key := range cfg.ClaudeKey {
+		targets := make(map[string]bool)
+		for client, upstream := range key.ToolAliases {
+			if !claudeToolAliasName.MatchString(client) || !claudeToolAliasName.MatchString(upstream) {
+				return fmt.Errorf("claude[%d].tool-aliases: names must contain 1-64 letters, digits, underscores or hyphens", i)
+			}
+			if targets[upstream] {
+				return fmt.Errorf("claude[%d].tool-aliases: duplicate upstream name", i)
+			}
+			if _, exists := key.ToolAliases[upstream]; exists && client != upstream {
+				return fmt.Errorf("claude[%d].tool-aliases: upstream name is another client name", i)
+			}
+			targets[upstream] = true
+		}
+	}
+	return nil
+}
diff --git a/internal/config/claude_tool_aliases_test.go b/internal/config/claude_tool_aliases_test.go
