+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+func TestOpenAICompatCodexShellArgCleanupSelectedGroup(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		for index := range 2 {
+			t.Run(fmt.Sprintf("stream=%t/index=%d", stream, index), func(t *testing.T) {
+				args := `{"cmd":"pwd","justification":"inspect","prefix_rule":[]}`
+				call := []byte(`{"index":0,"id":"call_1","type":"function","function":{"name":"exec_command"}}`)
+				call, _ = ojson.SetBytes(call, "function.arguments", args)
+				transport := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+					if req.URL.Path != "/v1/chat/completions" {
+						t.Errorf("path=%s", req.URL.Path)
+					}
+					body, _ := io.ReadAll(req.Body)
+					isStream := ojson.GetBytes(body, "stream").Bool()
+					response := []byte(`{"id":"resp_test","choices":[{"index":0,"message":{"role":"assistant","tool_calls":[]},"finish_reason":"tool_calls"}]}`)
+					response, _ = ojson.SetRawBytes(response, "choices.0.message.tool_calls.0", call)
+					contentType := "application/json"
+					if isStream {
+						response = []byte(`{"id":"resp_test","choices":[{"index":0,"delta":{"tool_calls":[]}}]}`)
+						response, _ = ojson.SetRawBytes(response, "choices.0.delta.tool_calls.0", call)
+						response = append([]byte("data: "), response...)
+						response = append(response, []byte("\n\ndata: {\"id\":\"resp_test\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n")...)
+						contentType = "text/event-stream"
+					}
+					return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{contentType}}, Body: io.NopCloser(strings.NewReader(string(response))), Request: req}, nil
+				})
+				cfg := &config.Config{OpenAICompatibility: []config.OpenAICompatibility{{Name: "duplicate", CodexShellArgCleanup: true}, {Name: "duplicate"}}}
+				ex := NewOpenAICompatExecutor("openai-compatibility", cfg)
+				auth := &cliproxyauth.Auth{Provider: "openai-compatibility", Attributes: map[string]string{"source": "config:duplicate[0]", "config_index": fmt.Sprint(index), "compat_name": "duplicate", "base_url": "https://upstream.example/v1", "api_key": "dummy"}}
+				req := cliproxyexecutor.Request{Model: "test", Payload: []byte(`{"model":"test","input":"inspect","tools":[{"type":"function","name":"exec_command","parameters":{"type":"object","properties":{"cmd":{"type":"string"}}}}]}`)}
+				opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse}
+				ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(transport))
+				var got string
+				if stream {
+					result, err := ex.ExecuteStream(ctx, auth, req, opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							t.Fatal(chunk.Err)
+						}
+						for _, line := range strings.Split(string(chunk.Payload), "\n") {
+							if strings.HasPrefix(line, "data: ") {
+								event := ojson.Parse(strings.TrimPrefix(line, "data: "))
+								if event.Get("type").String() == "response.output_item.done" {
+									got = event.Get("item.arguments").String()
+								}
+							}
+						}
+					}
+				} else {
+					response, err := ex.Execute(ctx, auth, req, opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					got = ojson.GetBytes(response.Payload, "output.0.arguments").String()
+				}
+				want := args
+				if index == 0 {
+					want = `{"cmd":"pwd"}`
+				}
+				if got != want {
+					t.Fatalf("arguments=%s want=%s", got, want)
+				}
+			})
+		}
+	}
+}
diff --git a/internal/translator/openai/openai/responses/codex_shell_args.go b/internal/translator/openai/openai/responses/codex_shell_args.go
new file mode 100644
index 00000000..884b10f4
--- /dev/null
+++ b/internal/translator/openai/openai/responses/codex_shell_args.go
@@ -0,0 +1,44 @@
+package responses
+
+import (
+	"context"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+type codexShellArgCleanupKey struct{}
+
+// WithCodexShellArgCleanup opts one selected upstream credential into terminal
+// argument cleanup. Function-call deltas remain unchanged: Codex ignores them
+// and dispatches the complete response.output_item.done item.
+func WithCodexShellArgCleanup(ctx context.Context) context.Context {
+	return context.WithValue(ctx, codexShellArgCleanupKey{}, true)
+}
+
+func (idx *responsesToolIndex) cleanupCodexShellArguments(enabled bool, name, arguments string) string {
+	if !enabled {
+		return arguments
+	}
+	name = idx.canonicalName(name)
+	if declaration, exists := idx.byChat[name]; exists {
+		if declaration.namespace != "" && declaration.namespace != "functions" {
+			return arguments
+		}
+		name = declaration.localName
+	}
+	if name != "exec_command" && name != "shell_command" {
+		return arguments
+	}
+	root := ojson.Parse(arguments)
+	if !ojson.Valid(arguments) || !root.IsObject() {
+		return arguments
+	}
+	justification := root.Get("justification")
+	if !root.Get("sandbox_permissions").Exists() || (justification.Type == ojson.String && justification.String() == "") {
+		arguments, _ = ojson.Delete(arguments, "justification")
+	}
+	if prefix := root.Get("prefix_rule"); prefix.IsArray() && len(prefix.Array()) == 0 {
+		arguments, _ = ojson.Delete(arguments, "prefix_rule")
+	}
+	return arguments
+}
