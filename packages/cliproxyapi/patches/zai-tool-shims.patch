@@ -0,0 +1,55 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestClaudeToolAliasesLoad(t *testing.T) {
+	for _, tc := range []struct {
+		name, aliases string
+		valid         bool
+	}{
+		{"valid", "{ToolSearch: ToolSearch_}", true},
+		{"absent", "{}", true},
+		{"duplicate", "{A: Z, B: Z}", false},
+		{"chain", "{A: B, B: C}", false},
+		{"long", fmt.Sprintf("{A: %s}", strings.Repeat("x", 65)), false},
+		{"unsafe", `{A: 'bad"name'}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			data := []byte("config-version: 8\napi-keys:\n  claude:\n    - tool-aliases: " + tc.aliases + "\n      keys:\n        - api-key: dummy-a\n        - api-key: dummy-b\n")
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			if err := os.WriteFile(path, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for _, load := range []func() (*Config, error){func() (*Config, error) { return ParseConfigBytes(data) }, func() (*Config, error) { return LoadConfigOptional(path, true) }} {
+				cfg, err := load()
+				if (err == nil) != tc.valid {
+					t.Fatalf("valid=%v, err=%v", tc.valid, err)
+				}
+				if tc.name == "valid" {
+					if len(cfg.ClaudeKey) != 2 || cfg.ClaudeKey[0].ToolAliases["ToolSearch"] != "ToolSearch_" || cfg.ClaudeKey[1].ToolAliases["ToolSearch"] != "ToolSearch_" {
+						t.Fatalf("group not inherited: %+v", cfg.ClaudeKey)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestClaudeToolAliasesProviderScope(t *testing.T) {
+	_, err := ParseConfigBytes([]byte(`config-version: 8
+api-keys:
+  gemini:
+    - tool-aliases: {ToolSearch: ToolSearch_}
+      keys:
+        - api-key: dummy
+`))
+	if err == nil {
+		t.Fatal("accepted Claude tool-aliases on a Gemini group")
+	}
+}
