diff --git a/sdk/cliproxy/auth/key_allowlist.go b/sdk/cliproxy/auth/key_allowlist.go
new file mode 100644
index 0000000..9387f80
--- /dev/null
+++ b/sdk/cliproxy/auth/key_allowlist.go
@@ -0,0 +1,131 @@
+package auth
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"sync/atomic"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	log "github.com/sirupsen/logrus"
+)
+
+// clientKeyAllowlist is access.key-allowlist compiled from one config
+// snapshot: the credential rules of each client key.
+type clientKeyAllowlist map[string][]internalconfig.KeyAllowlistCredential
+
+// keyAllowlistPointer holds a Manager's compiled allowlist; nil while unconfigured.
+type keyAllowlistPointer = atomic.Pointer[clientKeyAllowlist]
+
+// compileClientKeyAllowlist compiles cfg's allowlist. Loading refuses entries
+// that share a client key; a Config built in code skips that check, so here
+// they compile to an allowlist granting nothing rather than to a union of rules.
+func compileClientKeyAllowlist(cfg *internalconfig.Config) *clientKeyAllowlist {
+	if cfg == nil || len(cfg.KeyAllowlist) == 0 {
+		return nil
+	}
+	compiled := make(clientKeyAllowlist, len(cfg.KeyAllowlist))
+	if errValidate := internalconfig.ValidateKeyAllowlist(cfg.KeyAllowlist); errValidate != nil {
+		log.Errorf("%v; every client key selects no credential until this is fixed", errValidate)
+		return &compiled
+	}
+	for _, entry := range cfg.KeyAllowlist {
+		// An unauthenticated request has no client key; never grant it rules.
+		if key := entry.ClientKey(); key != "" {
+			compiled[key] = entry.Credentials
+		}
+	}
+	return &compiled
+}
+
+// loadKeyAllowlist returns the configured allowlist, if any, and the client key
+// the access middleware authenticated, so query-parameter keys count as
+// header keys do.
+func loadKeyAllowlist(ctx context.Context, pointer *keyAllowlistPointer) (*clientKeyAllowlist, string) {
+	if pointer == nil {
+		return nil, ""
+	}
+	allowlist := pointer.Load()
+	if allowlist == nil {
+		return nil, ""
+	}
+	return allowlist, coreusage.APIKeyFromContext(ctx)
+}
+
+// allows reports whether any of clientKey's rules allows auth. A key without
+// an entry, including an unauthenticated request, has no rules. Each rule
+// needs a provider and a valid kind, so a provider alone never admits both
+// OAuth and API-key credentials.
+func (a clientKeyAllowlist) allows(clientKey string, auth *Auth) bool {
+	for _, rule := range a[clientKey] {
+		kind := normalizeAuthKind(rule.Kind)
+		if kind != "" && kind == allowlistKind(auth) &&
+			strings.EqualFold(strings.TrimSpace(rule.Provider), strings.TrimSpace(auth.Provider)) &&
+			(len(rule.Accounts) == 0 || (kind == AuthKindOAuth && accountListed(rule.Accounts, auth))) &&
+			(len(rule.IDs) == 0 || slices.Contains(rule.IDs, auth.ID)) &&
+			(len(rule.BaseURLs) == 0 || (kind == AuthKindAPIKey && baseURLListed(rule.BaseURLs, auth))) {
+			return true
+		}
+	}
+	return false
+}
+
+// allowlistKind is the kind a rule may match: auth's AuthKind, except that only
+// a credential synthesized from config counts as an API key, the test
+// IsConfigAPIKeyAuth applies. A store- or file-sourced credential that
+// classifies as apikey, through an auth_kind field in its file or a runtime
+// api_key attribute such as a Meta refresh sets before the watcher's
+// auth_kind=oauth attribute replaces it, has no kind and matches no rule.
+func allowlistKind(auth *Auth) string {
+	if kind := auth.AuthKind(); kind != AuthKindAPIKey || IsConfigAPIKeyAuth(auth) {
+		return kind
+	}
+	return ""
+}
+
+// baseURLListed reports whether auth's base_url attribute, which the config
+// synthesizer stores trimmed (internal/watcher/synthesizer/config.go), is one
+// of baseURLs. Two API-key blocks of one provider share a kind and differ only
+// in it. A credential without a base_url matches no list.
+func baseURLListed(baseURLs []string, auth *Auth) bool {
+	base := strings.TrimSpace(auth.Attributes["base_url"])
+	return base != "" && slices.ContainsFunc(baseURLs, func(listed string) bool { return strings.TrimSpace(listed) == base })
+}
+
+// accountListed compares native OAuth account identity, never a login filename.
+func accountListed(accounts []string, auth *Auth) bool {
+	_, email := auth.AccountInfo()
+	return email != "" && slices.ContainsFunc(accounts, func(account string) bool { return strings.TrimSpace(account) == email })
+}
+
+// ModelListingFilter captures selection's eligibility rules for a catalog request.
+// A nil filter preserves native listings when no allowlist is configured. Model
+// IDs are public route IDs, including aliases, just as in credential selection.
+func (m *Manager) ModelListingFilter(ctx context.Context) func(string) bool {
+	if m == nil {
+		return nil
+	}
+	eligibility := authSelectionEligibilityForRequest(ctx, cliproxyexecutor.Options{}, &m.keyAllowlist)
+	if eligibility.keyAllowlist == nil {
+		return nil
+	}
+	return func(model string) bool {
+		if strings.TrimSpace(model) == "" {
+			return false
+		}
+		m.mu.RLock()
+		defer m.mu.RUnlock()
+		for _, auth := range m.auths {
+			if auth == nil || auth.Disabled || auth.Status == StatusDisabled || !eligibility.allows(auth) {
+				continue
+			}
+			if m.authSupportsRouteModel(registry.GetGlobalRegistry(), auth, model) {
+				return true
+			}
+		}
+		return false
+	}
+}
diff --git a/sdk/cliproxy/auth/key_allowlist_test.go b/sdk/cliproxy/auth/key_allowlist_test.go
new file mode 100644
index 0000000..233e2b1
--- /dev/null
+++ b/sdk/cliproxy/auth/key_allowlist_test.go
@@ -0,0 +1,397 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+)
+
+// keyAllowlistExecutor records the credential of every attempt and fails each
+// one when fail is set, so a retry would reach every credential it can.
+type keyAllowlistExecutor struct {
+	provider string
+	fail     bool
+	mu       sync.Mutex
+	used     []string
+}
+
+func (e *keyAllowlistExecutor) Identifier() string { return e.provider }
+
+func (e *keyAllowlistExecutor) Execute(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.mu.Lock()
+	e.used = append(e.used, auth.ID)
+	e.mu.Unlock()
+	if e.fail {
+		return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusInternalServerError, Message: "key allowlist test failure"}
+	}
+	return cliproxyexecutor.Response{Payload: []byte(auth.ID)}, nil
+}
+
+func (e *keyAllowlistExecutor) ExecuteStream(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	return nil, errors.New("not used")
+}
+
+func (*keyAllowlistExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) { return auth, nil }
+
+func (e *keyAllowlistExecutor) CountTokens(ctx context.Context, auth *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(ctx, auth, req, opts)
+}
+
+func (*keyAllowlistExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func (e *keyAllowlistExecutor) attempts() []string {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return append([]string(nil), e.used...)
+}
+
+const keyAllowlistModel = "key-allowlist-model"
+
+// A Claude OAuth login, two Claude API keys and a Codex API key, all serving
+// one model, so only the allowlist separates them. The API keys carry the
+// config source the config synthesizer sets, which an apikey rule requires. The
+// second Claude API key
+// is a selectable credential of the same provider and kind that a rule naming
+// the first by ID must not reach.
+var keyAllowlistAuths = []*Auth{
+	{ID: "claude-oauth", Provider: "claude", Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth}},
+	{ID: "claude-apikey", Provider: "claude", Attributes: map[string]string{AttributeAPIKey: "upstream-claude", AttributeSource: "config:claude[1]"}},
+	{ID: "claude-apikey-2", Provider: "claude", Attributes: map[string]string{AttributeAPIKey: "upstream-claude-2", AttributeSource: "config:claude[2]"}},
+	{ID: "codex-apikey", Provider: "codex", Attributes: map[string]string{AttributeAPIKey: "upstream-codex", AttributeSource: "config:codex[1]"}},
+}
+
+var keyAllowlistConfig = []internalconfig.KeyAllowlist{
+	{APIKey: "claude-oauth-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+	{APIKey: "claude-apikey-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "apikey"}}},
+	{APIKey: "codex-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "codex", Kind: "apikey"}}},
+	{APIKey: "id-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "apikey", IDs: []string{"claude-apikey"}}}},
+	{APIKey: "kindless-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude"}}},
+}
+
+// A selector CPA does not build in, so selection takes the legacy candidate loop.
+type keyAllowlistLegacySelector struct{ *RoundRobinSelector }
+
+// Selectors that take the legacy candidate loop and the scheduler fast path.
+var keyAllowlistSelectors = map[string]func() Selector{
+	"legacy":    func() Selector { return keyAllowlistLegacySelector{&RoundRobinSelector{}} },
+	"scheduler": func() Selector { return &RoundRobinSelector{} },
+}
+
+// Mixed selections per case: enough for a rotation to reach every credential
+// a key may use.
+const keyAllowlistRounds = 12
+
+func newKeyAllowlistManager(t *testing.T, selector Selector, cfg *internalconfig.Config, fail bool) (*Manager, map[string]*keyAllowlistExecutor) {
+	t.Helper()
+	manager := NewManager(nil, selector, nil)
+	manager.SetConfig(cfg)
+	manager.SetRetryConfig(3, 0, 0)
+	executors := map[string]*keyAllowlistExecutor{}
+	reg := registry.GetGlobalRegistry()
+	for _, auth := range keyAllowlistAuths {
+		if executors[auth.Provider] == nil {
+			executors[auth.Provider] = &keyAllowlistExecutor{provider: auth.Provider, fail: fail}
+			manager.RegisterExecutor(executors[auth.Provider])
+		}
+		reg.RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: keyAllowlistModel}})
+		id := auth.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		registered := auth.Clone()
+		registered.Metadata = map[string]any{"disable_cooling": true}
+		if _, errRegister := manager.Register(context.Background(), registered); errRegister != nil {
+			t.Fatalf("register %s: %v", auth.ID, errRegister)
+		}
+	}
+	return manager, executors
+}
+
+func keyAllowlistAttempts(executors map[string]*keyAllowlistExecutor) map[string]bool {
+	used := map[string]bool{}
+	for _, executor := range executors {
+		for _, id := range executor.attempts() {
+			used[id] = true
+		}
+	}
+	return used
+}
+
+func TestKeyAllowlistSelectsOnlyAllowedCredentials(t *testing.T) {
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: keyAllowlistConfig}}
+	cases := []struct {
+		name    string
+		key     string
+		allowed map[string]bool
+	}{
+		{name: "claude oauth only", key: "claude-oauth-key", allowed: map[string]bool{"claude-oauth": true}},
+		{name: "claude api keys only", key: "claude-apikey-key", allowed: map[string]bool{"claude-apikey": true, "claude-apikey-2": true}},
+		{name: "codex only", key: "codex-key", allowed: map[string]bool{"codex-apikey": true}},
+		{name: "credential id", key: "id-key", allowed: map[string]bool{"claude-apikey": true}},
+		{name: "rule without kind", key: "kindless-key", allowed: map[string]bool{}},
+		{name: "key without entry", key: "unlisted-key", allowed: map[string]bool{}},
+		{name: "no client key", key: "", allowed: map[string]bool{}},
+	}
+	for selectorName, selector := range keyAllowlistSelectors {
+		for _, test := range cases {
+			t.Run(selectorName+"/"+test.name, func(t *testing.T) {
+				manager, executors := newKeyAllowlistManager(t, selector(), cfg, false)
+				ctx := coreusage.WithAPIKey(context.Background(), test.key)
+				// Mixed selection over every provider, repeated so a rotation
+				// reaches every credential the key may use: each allowed one is
+				// used and no other is.
+				for range keyAllowlistRounds {
+					_, errExecute := manager.Execute(ctx, []string{"claude", "codex"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{})
+					if (errExecute == nil) != (len(test.allowed) > 0) {
+						t.Fatalf("execute error = %v, allowed %v", errExecute, test.allowed)
+					}
+				}
+				used := keyAllowlistAttempts(executors)
+				for id := range used {
+					if !test.allowed[id] {
+						t.Fatalf("key %q used credential %s", test.key, id)
+					}
+				}
+				for id := range test.allowed {
+					if !used[id] {
+						t.Fatalf("key %q never used its allowed credential %s", test.key, id)
+					}
+				}
+
+			})
+		}
+	}
+}
+
+func TestKeyAllowlistRetryStaysInsideTheAllowlist(t *testing.T) {
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: keyAllowlistConfig}}
+	for selectorName, selector := range keyAllowlistSelectors {
+		t.Run(selectorName, func(t *testing.T) {
+			manager, executors := newKeyAllowlistManager(t, selector(), cfg, true)
+			ctx := coreusage.WithAPIKey(context.Background(), "claude-oauth-key")
+			if _, errExecute := manager.Execute(ctx, []string{"claude", "codex"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{}); errExecute == nil {
+				t.Fatal("execute succeeded against a failing upstream")
+			}
+			used := keyAllowlistAttempts(executors)
+			if !used["claude-oauth"] || len(used) != 1 {
+				t.Fatalf("retries used %v, want only claude-oauth", used)
+			}
+		})
+	}
+}
+
+func TestKeyAllowlistUnconfiguredRestrictsNothing(t *testing.T) {
+	manager, executors := newKeyAllowlistManager(t, &RoundRobinSelector{}, &internalconfig.Config{}, false)
+	for range keyAllowlistRounds {
+		if _, errExecute := manager.Execute(context.Background(), []string{"claude", "codex"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{}); errExecute != nil {
+			t.Fatalf("execute: %v", errExecute)
+		}
+	}
+	if used := keyAllowlistAttempts(executors); len(used) != len(keyAllowlistAuths) {
+		t.Fatalf("unconfigured rotation used %v, want every credential", used)
+	}
+}
+
+func TestKeyAllowlistRefusesHomeDispatch(t *testing.T) {
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: keyAllowlistConfig}}
+	cfg.Home.Enabled = true
+	manager, executors := newKeyAllowlistManager(t, &RoundRobinSelector{}, cfg, false)
+	ctx := coreusage.WithAPIKey(context.Background(), "claude-oauth-key")
+	_, errExecute := manager.Execute(ctx, []string{"claude"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{})
+	_, errSelect := manager.SelectHomeAuthByKind(ctx, "claude", keyAllowlistModel, AuthKindOAuth, cliproxyexecutor.Options{})
+	for _, err := range []error{errExecute, errSelect} {
+		// The refusal, not the missing Home bundle this test never publishes.
+		var authErr *Error
+		if !errors.As(err, &authErr) || authErr.Code != "home_unavailable" || !strings.Contains(authErr.Message, "access.key-allowlist") {
+			t.Fatalf("error = %v, want the access.key-allowlist Home refusal", err)
+		}
+	}
+	if used := keyAllowlistAttempts(executors); len(used) != 0 {
+		t.Fatalf("Home mode used %v", used)
+	}
+}
+
+// The Antigravity credits fallback runs after selection failed, which is what
+// the allowlist does to a key that may not use the credential, and it picks
+// from the full pool outside authSelectionEligibility. The positive control
+// calls the fallback directly for a key with an antigravity rule, since an
+// allowed Execute can succeed without reaching it.
+func TestKeyAllowlistConfinesAntigravityCreditsFallback(t *testing.T) {
+	allowlist := append([]internalconfig.KeyAllowlist{
+		{APIKey: "antigravity-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "antigravity", Kind: "oauth"}}},
+	}, keyAllowlistConfig...)
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: allowlist}}
+	cfg.QuotaExceeded.AntigravityCredits = true
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.SetConfig(cfg)
+	executor := &keyAllowlistExecutor{provider: "antigravity"}
+	manager.RegisterExecutor(executor)
+	const model = "claude-key-allowlist-credits"
+	auth := &Auth{ID: "antigravity-oauth", Provider: "antigravity", Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth}, Metadata: map[string]any{"disable_cooling": true}}
+	registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: model}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+	if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+		t.Fatalf("register: %v", errRegister)
+	}
+	ctx := coreusage.WithAPIKey(context.Background(), "codex-key")
+	if _, errExecute := manager.Execute(ctx, []string{"antigravity"}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{}); errExecute == nil {
+		t.Fatal("execute succeeded for a key without an antigravity rule")
+	}
+	if attempts := executor.attempts(); len(attempts) != 0 {
+		t.Fatalf("credits fallback used %v for a key without an antigravity rule", attempts)
+	}
+	allowedCtx := coreusage.WithAPIKey(context.Background(), "antigravity-key")
+	resp, ok, errCredits := manager.tryAntigravityCreditsExecute(allowedCtx, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{})
+	if errCredits != nil || !ok || string(resp.Payload) != auth.ID {
+		t.Fatalf("credits fallback for an allowed key = (%q, %v, %v), want (%q, true, nil)", resp.Payload, ok, errCredits, auth.ID)
+	}
+	if attempts := executor.attempts(); len(attempts) != 1 || attempts[0] != auth.ID {
+		t.Fatalf("credits fallback attempts = %v, want [%s]", attempts, auth.ID)
+	}
+}
+
+// Direct Config callers skip loading. Duplicate keys must deny every client;
+// distinct keys still select their own credentials.
+func TestKeyAllowlistDuplicateKeysSelectNothing(t *testing.T) {
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: []internalconfig.KeyAllowlist{
+		{APIKey: "dup-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+		{APIKey: " dup-key ", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "codex", Kind: "apikey"}}},
+		{APIKey: "unrelated", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+	}}}
+	compiled := compileClientKeyAllowlist(cfg)
+	for _, auth := range keyAllowlistAuths {
+		if (*compiled).allows("dup-key", auth) || (*compiled).allows("unrelated", auth) {
+			t.Fatalf("invalid config selected %s", auth.ID)
+		}
+	}
+	for name, selector := range keyAllowlistSelectors {
+		t.Run(name, func(t *testing.T) {
+			manager, executors := newKeyAllowlistManager(t, selector(), cfg, false)
+			ctx := coreusage.WithAPIKey(context.Background(), "unrelated")
+			if _, errExecute := manager.Execute(ctx, []string{"claude", "codex"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{}); errExecute == nil {
+				t.Fatal("invalid config selected through Execute")
+			}
+			if used := keyAllowlistAttempts(executors); len(used) != 0 {
+				t.Fatalf("invalid config attempted %v", used)
+			}
+		})
+	}
+	cfg.KeyAllowlist[1].APIKey = "other-key"
+	compiled = compileClientKeyAllowlist(cfg)
+	if !(*compiled).allows("dup-key", keyAllowlistAuths[0]) || !(*compiled).allows("other-key", keyAllowlistAuths[3]) {
+		t.Fatal("distinct keys lost their own credentials")
+	}
+}
+
+// An apikey rule matches only a credential synthesized from config. A Meta
+// login loaded from the auth store, whose file has no auth_kind, gains api_key
+// and base_url attributes on refresh and classifies as apikey until the
+// watcher's auth_kind=oauth attribute replaces it; it must match no apikey
+// rule, with or without base-urls. Positive control: the same attributes with
+// a config source match both rules.
+func TestKeyAllowlistAPIKeyRulesNeedAConfigCredential(t *testing.T) {
+	const metaBaseURL = "https://api.meta.ai/v1"
+	refreshed := func(source map[string]string) *Auth {
+		attributes := map[string]string{AttributeAPIKey: "minted", "base_url": metaBaseURL}
+		for name, value := range source {
+			attributes[name] = value
+		}
+		return &Auth{ID: "meta.json", Provider: "meta", Attributes: attributes, Metadata: map[string]any{"access_token": "token", "email": "user@example.com"}}
+	}
+	allowlist := clientKeyAllowlist{
+		"meta-key":      {{Provider: "meta", Kind: "apikey"}},
+		"meta-base-key": {{Provider: "meta", Kind: "apikey", BaseURLs: []string{metaBaseURL}}},
+	}
+	cases := []struct {
+		name  string
+		auth  *Auth
+		allow bool
+	}{
+		{name: "store-loaded file", auth: refreshed(map[string]string{AttributePath: "/auths/meta.json", AttributeSource: "/auths/meta.json", AttributeSourceBackend: AuthSourceFile})},
+		{name: "config", auth: refreshed(map[string]string{AttributeSource: "config:meta[x]"}), allow: true},
+	}
+	for _, test := range cases {
+		// The file-sourced auth must reach allows as apikey, or this would
+		// test classification rather than the allowlist.
+		if kind := test.auth.AuthKind(); kind != AuthKindAPIKey {
+			t.Fatalf("%s: AuthKind() = %q, want %q", test.name, kind, AuthKindAPIKey)
+		}
+		for key := range allowlist {
+			if got := allowlist.allows(key, test.auth); got != test.allow {
+				t.Errorf("%s: key %q allows = %v, want %v", test.name, key, got, test.allow)
+			}
+		}
+	}
+}
+
+func TestKeyAllowlistOAuthAccounts(t *testing.T) {
+	const email = "personal@example.com"
+	allowlist := clientKeyAllowlist{
+		"personal": {{Provider: "claude", Kind: "oauth", Accounts: []string{" \t" + email + "\n"}}},
+		"api":      {{Provider: "claude", Kind: "apikey", Accounts: []string{email}}},
+	}
+	cases := []struct {
+		name  string
+		email string
+		kind  string
+		allow bool
+	}{
+		{name: "match", email: " " + email + " ", kind: AuthKindOAuth, allow: true},
+		{name: "other account", email: "work@example.com", kind: AuthKindOAuth},
+		{name: "case differs", email: "Personal@example.com", kind: AuthKindOAuth},
+		{name: "empty email", email: " \t", kind: AuthKindOAuth},
+		{name: "api key", email: email, kind: AuthKindAPIKey},
+	}
+	for _, test := range cases {
+		auth := &Auth{Provider: "claude", Attributes: map[string]string{AttributeAuthKind: test.kind, AttributeAPIKey: email, AttributeSource: "config:claude[x]"}, Metadata: map[string]any{"email": test.email}}
+		if got := allowlist.allows("personal", auth); got != test.allow {
+			t.Errorf("%s: allows = %v, want %v", test.name, got, test.allow)
+		}
+		if allowlist.allows("api", auth) {
+			t.Errorf("%s: accounts with apikey kind matched", test.name)
+		}
+	}
+}
+
+// A new matching login is usable after registration, with the original config.
+func TestKeyAllowlistHotAddedOAuthAccount(t *testing.T) {
+	for selectorName, selector := range keyAllowlistSelectors {
+		t.Run(selectorName, func(t *testing.T) {
+			cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: []internalconfig.KeyAllowlist{
+				{APIKey: "personal", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth", Accounts: []string{"personal@example.com"}}}},
+			}}}
+			manager, executors := newKeyAllowlistManager(t, selector(), cfg, false)
+			ctx := coreusage.WithAPIKey(context.Background(), "personal")
+			request := cliproxyexecutor.Request{Model: keyAllowlistModel}
+			if _, err := manager.Execute(ctx, []string{"claude"}, request, cliproxyexecutor.Options{}); err == nil {
+				t.Fatal("selected a login without the account")
+			}
+			for _, name := range []string{"work", "personal"} {
+				auth := &Auth{ID: "hot-" + name, Provider: "claude", Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth}, Metadata: map[string]any{"email": name + "@example.com"}}
+				registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: keyAllowlistModel}})
+				id := auth.ID
+				t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+				if _, err := manager.Register(context.Background(), auth); err != nil {
+					t.Fatalf("register hot login: %v", err)
+				}
+			}
+			for range keyAllowlistRounds {
+				response, err := manager.Execute(ctx, []string{"claude"}, request, cliproxyexecutor.Options{})
+				if err != nil || string(response.Payload) != "hot-personal" {
+					t.Fatalf("hot login response = %q, %v", response.Payload, err)
+				}
+			}
+			if used := keyAllowlistAttempts(executors); len(used) != 1 || !used["hot-personal"] {
+				t.Fatalf("account rule used %v", used)
+			}
+		})
+	}
+}
