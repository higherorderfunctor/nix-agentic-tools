+	"testing"
+)
+
+func TestKeyAllowlistOAuthOverrideReload(t *testing.T) {
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "config.yaml")
+	authDir := filepath.Join(dir, "auth")
+	if err := os.Mkdir(authDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	raw := []byte(`{"type":"claude","email":"person@example.invalid","access_token":"fake","priority":2}`)
+	if err := os.WriteFile(filepath.Join(authDir, "login.json"), raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	w := &Watcher{configPath: configPath, authDir: authDir}
+	write := func(extra string) {
+		t.Helper()
+		if err := os.WriteFile(configPath, []byte("config-version: 8\noauth:\n  auth-dir: "+authDir+"\n"+extra), 0600); err != nil {
+			t.Fatal(err)
+		}
+		w.reloadConfigIfChanged()
+	}
+	assertPriority := func(want string) {
+		t.Helper()
+		w.clientsMutex.RLock()
+		defer w.clientsMutex.RUnlock()
+		auth := w.currentAuths["login.json"]
+		if auth == nil || auth.Attributes["priority"] != want {
+			t.Fatalf("auth = %#v, want priority %s", auth, want)
+		}
+	}
+	write("")
+	assertPriority("2")
+	write("  credential-overrides:\n    - provider: claude\n      account: person@example.invalid\n      priority: -1\n")
+	assertPriority("-1")
+	write("  credential-overrides:\n    - provider: claude\n      account: person@example.invalid\n      priority: 0\n")
+	assertPriority("0")
+	write("")
+	assertPriority("2")
+	data, err := os.ReadFile(filepath.Join(authDir, "login.json"))
+	if err != nil || string(data) != string(raw) {
+		t.Fatal("reload wrote login")
+	}
+}
