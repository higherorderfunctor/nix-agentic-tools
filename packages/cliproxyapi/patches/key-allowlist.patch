+const listingCodex = "gpt-listing-codex"
+const listingClaude = "claude-opus-5-5"
+
+func listingFixture(t *testing.T) (*auth.Manager, *handlers.BaseAPIHandler, []config.KeyAllowlist) {
+	t.Helper()
+	manager := auth.NewManager(nil, &auth.RoundRobinSelector{}, nil)
+	rules := []config.KeyAllowlist{
+		{APIKey: "personal-codex", Credentials: []config.KeyAllowlistCredential{
+			{Provider: "codex", Kind: "oauth"},
+			{Provider: "claude", Kind: "apikey", BaseURLs: []string{"https://api.anthropic.com"}},
+		}},
+		{APIKey: "codex-only", Credentials: []config.KeyAllowlistCredential{{Provider: "codex", Kind: "oauth"}}},
+		{APIKey: "personal-claude", Credentials: []config.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+	}
+	manager.SetConfig(&config.Config{SDKConfig: config.SDKConfig{KeyAllowlist: rules}})
+	fixtures := []struct {
+		credential *auth.Auth
+		model      string
+	}{
+		{&auth.Auth{ID: "listing-codex", Provider: "codex", Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth}}, listingCodex},
+		{&auth.Auth{ID: "listing-api", Provider: "claude", Attributes: map[string]string{auth.AttributeAPIKey: "fake", auth.AttributeSource: "config:claude[0]", "base_url": "https://api.anthropic.com", "priority": "-1"}}, listingClaude},
+		{&auth.Auth{ID: "listing-oauth", Provider: "claude", Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth}}, "claude-listing-oauth"},
+		{&auth.Auth{ID: "listing-other-url", Provider: "claude", Attributes: map[string]string{auth.AttributeAPIKey: "fake", auth.AttributeSource: "config:claude[1]", "base_url": "https://other.invalid"}}, "claude-listing-other-url"},
+		{&auth.Auth{ID: "listing-gemini", Provider: "gemini", Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth}}, "gemini-listing-other"},
+		{&auth.Auth{ID: "listing-disabled", Provider: "codex", Disabled: true, Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth}}, "gpt-listing-disabled"},
+	}
+	reg := registry.GetGlobalRegistry()
+	for _, fixture := range fixtures {
+		credential := fixture.credential
+		reg.RegisterClient(credential.ID, credential.Provider, []*registry.ModelInfo{{ID: fixture.model, DisplayName: fixture.model}})
+		t.Cleanup(func() { reg.UnregisterClient(credential.ID) })
+		if _, err := manager.Register(context.Background(), credential); err != nil {
+			t.Fatal(err)
+		}
