new file mode 100644
index 0000000..8fed490
--- /dev/null
+++ b/internal/config/key_allowlist.go
@@ -0,0 +1,69 @@
+package config
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// KeyAllowlist binds one client key to the upstream credentials its requests
+// may select. While access.key-allowlist has any entry, credential selection
+// fails closed: a request whose authenticated client key has no entry selects
+// no credential, and an entry selects only credentials one of its rules allows.
+type KeyAllowlist struct {
+	// APIKey is the client key, as listed in access.api-keys.
+	APIKey string `yaml:"api-key" json:"api-key"`
+	// Credentials lists the rules a credential must match one of.
+	Credentials []KeyAllowlistCredential `yaml:"credentials" json:"credentials"`
+}
+
+// ClientKey is the client key the entry binds, trimmed as credential selection
+// compares it. An empty result binds no request.
+func (e KeyAllowlist) ClientKey() string { return strings.TrimSpace(e.APIKey) }
+
+// KeyAllowlistCredential matches upstream credentials by provider and kind,
+// optionally narrowed to credential IDs and API-key base URLs.
+type KeyAllowlistCredential struct {
+	// Provider is the credential's provider as CPA records it, such as claude,
+	// codex or gemini, and openai-compatible-<name> for an openai-compatibility group.
+	Provider string `yaml:"provider" json:"provider"`
+	// Kind is the credential kind, oauth or apikey. A rule with any other kind matches nothing.
+	Kind string `yaml:"kind" json:"kind"`
+	// IDs, when set, narrows the rule to these credential IDs; an OAuth login's
+	// ID is its file path relative to the auth directory.
+	IDs []string `yaml:"ids,omitempty" json:"ids,omitempty"`
+	// BaseURLs, when set, narrows the rule to API-key credentials whose
+	// base-url is one of these, compared as CPA stores it (trimmed, otherwise
+	// exact). It never matches an OAuth login or a credential without a base-url.
+	BaseURLs []string `yaml:"base-urls,omitempty" json:"base-urls,omitempty"`
+}
+
+// ValidateKeyAllowlist refuses entries that bind the same client key. Selection
+// looks rules up by that key, so two such entries would act as one principal
+// holding the union of both entries' rules. The error names the entries by
+// index and never the key. Entries with an empty key bind no request and are
+// not compared.
+func ValidateKeyAllowlist(entries []KeyAllowlist) error {
+	indexes := make(map[string][]string, len(entries))
+	var order []string
+	for i, entry := range entries {
+		key := entry.ClientKey()
+		if key == "" {
+			continue
+		}
+		if len(indexes[key]) == 0 {
+			order = append(order, key)
+		}
+		indexes[key] = append(indexes[key], strconv.Itoa(i))
+	}
+	var duplicates []string
+	for _, key := range order {
+		if len(indexes[key]) > 1 {
+			duplicates = append(duplicates, "entries "+strings.Join(indexes[key], ", "))
+		}
+	}
+	if len(duplicates) == 0 {
+		return nil
+	}
+	return fmt.Errorf("access.key-allowlist: %s have the same api-key after trimming; give each client key one entry, since entries sharing a key would merge their credential rules", strings.Join(duplicates, "; "))
+}
