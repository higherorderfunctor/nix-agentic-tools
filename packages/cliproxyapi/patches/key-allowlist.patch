+// The access middleware records ?key= and ?auth_token= as the client principal;
+// an authenticated key without an allowlist entry must still select nothing.
+func TestKeyAllowlistAppliesToQueryKeys(t *testing.T) {
+	cfg, errParse := config.ParseConfigBytes([]byte(`config-version: 8
+access:
+  api-keys: [key-a, key-unlisted]
+  key-allowlist:
+    - api-key: key-a
+      credentials: [{provider: alpha, kind: apikey}]
+`))
+	if errParse != nil {
+		t.Fatalf("parse v8 config: %v", errParse)
+	}
+	configaccess.Register(&cfg.SDKConfig)
+	t.Cleanup(func() { configaccess.Register(nil) })
+	access := sdkaccess.NewManager()
+	access.SetProviders(sdkaccess.RegisteredProviders())
+
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(stubExecutor{provider: "alpha"})
+	if _, errRegister := manager.Register(context.Background(), &coreauth.Auth{ID: "alpha", Provider: "alpha", Attributes: map[string]string{coreauth.AttributeAPIKey: "upstream-alpha", coreauth.AttributeSource: "config:alpha[0]"}}); errRegister != nil {
+		t.Fatalf("register alpha: %v", errRegister)
+	}
+
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.Use(api.AuthMiddleware(access))
+	router.GET("/select/:provider", func(c *gin.Context) {
+		selected, errSelect := manager.SelectAuth(c.Request.Context(), c.Param("provider"), "", cliproxyexecutor.Options{})
+		if errSelect != nil {
+			c.String(http.StatusForbidden, errSelect.Error())
+			return
+		}
+		c.String(http.StatusOK, selected.ID)
+	})
+
+	cases := []struct {
+		target string
+		status int
+		body   string
+	}{
+		{target: "/select/alpha?key=key-a", status: http.StatusOK, body: "alpha"},
+		{target: "/select/alpha?auth_token=key-a", status: http.StatusOK, body: "alpha"},
+		{target: "/select/alpha?key=key-unlisted", status: http.StatusForbidden},
+	}
+	for _, test := range cases {
+		request := httptest.NewRequest(http.MethodGet, test.target, nil)
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, request)
+		if recorder.Code != test.status || (test.body != "" && recorder.Body.String() != test.body) {
+			t.Errorf("%s: %d %q, want %d %q", test.target, recorder.Code, recorder.Body.String(), test.status, test.body)
+		}
+	}
+}
+
+// Two api-keys.claude groups share provider and kind, and their IDs hash the
+// secret, so only base-urls tells them apart; a third group on the default
+// endpoint has no base_url at all. The credentials come from the config
+// synthesizer, which stores the base_url the rule compares. An OAuth login is
+// never matched by a base-urls rule, even one carrying a base_url attribute as
+// Kimi logins do, yet a plain oauth rule does select it.
+func TestKeyAllowlistSeparatesSameProviderBaseURLs(t *testing.T) {
+	cfg, errParse := config.ParseConfigBytes([]byte(`config-version: 8
+access:
+  api-keys: [key-both, key-nearmiss, key-oauth, key-oauth-plain, key-plain, key-zai]
+  key-allowlist:
+    - api-key: key-both
+      credentials: [{provider: claude, kind: apikey, base-urls: [https://api.z.ai/api/anthropic, https://other.example/anthropic]}]
+    - api-key: key-nearmiss
+      credentials: [{provider: claude, kind: apikey, base-urls: ["https://api.z.ai/api/anthropic/"]}]
+    - api-key: key-oauth
+      credentials: [{provider: claude, kind: oauth, base-urls: [https://api.z.ai/api/anthropic]}]
+    - api-key: key-oauth-plain
+      credentials: [{provider: claude, kind: oauth}]
+    - api-key: key-plain
+      credentials: [{provider: claude, kind: apikey}]
+    - api-key: key-zai
+      credentials: [{provider: claude, kind: apikey, base-urls: [" https://api.z.ai/api/anthropic "]}]
+api-keys:
+  claude:
+    - name: zai
+      base-url: https://api.z.ai/api/anthropic
+      keys: [{api-key: upstream-zai}]
+    - name: other
+      base-url: https://other.example/anthropic
+      keys: [{api-key: upstream-other}]
+    - name: default
+      keys: [{api-key: upstream-default}]
+`))
+	if errParse != nil {
+		t.Fatalf("parse v8 config: %v", errParse)
+	}
+	auths, errSynthesize := synthesizer.NewConfigSynthesizer().Synthesize(&synthesizer.SynthesisContext{Config: cfg, Now: time.Now(), IDGenerator: synthesizer.NewStableIDGenerator()})
+	if errSynthesize != nil || len(auths) != 3 {
+		t.Fatalf("synthesize: %d auths, %v", len(auths), errSynthesize)
+	}
+	auths = append(auths, &coreauth.Auth{ID: "claude-oauth", Provider: "claude", Attributes: map[string]string{coreauth.AttributeAuthKind: coreauth.AuthKindOAuth, "base_url": "https://api.z.ai/api/anthropic"}})
+	// Each credential under a name a case can list: its base URL, "default"
+	// for the group with none, "oauth" for the login.
+	labels := map[string]string{"claude-oauth": "oauth"}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(stubExecutor{provider: "claude"})
+	for _, auth := range auths {
+		if auth.ID != "claude-oauth" {
+			labels[auth.ID] = auth.Attributes["base_url"]
+			if labels[auth.ID] == "" {
+				labels[auth.ID] = "default"
+			}
+		}
+		if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+			t.Fatalf("register %s: %v", auth.ID, errRegister)
+		}
+	}
+
+	cases := []struct {
+		key  string
+		want []string
+	}{
+		{key: "key-both", want: []string{"https://api.z.ai/api/anthropic", "https://other.example/anthropic"}},
+		// A base URL differing by a trailing slash names no credential.
+		{key: "key-nearmiss"},
+		// A base-urls rule never matches the OAuth login that carries a matching base_url.
+		{key: "key-oauth"},
+		// Positive control: the login is selectable, by a plain oauth rule.
+		{key: "key-oauth-plain", want: []string{"oauth"}},
+		// Positive control: the group with no base_url is selectable, by a rule without base-urls.
+		{key: "key-plain", want: []string{"default", "https://api.z.ai/api/anthropic", "https://other.example/anthropic"}},
+		{key: "key-zai", want: []string{"https://api.z.ai/api/anthropic"}},
+	}
+	for _, test := range cases {
+		key, want := test.key, test.want
+		ctx := coreusage.WithAPIKey(context.Background(), key)
+		seen := map[string]bool{}
+		for range 12 {
+			selected, errSelect := manager.SelectAuth(ctx, "claude", "", cliproxyexecutor.Options{})
+			if errSelect != nil {
+				if len(want) > 0 {
+					t.Fatalf("%s: select: %v", key, errSelect)
+				}
+				continue
+			}
+			seen[labels[selected.ID]] = true
+		}
+		if len(seen) != len(want) {
+			t.Fatalf("%s reached %v, want %v", key, seen, want)
+		}
+		for _, label := range want {
+			if !seen[label] {
+				t.Fatalf("%s reached %v, want %v", key, seen, want)
+			}
+		}
+	}
+}
+
+// Entries that bind the same client key, verbatim or once trimmed, would merge
+// into one principal holding both entries' rules, so every load path refuses
+// them: ParseConfigBytes (Home, management), LoadConfig (startup, hot reload,
+// management) and cloud-deploy's optional load, which otherwise falls back to an
+// empty config on a parse error. The error names the entries by index and never
+// prints the key. Distinct keys load, and still enforce (TestKeyAllowlistAppliesToQueryKeys).
+func TestKeyAllowlistRefusesDuplicateKeys(t *testing.T) {
+	document := func(keys ...string) []byte {
+		var b strings.Builder
+		b.WriteString("config-version: 8\naccess:\n  key-allowlist:\n")
+		for _, key := range keys {
+			fmt.Fprintf(&b, "    - api-key: %q\n      credentials: [{provider: alpha, kind: apikey}]\n", key)
+		}
+		return []byte(b.String())
+	}
+	const suffix = " have the same api-key after trimming; give each client key one entry, since entries sharing a key would merge their credential rules"
+	cases := []struct {
+		name   string
+		keys   []string
+		groups string
+	}{
+		{name: "identical after trim", keys: []string{"secret-dup", "secret-other", " \tsecret-dup\n"}, groups: "entries 0, 2"},
+		{name: "distinct and empty", keys: []string{"secret-a", "", "  ", "secret-b"}},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			data := document(test.keys...)
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			if errWrite := os.WriteFile(path, data, 0o600); errWrite != nil {
+				t.Fatalf("write config: %v", errWrite)
+			}
+			loads := map[string]func() (*config.Config, error){
+				"ParseConfigBytes":         func() (*config.Config, error) { return config.ParseConfigBytes(data) },
+				"LoadConfig":               func() (*config.Config, error) { return config.LoadConfig(path) },
+				"LoadConfigOptional/cloud": func() (*config.Config, error) { return config.LoadConfigOptional(path, true) },
+			}
+			for loader, load := range loads {
+				cfg, errLoad := load()
+				if test.groups == "" {
+					if errLoad != nil {
+						t.Fatalf("%s refused distinct keys: %v", loader, errLoad)
+					}
+					if len(cfg.KeyAllowlist) != len(test.keys) {
+						t.Fatalf("%s loaded %d entries, want %d", loader, len(cfg.KeyAllowlist), len(test.keys))
+					}
+					continue
+				}
+				if errLoad == nil {
+					t.Fatalf("%s accepted duplicate keys", loader)
+				}
+				if want := "access.key-allowlist: " + test.groups + suffix; errLoad.Error() != want {
+					t.Fatalf("%s error = %q, want %q", loader, errLoad.Error(), want)
+				}
+			}
+		})
+	}
+}
