+package config
+
+// OAuthCredentialOverride applies behavior to every OAuth login matching one provider and account.
+// Unset fields preserve the original login metadata and CPA defaults.
+type OAuthCredentialOverride struct {
+	Provider string `yaml:"provider" json:"provider"`
+	Account  string `yaml:"account" json:"account"`
+	// BaseURL Provider-specific upstream base URL.
+	BaseURL *string `yaml:"base-url,omitempty" json:"base_url,omitempty"`
+	// DisableCooling Per-credential cooldown override.
+	DisableCooling *bool `yaml:"disable-cooling,omitempty" json:"disable_cooling,omitempty"`
+	// Disabled Whether this credential is disabled.
+	Disabled *bool `yaml:"disabled,omitempty" json:"disabled,omitempty"`
+	// Domain Kimi provider domain.
+	Domain *string `yaml:"domain,omitempty" json:"domain,omitempty"`
+	// ExcludedModels Per-credential excluded model patterns.
+	ExcludedModels *[]string `yaml:"excluded-models,omitempty" json:"excluded_models,omitempty"`
+	// FingerprintProfile Provider request fingerprint profile.
+	FingerprintProfile *string `yaml:"fingerprint-profile,omitempty" json:"fingerprint_profile,omitempty"`
+	// Headers Per-credential upstream request headers.
+	Headers *map[string]string `yaml:"headers,omitempty" json:"headers,omitempty"`
+	// Interactions selects native Vertex Interactions execution.
+	Interactions *bool `yaml:"interactions,omitempty" json:"interactions,omitempty"`
+	// Location is the Vertex request region.
+	Location *string `yaml:"location,omitempty" json:"location,omitempty"`
+	// ModelAliases Per-credential OAuth model aliases.
+	ModelAliases *[]OAuthModelAlias `yaml:"model-aliases,omitempty" json:"model_aliases,omitempty"`
+	// NativeInteractions selects native Vertex Interactions execution.
+	NativeInteractions *bool `yaml:"native-interactions,omitempty" json:"native_interactions,omitempty"`
+	// Note Human-readable credential note.
+	Note *string `yaml:"note,omitempty" json:"note,omitempty"`
+	// OpenAPI Select Vertex OpenAPI endpoints.
+	OpenAPI *bool `yaml:"openapi,omitempty" json:"openapi,omitempty"`
+	// OpenAPILocation Vertex OpenAPI location.
+	OpenAPILocation *string `yaml:"openapi-location,omitempty" json:"openapi_location,omitempty"`
+	// OpenAPIModels Vertex OpenAPI model names.
+	OpenAPIModels *[]string `yaml:"openapi-models,omitempty" json:"openapi_models,omitempty"`
+	// Prefix Model namespace prefix.
+	Prefix *string `yaml:"prefix,omitempty" json:"prefix,omitempty"`
+	// Priority Scheduling priority; higher available priorities win.
+	Priority *int `yaml:"priority,omitempty" json:"priority,omitempty"`
+	// ProxyURL Per-credential upstream proxy URL.
+	ProxyURL *string `yaml:"proxy-url,omitempty" json:"proxy_url,omitempty"`
+	// RequestRetry Per-credential request retry count; negative falls back to global.
+	RequestRetry *int `yaml:"request-retry,omitempty" json:"request_retry,omitempty"`
+	// RequestScopedErrors Per-credential upstream error rules.
+	RequestScopedErrors *[]RequestScopedErrorRule `yaml:"request-scoped-errors,omitempty" json:"request_scoped_errors,omitempty"`
+	// SkipAccountProfile skips Claude OAuth account-profile lookup.
+	SkipAccountProfile *bool `yaml:"skip-account-profile,omitempty" json:"skip_account_profile,omitempty"`
+	// ToolPrefixDisabled Disable the Anthropic tool name prefix.
+	ToolPrefixDisabled *bool `yaml:"tool-prefix-disabled,omitempty" json:"tool_prefix_disabled,omitempty"`
