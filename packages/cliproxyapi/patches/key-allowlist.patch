+// Direct Config callers skip loading. Duplicate keys must deny every client;
+// distinct keys still select their own credentials.
+func TestKeyAllowlistDuplicateKeysSelectNothing(t *testing.T) {
+	cfg := &internalconfig.Config{SDKConfig: internalconfig.SDKConfig{KeyAllowlist: []internalconfig.KeyAllowlist{
+		{APIKey: "dup-key", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+		{APIKey: " dup-key ", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "codex", Kind: "apikey"}}},
+		{APIKey: "unrelated", Credentials: []internalconfig.KeyAllowlistCredential{{Provider: "claude", Kind: "oauth"}}},
+	}}}
+	compiled := compileClientKeyAllowlist(cfg)
+	for _, auth := range keyAllowlistAuths {
+		if (*compiled).allows("dup-key", auth) || (*compiled).allows("unrelated", auth) {
+			t.Fatalf("invalid config selected %s", auth.ID)
+		}
+	}
+	for name, selector := range keyAllowlistSelectors {
+		t.Run(name, func(t *testing.T) {
+			manager, executors := newKeyAllowlistManager(t, selector(), cfg, false)
+			ctx := coreusage.WithAPIKey(context.Background(), "unrelated")
+			if _, errExecute := manager.Execute(ctx, []string{"claude", "codex"}, cliproxyexecutor.Request{Model: keyAllowlistModel}, cliproxyexecutor.Options{}); errExecute == nil {
+				t.Fatal("invalid config selected through Execute")
+			}
+			if used := keyAllowlistAttempts(executors); len(used) != 0 {
+				t.Fatalf("invalid config attempted %v", used)
+			}
+		})
+	}
+	cfg.KeyAllowlist[1].APIKey = "other-key"
+	compiled = compileClientKeyAllowlist(cfg)
+	if !(*compiled).allows("dup-key", keyAllowlistAuths[0]) || !(*compiled).allows("other-key", keyAllowlistAuths[3]) {
+		t.Fatal("distinct keys lost their own credentials")
+	}
+}
+
+// An apikey rule matches only a credential synthesized from config. A Meta
+// login loaded from the auth store, whose file has no auth_kind, gains api_key
+// and base_url attributes on refresh and classifies as apikey until the
+// watcher's auth_kind=oauth attribute replaces it; it must match no apikey
+// rule, with or without base-urls. Positive control: the same attributes with
+// a config source match both rules.
+func TestKeyAllowlistAPIKeyRulesNeedAConfigCredential(t *testing.T) {
+	const metaBaseURL = "https://api.meta.ai/v1"
+	refreshed := func(source map[string]string) *Auth {
+		attributes := map[string]string{AttributeAPIKey: "minted", "base_url": metaBaseURL}
+		for name, value := range source {
+			attributes[name] = value
+		}
+		return &Auth{ID: "meta.json", Provider: "meta", Attributes: attributes, Metadata: map[string]any{"access_token": "token", "email": "user@example.com"}}
+	}
+	allowlist := clientKeyAllowlist{
+		"meta-key":      {{Provider: "meta", Kind: "apikey"}},
+		"meta-base-key": {{Provider: "meta", Kind: "apikey", BaseURLs: []string{metaBaseURL}}},
+	}
+	cases := []struct {
+		name  string
+		auth  *Auth
+		allow bool
+	}{
+		{name: "store-loaded file", auth: refreshed(map[string]string{AttributePath: "/auths/meta.json", AttributeSource: "/auths/meta.json", AttributeSourceBackend: AuthSourceFile})},
+		{name: "config", auth: refreshed(map[string]string{AttributeSource: "config:meta[x]"}), allow: true},
+	}
+	for _, test := range cases {
+		// The file-sourced auth must reach allows as apikey, or this would
+		// test classification rather than the allowlist.
+		if kind := test.auth.AuthKind(); kind != AuthKindAPIKey {
+			t.Fatalf("%s: AuthKind() = %q, want %q", test.name, kind, AuthKindAPIKey)
+		}
+		for key := range allowlist {
+			if got := allowlist.allows(key, test.auth); got != test.allow {
+				t.Errorf("%s: key %q allows = %v, want %v", test.name, key, got, test.allow)
+			}
+		}
+	}
+}
