@@ -0,0 +1,51 @@
+package auth
+
+// BindOAuthOverrideOriginal remembers only configured behavior keys, never tokens.
+// Nil values mean that the original login had no such key.
+func (a *Auth) BindOAuthOverrideOriginal(original map[string]any) {
+	a.oauthOverrideOriginal = original
+}
+
+// WithoutOAuthOverrides keeps refreshed credentials while restoring login behavior
+// on a copy for the token store. Clone retains the immutable original map.
+func (a *Auth) WithoutOAuthOverrides() *Auth {
+	if len(a.oauthOverrideOriginal) == 0 {
+		return a
+	}
+	saved := a.Clone()
+	for key, value := range a.oauthOverrideOriginal {
+		if value == nil {
+			delete(saved.Metadata, key)
+		} else {
+			saved.Metadata[key] = value
+		}
+	}
+	if _, overridden := a.oauthOverrideOriginal["disabled"]; overridden {
+		saved.Disabled, _ = saved.Metadata["disabled"].(bool)
+	}
+	return saved
+}
+
+// MergeOAuthPersistence retains native token-store output (including Codex disk
+// merges and consumed refresh patches) without replacing effective behavior.
+func (a *Auth) MergeOAuthPersistence(saved *Auth) {
+	if a == saved {
+		return
+	}
+	metadata := saved.Clone().Metadata
+	for key := range a.oauthOverrideOriginal {
+		if value, present := a.Metadata[key]; present {
+			metadata[key] = value
+		} else {
+			delete(metadata, key)
+		}
+	}
+	if _, overridden := a.oauthOverrideOriginal["disabled"]; !overridden {
+		a.Disabled = saved.Disabled
+	}
+	a.Metadata = metadata
+	a.CodexRefreshPatch = saved.CodexRefreshPatch
+	a.Storage = saved.Storage
+	a.Attributes = saved.Attributes
+	a.FileName = saved.FileName
+}
