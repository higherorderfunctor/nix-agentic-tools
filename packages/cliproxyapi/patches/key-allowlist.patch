diff --git a/sdk/api/handlers/key_allowlist_models.go b/sdk/api/handlers/key_allowlist_models.go
new file mode 100644
index 0000000..7ba133d
--- /dev/null
+++ b/sdk/api/handlers/key_allowlist_models.go
@@ -0,0 +1,62 @@
+package handlers
+
+import (
+	"encoding/json"
+	"fmt"
+
+	claudemodels "github.com/router-for-me/CLIProxyAPI/v8/internal/client/claude/models"
+)
+
+// filterModelListing keeps wire IDs and metadata intact, checking the route ID
+// selection receives. Claude's listing cloaking is reversed by its request handler.
+// Unknown envelopes or missing/non-string IDs must fail closed under an allowlist.
+func filterModelListing(body []byte, sourceFormat string, allows func(string) bool) ([]byte, error) {
+	var catalog map[string]json.RawMessage
+	if err := json.Unmarshal(body, &catalog); err != nil {
+		return nil, err
+	}
+	field, idField := "data", "id"
+	_, data := catalog["data"]
+	_, models := catalog["models"]
+	if data == models {
+		return nil, fmt.Errorf("expected one model array")
+	}
+	if models {
+		field, idField = "models", "slug"
+	}
+	var entries []json.RawMessage
+	if err := json.Unmarshal(catalog[field], &entries); err != nil {
+		return nil, err
+	}
+	kept := make([]json.RawMessage, 0, len(entries))
+	first, last := "", ""
+	for _, entry := range entries {
+		var model map[string]json.RawMessage
+		if err := json.Unmarshal(entry, &model); err != nil {
+			return nil, err
+		}
+		var id string
+		if err := json.Unmarshal(model[idField], &id); err != nil || id == "" {
+			return nil, fmt.Errorf("missing model %s", idField)
+		}
+		routeID := id
+		if sourceFormat == "claude" {
+			routeID = claudemodels.ResolveClaudeModelIDPrefix(id)
+		}
+		if !allows(routeID) {
+			continue
+		}
+		kept = append(kept, entry)
+		if first == "" {
+			first = id
+		}
+		last = id
+	}
+	catalog[field], _ = json.Marshal(kept)
+	for field, id := range map[string]string{"first_id": first, "last_id": last} {
+		if _, exists := catalog[field]; exists {
+			catalog[field], _ = json.Marshal(id)
+		}
+	}
+	return json.Marshal(catalog)
+}
