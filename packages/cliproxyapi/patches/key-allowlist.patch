+	return manager, handlers.NewBaseAPIHandlers(&config.SDKConfig{}, manager), rules
+}
+
+func listingRequest(t *testing.T, base *handlers.BaseAPIHandler, endpoint, key string) map[string]any {
+	t.Helper()
+	writer := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(writer)
+	ctx.Request = httptest.NewRequest(http.MethodGet, endpoint, nil).WithContext(usage.WithAPIKey(context.Background(), key))
+	if endpoint == "/claude/models" {
+		claude.NewClaudeCodeAPIHandler(base).ClaudeModels(ctx)
+	} else {
+		openai.NewOpenAIAPIHandler(base).OpenAIModels(ctx)
+	}
+	if writer.Code != http.StatusOK {
+		t.Fatalf("%s status=%d body=%s", endpoint, writer.Code, writer.Body.String())
+	}
+	var catalog map[string]any
+	if err := json.Unmarshal(writer.Body.Bytes(), &catalog); err != nil {
+		t.Fatal(err)
+	}
+	return catalog
+}
+
+func listingIDs(catalog map[string]any) []string {
+	field, id := "data", "id"
+	if _, ok := catalog["models"]; ok {
+		field, id = "models", "slug"
+	}
+	ids := []string{}
+	for _, entry := range catalog[field].([]any) {
+		ids = append(ids, entry.(map[string]any)[id].(string))
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+func TestKeyAllowlistModelCatalogs(t *testing.T) {
+	manager, base, rules := listingFixture(t)
+	endpoints := []string{"/v1/models?client_version=0.134.0", "/v1/models", "/claude/models"}
+	for _, endpoint := range endpoints {
+		t.Run(endpoint, func(t *testing.T) {
+			for _, tc := range []struct {
+				key  string
+				want []string
+			}{
+				{"personal-codex", []string{listingClaude, listingCodex}},
+				{"personal-claude", []string{"claude-listing-oauth"}},
+				{"codex-only", []string{listingCodex}},
+				{"", []string{}}, {"unknown-key", []string{}},
+			} {
+				t.Run(tc.key, func(t *testing.T) {
+					catalog := listingRequest(t, base, endpoint, tc.key)
+					want := append([]string{}, tc.want...)
+					if endpoint == "/claude/models" {
+						for i, id := range want {
+							want[i] = claudemodels.EnsureClaudeModelIDPrefix(id)
+						}
+						entries := catalog["data"].([]any)
+						first, last := "", ""
+						if len(entries) > 0 {
+							first = entries[0].(map[string]any)["id"].(string)
+							last = entries[len(entries)-1].(map[string]any)["id"].(string)
+						}
+						if catalog["first_id"] != first || catalog["last_id"] != last {
+							t.Fatalf("pagination leaks removed IDs: %v", catalog)
+						}
+					}
+					sort.Strings(want)
+					if got := listingIDs(catalog); !reflect.DeepEqual(got, want) {
+						t.Fatalf("key %q IDs=%v want=%v", tc.key, got, want)
+					}
+				})
+			}
+		})
+	}
+	// Hot reload takes effect through the Manager's same atomic config pointer;
+	// the HTTP handler is deliberately not rebuilt.
+	manager.SetConfig(&config.Config{SDKConfig: config.SDKConfig{KeyAllowlist: rules[1:]}})
+	if got := listingIDs(listingRequest(t, base, endpoints[0], "personal-codex")); len(got) != 0 {
+		t.Errorf("revoked key retains models: %v", got)
+	}
+	manager.SetConfig(&config.Config{SDKConfig: config.SDKConfig{KeyAllowlist: []config.KeyAllowlist{{APIKey: "personal-codex", Credentials: rules[1].Credentials}}}})
+	if got := listingIDs(listingRequest(t, base, endpoints[0], "personal-codex")); !reflect.DeepEqual(got, []string{listingCodex}) {
+		t.Errorf("narrowed key models=%v", got)
+	}
+	manager.SetConfig(&config.Config{SDKConfig: config.SDKConfig{KeyAllowlist: rules}})
+	if got := listingIDs(listingRequest(t, base, endpoints[0], "personal-codex")); !reflect.DeepEqual(got, []string{listingClaude, listingCodex}) {
+		t.Errorf("widened key models=%v", got)
+	}
+	for _, entries := range [][]config.KeyAllowlist{nil, {}} {
+		manager.SetConfig(&config.Config{SDKConfig: config.SDKConfig{KeyAllowlist: entries}})
+		for _, endpoint := range endpoints {
+			// Native listing includes all six registry models, including the disabled
+			// credential's model: no allowlist must leave that native behavior intact.
+			if got := listingIDs(listingRequest(t, base, endpoint, "")); len(got) != 6 {
+				t.Fatalf("unrestricted %s models=%v", endpoint, got)
+			}
+		}
+	}
+}
+
+func TestKeyAllowlistUnknownCatalogFailsClosed(t *testing.T) {
+	_, base, _ := listingFixture(t)
+	for _, body := range []string{`{"items":[{"id":"gpt-listing-codex"}]}`, `{"models":[{"id":"gpt-listing-codex"}]}`, `{"data":[{}]}`, `{"data":[],"models":[]}`} {
