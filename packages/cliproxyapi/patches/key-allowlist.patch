+package store
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type overrideProbeStorage struct {
+	t        *testing.T
+	sentinel error
+}
+
+func (s *overrideProbeStorage) SetMetadata(metadata map[string]any) {
+	s.t.Helper()
+	if metadata["priority"] != float64(2) || metadata["disabled"] != false || metadata["access_token"] != "fake-refreshed" {
+		s.t.Fatalf("store received runtime overrides: %#v", metadata)
+	}
+}
+func (s *overrideProbeStorage) SaveTokenToFile(string) error { return s.sentinel }
+
+func TestKeyAllowlistOAuthOverrideStoreBoundaries(t *testing.T) {
+	for _, name := range []string{"git", "object", "postgres"} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			authDir := filepath.Join(dir, "workspace", "auth")
+			sentinel := errors.New("observed sanitized metadata")
+			auth := &coreauth.Auth{ID: "login.json", FileName: "login.json", Provider: "claude", Disabled: true, Metadata: map[string]any{"type": "claude", "access_token": "fake-refreshed", "priority": float64(9), "disabled": true}, Storage: &overrideProbeStorage{t: t, sentinel: sentinel}}
+			auth.BindOAuthOverrideOriginal(map[string]any{"priority": float64(2), "disabled": false})
+			var save func(context.Context, *coreauth.Auth) (string, error)
+			switch name {
+			case "git":
+				remote := setupGitRemoteRepository(t, dir, "main", testBranchSpec{name: "main", contents: "fake\n"})
+				store := NewGitTokenStore(remote, "", "", "")
+				store.SetBaseDir(authDir)
+				save = store.Save
+			case "object":
+				store := &ObjectTokenStore{authDir: authDir}
+				save = store.Save
+			case "postgres":
+				store := &PostgresStore{authDir: authDir}
+				save = store.Save
+			}
+			if _, err := save(context.Background(), auth); !errors.Is(err, sentinel) {
+				t.Fatalf("save = %v, want probe sentinel", err)
+			}
+			if auth.Metadata["priority"] != float64(9) || !auth.Disabled {
+				t.Fatal("store replaced runtime overrides")
+			}
+		})
+	}
+}
