+package synthesizer
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestKeyAllowlistOAuthOverrides(t *testing.T) {
+	dir := t.TempDir()
+	raw := []byte(`{"type":"claude","email":" person@example.invalid ","access_token":"fake-original","auth_kind":"apikey","priority":2,"weight":3,"disabled":true,"note":"original","headers":{"X-Test":"original"},"request_retry":4}`)
+	paths := []string{filepath.Join(dir, "one.json"), filepath.Join(dir, "two.json")}
+	for _, path := range paths {
+		if err := os.WriteFile(path, raw, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var entry config.OAuthCredentialOverride
+	if err := json.Unmarshal([]byte(`{"provider":" CLAUDE ","account":" person@example.invalid ","priority":-1,"weight":5,"prefix":"team","proxy_url":"direct://","disabled":false,"note":"managed","headers":{"X-Test":"managed"},"disable_cooling":true,"request_retry":0,"tool_prefix_disabled":true,"skip_account_profile":true,"websockets":true,"excluded_models":["hidden*"],"model_aliases":[{"name":"upstream","alias":"public"}]}`), &entry); err != nil {
+		t.Fatal(err)
+	}
+	ctx := &SynthesisContext{AuthDir: dir, Now: time.Now(), Config: &config.Config{OAuthCredentialOverrides: []config.OAuthCredentialOverride{entry}}}
+	synth := func() []*coreauth.Auth {
+		t.Helper()
+		auths, err := NewFileSynthesizer().Synthesize(ctx)
+		if err != nil || len(auths) != 2 {
+			t.Fatalf("synthesis: %d %v", len(auths), err)
+		}
+		return auths
+	}
+	for _, auth := range synth() {
+		if auth.Attributes["priority"] != "-1" || auth.Attributes["weight"] != "5" || auth.Prefix != "team" || auth.ProxyURL != "direct://" || auth.Disabled || auth.Attributes["note"] != "managed" || auth.Attributes["header:X-Test"] != "managed" {
+			t.Fatalf("effective auth: %#v", auth)
+		}
+		if value, present := auth.DisableCoolingOverride(); !present || !value {
+			t.Fatal("cooling override not consumed")
+		}
+		if value, present := auth.RequestRetryOverride(); !present || value != 0 {
+			t.Fatal("retry override not consumed")
+		}
+		if !auth.ToolPrefixDisabled() || auth.Metadata["skip_account_profile"] != true || auth.Metadata["websockets"] != true {
+			t.Fatal("metadata consumers missed overrides")
+		}
+		auth.Metadata["access_token"] = "fake-refreshed"
+		saved := auth.Clone().WithoutOAuthOverrides()
+		if saved.Metadata["access_token"] != "fake-refreshed" || saved.Metadata["priority"] != float64(2) || !saved.Disabled || saved.Metadata["prefix"] != nil || saved.Metadata["email"] != " person@example.invalid " {
+			t.Fatalf("persistence copy: %#v", saved)
+		}
+		if !auth.FileSnapshotMatchesDisk() {
+			t.Fatal("snapshot no longer matches original login bytes")
+		}
+	}
+	for _, path := range paths {
+		data, err := os.ReadFile(path)
+		if err != nil || string(data) != string(raw) {
+			t.Fatal("synthesis wrote login")
+		}
+	}
+	// Reload/removal synthesizes fresh raw login metadata; null and absent both omit overrides.
+	ctx.Config.OAuthCredentialOverrides = nil
+	for _, auth := range synth() {
+		if auth.Attributes["priority"] != "2" || !auth.Disabled || auth.Prefix != "" {
+			t.Fatalf("removal did not restore login: %#v", auth)
+		}
+	}
+	for _, changed := range []config.OAuthCredentialOverride{{Provider: "codex", Account: entry.Account, Priority: entry.Priority}, {Provider: entry.Provider, Account: "Person@example.invalid", Priority: entry.Priority}, {Provider: entry.Provider, Account: "", Priority: entry.Priority}} {
+		ctx.Config.OAuthCredentialOverrides = []config.OAuthCredentialOverride{changed}
+		for _, auth := range synth() {
+			if auth.Attributes["priority"] != "2" {
+				t.Fatal("undeclared login changed")
+			}
+		}
+	}
+	ctx.Config.OAuthCredentialOverrides = []config.OAuthCredentialOverride{{Provider: entry.Provider, Account: entry.Account}}
+	if !reflect.DeepEqual(synth()[0].Metadata["priority"], float64(2)) {
+		t.Fatal("null override changed native metadata")
+	}
+}
