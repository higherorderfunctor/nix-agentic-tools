+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type overrideStorage struct{ metadata map[string]any }
+
+func (s *overrideStorage) SetMetadata(value map[string]any) { s.metadata = value }
+func (s *overrideStorage) SaveTokenToFile(path string) error {
+	raw, err := json.Marshal(s.metadata)
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, raw, 0600)
+}
+
+func TestKeyAllowlistOAuthOverridePersistence(t *testing.T) {
+	for _, provider := range []string{"claude", "codex"} {
+		for _, useStorage := range []bool{false, true} {
+			t.Run(provider+map[bool]string{false: "-metadata", true: "-storage"}[useStorage], func(t *testing.T) {
+				dir := t.TempDir()
+				path := filepath.Join(dir, "login.json")
+				original := map[string]any{"type": provider, "email": "person@example.invalid", "access_token": "fake-original", "refresh_token": "fake-refresh", "priority": float64(2), "disabled": false}
+				raw, _ := json.Marshal(original)
+				if err := os.WriteFile(path, raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+				auth := &coreauth.Auth{ID: "login.json", Provider: provider, FileName: "login.json", Metadata: original, Disabled: true}
+				auth.BindOAuthOverrideOriginal(map[string]any{"priority": float64(2), "disabled": false, "prefix": nil})
+				auth.Metadata["priority"] = float64(9)
+				auth.Metadata["disabled"] = true
+				auth.Metadata["prefix"] = "managed"
+				before := auth.Clone()
+				auth.Metadata["access_token"] = "fake-refreshed"
+				if provider == "codex" {
+					auth.CodexRefreshPatch = codex.NewCredentialRefreshPatch(before.Metadata, auth.Metadata, true, false)
+				}
+				storage := &overrideStorage{}
+				if useStorage {
+					auth.Storage = storage
+				}
+				store := NewFileTokenStore()
+				store.SetBaseDir(dir)
+				if _, err := store.Save(context.Background(), auth); err != nil {
+					t.Fatal(err)
+				}
+				data, err := os.ReadFile(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var saved map[string]any
+				if err = json.Unmarshal(data, &saved); err != nil {
+					t.Fatal(err)
+				}
+				if saved["access_token"] != "fake-refreshed" || saved["refresh_token"] != "fake-refresh" || saved["priority"] != float64(2) || saved["disabled"] != false || saved["prefix"] != nil {
+					t.Fatalf("persisted overrides or lost tokens: %s", data)
+				}
+				if provider == "codex" && auth.CodexRefreshPatch != nil {
+					t.Fatal("native persistence did not consume refresh patch")
+				}
+				if auth.Metadata["access_token"] != "fake-refreshed" {
+					t.Fatal("native token merge lost")
+				}
+				if _, err := store.Save(context.Background(), auth); err != nil {
+					t.Fatal(err)
+				}
+				if auth.Metadata["priority"] != float64(9) || !auth.Disabled {
+					t.Fatal("save mutated runtime auth")
+				}
+				if useStorage && provider != "codex" && storage.metadata["priority"] != float64(2) {
+					t.Fatal("SetMetadata received configured behavior")
+				}
+			})
+		}
+	}
+}
+
+func TestKeyAllowlistOAuthOverrideCodexNativeDisabled(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "login.json")
+	disk := []byte(`{"type":"codex","email":"person@example.invalid","access_token":"fake-original","disabled":true,"priority":2}`)
+	if err := os.WriteFile(path, disk, 0600); err != nil {
+		t.Fatal(err)
+	}
+	before := map[string]any{"type": "codex", "access_token": "fake-original", "disabled": false, "priority": float64(2)}
+	auth := &coreauth.Auth{ID: "login.json", FileName: "login.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "fake-refreshed", "disabled": false, "priority": float64(9)}}
+	auth.BindOAuthOverrideOriginal(map[string]any{"priority": float64(2)})
+	auth.CodexRefreshPatch = codex.NewCredentialRefreshPatch(before, auth.Metadata, true, false)
+	store := NewFileTokenStore()
+	store.SetBaseDir(dir)
+	if _, err := store.Save(context.Background(), auth); err != nil {
+		t.Fatal(err)
+	}
+	if !auth.Disabled || auth.Metadata["disabled"] != true {
+		t.Fatal("native disk disabled state lost")
+	}
+	if auth.CodexRefreshPatch != nil || auth.Metadata["priority"] != float64(9) {
+		t.Fatal("refresh patch or runtime priority incorrect")
+	}
+}
