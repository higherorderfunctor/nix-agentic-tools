@@ -0,0 +1,52 @@
+package synthesizer
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func applyOAuthCredentialOverrides(cfg *config.Config, metadata map[string]any) (map[string]any, error) {
+	if cfg == nil {
+		return nil, nil
+	}
+	provider, _ := metadata["type"].(string)
+	provider = strings.ToLower(strings.TrimSpace(provider))
+	if provider == "gemini" {
+		provider = "gemini-cli"
+	}
+	// The watcher marks file-synthesized records OAuth, overriding stale file kind metadata.
+	probe := &coreauth.Auth{Provider: provider, Metadata: metadata, Attributes: map[string]string{coreauth.AttributeAuthKind: coreauth.AuthKindOAuth}}
+	kind, email := probe.AccountInfo()
+	if kind != "oauth" || email == "" {
+		return nil, nil
+	}
+	var original map[string]any
+	for _, entry := range cfg.OAuthCredentialOverrides {
+		if !strings.EqualFold(strings.TrimSpace(entry.Provider), strings.TrimSpace(provider)) || strings.TrimSpace(entry.Account) != email {
+			continue
+		}
+		raw, err := json.Marshal(entry)
+		if err != nil {
+			return nil, err
+		}
+		var values map[string]any
+		if err = json.Unmarshal(raw, &values); err != nil {
+			return nil, err
+		}
+		delete(values, "provider")
+		delete(values, "account")
+		if original == nil {
+			original = make(map[string]any)
+		}
+		for key, value := range values {
+			if _, captured := original[key]; !captured {
+				original[key] = metadata[key]
+			}
+			metadata[key] = value
+		}
+	}
+	return original, nil
+}
