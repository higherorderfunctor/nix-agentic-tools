+package handlers
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type passthroughRouterTrap struct{ calls int }
+
+func (r *passthroughRouterTrap) HasModelRouters() bool { return true }
+func (r *passthroughRouterTrap) RouteModel(context.Context, pluginapi.ModelRouteRequest) (pluginapi.ModelRouteResponse, bool) {
+	r.calls++
+	return pluginapi.ModelRouteResponse{Handled: true, TargetKind: pluginapi.ModelRouteTargetProvider, Target: "chat", TargetModel: "redirected"}, true
+}
+
+// Raw requests cannot be redirected to a chat provider, even when their alias
+// collides with a configured router target. Chat entries exclude all raw groups.
+func TestPassthroughProtocolRouting(t *testing.T) {
+	router := &passthroughRouterTrap{}
+	h := &BaseAPIHandler{ModelRouterHost: router}
+	decision := h.applyModelRouter(context.Background(), coreexecutor.PassthroughProtocol, "decision", []byte(`{"model":"decision"}`), false, modelExecutionOptions{})
+	if router.calls != 0 || decision != (modelRouteDecision{}) {
+		t.Fatal("raw route invoked model router")
+	}
+	providers := []string{"chat", "passthrough-free", "gemini-interactions", "passthrough-paid"}
+	if got := adjustExecutionProvidersForEntryProtocol(coreexecutor.PassthroughProtocol, providers); !reflect.DeepEqual(got, []string{"passthrough-free", "passthrough-paid"}) {
+		t.Fatalf("raw providers=%v", got)
+	}
+	for _, entry := range []string{"claude", "gemini", "interactions", "openai", "openai-response", "openai-image", "openai-speech"} {
+		for _, provider := range adjustExecutionProvidersForEntryProtocol(entry, providers) {
+			if provider == "passthrough-free" || provider == "passthrough-paid" {
+				t.Errorf("%s can select raw provider", entry)
+			}
+		}
+	}
+}
