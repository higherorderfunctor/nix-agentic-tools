@@ -0,0 +1,96 @@
+package cliproxy
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	runtimeexecutor "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// Config synthesis is the production caller of executor and model registration.
+// Reload must replace both the endpoint and aliases; removal retires models and
+// the old executor instead of falling through to compatibility execution.
+func TestPassthroughServiceReloadRemoval(t *testing.T) {
+	var path, body string
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		path = r.URL.Path
+		data, _ := io.ReadAll(r.Body)
+		body = string(data)
+		_, _ = io.WriteString(w, `{"answers":[]}`)
+	}))
+	defer upstream.Close()
+	cfg := &config.Config{Passthrough: []internalconfig.Passthrough{{Name: "reload", BaseURL: upstream.URL, Path: "/old", APIKeyEntries: []internalconfig.PassthroughKey{{APIKey: "key"}}, Models: []internalconfig.PassthroughModel{{Name: "old-model", Alias: "old-alias"}}}}}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.SetRetryConfig(0, 0, 0)
+	service := &Service{cfg: cfg, coreManager: manager}
+	service.registerConfigAPIKeyAuths(context.Background(), cfg)
+	auths := manager.List()
+	if len(auths) != 1 {
+		t.Fatalf("auths=%d", len(auths))
+	}
+	id := auths[0].ID
+	reg := registry.GetGlobalRegistry()
+	t.Cleanup(func() { reg.UnregisterClient(id) })
+	e, ok := manager.Executor("passthrough-reload")
+	if !ok {
+		t.Fatal("missing executor")
+	}
+	if _, ok := e.(*runtimeexecutor.PassthroughExecutor); !ok {
+		t.Fatalf("compatibility fallback: %T", e)
+	}
+	opts := coreexecutor.Options{SourceFormat: translator.FromString(coreexecutor.PassthroughProtocol)}
+	if _, err := manager.Execute(context.Background(), []string{"passthrough-reload"}, coreexecutor.Request{Model: "old-alias", Payload: []byte(`{"model":"old-alias"}`)}, opts); err != nil {
+		t.Fatal(err)
+	}
+	if path != "/old" || body != `{"model":"old-model"}` {
+		t.Fatalf("old route: %s %s", path, body)
+	}
+	next := *cfg
+	next.Passthrough = append([]internalconfig.Passthrough(nil), cfg.Passthrough...)
+	next.Passthrough[0].Path = "/new"
+	next.Passthrough[0].Models = []internalconfig.PassthroughModel{{Name: "new-model", Alias: "new-alias"}}
+	service.cfgMu.Lock()
+	service.cfg = &next
+	service.cfgMu.Unlock()
+	manager.SetConfig(&next)
+	service.registerConfigAPIKeyAuths(context.Background(), &next)
+	if models := reg.GetModelsForClient(id); len(models) != 1 || models[0].ID != "new-alias" {
+		t.Fatalf("stale registry: %+v", models)
+	}
+	if len(reg.GetModelProviders("old-alias")) != 0 {
+		t.Fatal("old alias survived reload")
+	}
+	if _, err := manager.Execute(context.Background(), []string{"passthrough-reload"}, coreexecutor.Request{Model: "new-alias", Payload: []byte(`{"model":"new-alias"}`)}, opts); err != nil {
+		t.Fatal(err)
+	}
+	if path != "/new" || body != `{"model":"new-model"}` {
+		t.Fatalf("stale endpoint/model: %s %s", path, body)
+	}
+	removed := &config.Config{}
+	service.cfgMu.Lock()
+	service.cfg = removed
+	service.cfgMu.Unlock()
+	manager.SetConfig(removed)
+	service.registerAvailableExecutors(context.Background(), executorRegistrationOptions{auths: manager.List(), forceReplaceAuths: true})
+	service.applyCoreAuthRemoval(context.Background(), id)
+	service.registerConfigAPIKeyAuths(context.Background(), removed)
+	if len(reg.GetModelProviders("new-alias")) != 0 {
+		t.Fatal("removed models remain selectable")
+	}
+	if _, ok := manager.Executor("passthrough-reload"); ok {
+		t.Fatal("removed executor retained")
+	}
+	if len(manager.List()) != 0 {
+		t.Fatal("removed config credential retained")
+	}
+}
