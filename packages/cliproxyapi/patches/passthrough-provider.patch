diff --git a/internal/watcher/synthesizer/passthrough.go b/internal/watcher/synthesizer/passthrough.go
new file mode 100644
index 0000000..371c760
--- /dev/null
+++ b/internal/watcher/synthesizer/passthrough.go
@@ -0,0 +1,52 @@
+package synthesizer
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func (s *ConfigSynthesizer) synthesizePassthrough(ctx *SynthesisContext) []*coreauth.Auth {
+	var out []*coreauth.Auth
+	for i, group := range ctx.Config.Passthrough {
+		if group.Disabled {
+			continue
+		}
+		provider := group.ProviderKey()
+		// The watcher compares attributes. Path, models and policy changes must replace
+		// the old auth even though its credential identity stays stable across reloads.
+		keys := group.APIKeyEntries
+		group.APIKeyEntries = nil
+		raw, _ := json.Marshal(group)
+		hash := sha256.Sum256(raw)
+		for j, key := range keys {
+			id, token := ctx.IDGenerator.Next(provider, key.APIKey, group.BaseURL)
+			attrs := map[string]string{
+				"api_key":          key.APIKey,
+				"base_url":         group.BaseURL,
+				"config_hash":      hex.EncodeToString(hash[:]),
+				"config_index":     strconv.Itoa(i),
+				"key_index":        strconv.Itoa(j),
+				"passthrough_path": group.Path,
+				"priority":         strconv.Itoa(group.Priority),
+				"provider_key":     provider,
+				"source":           fmt.Sprintf("config:%s[%s]", provider, token),
+			}
+			metadata := map[string]any{}
+			if group.DisableCooling != nil {
+				metadata["disable_cooling"] = *group.DisableCooling
+			}
+			addRequestRetryToMetadata(group.RequestRetry, metadata)
+			addRequestScopedErrorsToMetadata(group.RequestScopedErrors, metadata)
+			out = append(out, &coreauth.Auth{
+				ID: id, Provider: provider, Label: group.Name, Status: coreauth.StatusActive,
+				Attributes: attrs, Metadata: metadata, CreatedAt: ctx.Now, UpdatedAt: ctx.Now,
+			})
+		}
+	}
+	return out
+}
