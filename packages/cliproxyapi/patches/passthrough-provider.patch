+)
+
+const passthroughConfig = `config-version: 8
+api-keys:
+  passthrough:
+    - name: primary
+      base-url: https://upstream.example/base
+      path: /inference/v1/decision
+      priority: 30
+      request-retry: 0
+      disable-cooling: false
+      request-scoped-errors: [{status: 429}]
+      models: [{name: upstream-model, alias: decision}]
+      keys: [{api-key: first}, {api-key: second}]
+`
+
+// Losing group-only fields, flattening credentials or failing to rename keys
+// breaks this roundtrip through both real load boundaries and v8 serialization.
+func TestPassthroughV8RoundTrip(t *testing.T) {
+	cfg, err := ParseConfigBytes([]byte(passthroughConfig))
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := cfg.Passthrough[0]
+	if g.Name != "primary" || g.BaseURL != "https://upstream.example/base" || g.Path != "/inference/v1/decision" || g.Priority != 30 || g.RequestRetry == nil || *g.RequestRetry != 0 || g.DisableCooling == nil || *g.DisableCooling || len(g.RequestScopedErrors) != 1 || len(g.APIKeyEntries) != 2 || g.APIKeyEntries[1].APIKey != "second" || g.Models[0].Alias != "decision" {
+		t.Fatal("v8 group fields were dropped")
+	}
+	raw, err := yaml.Marshal(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, err := ParseConfigBytes(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Passthrough, again.Passthrough) {
+		t.Fatal("serialized group changed")
+	}
+	file := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(file, []byte(passthroughConfig), 0600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := LoadConfigOptional(file, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Passthrough, loaded.Passthrough) {
+		t.Fatal("startup load disagrees with parse")
+	}
+	if (Passthrough{Name: " Passthrough-Primary "}).ProviderKey() != "passthrough-passthrough-primary" {
+		t.Fatal("prefix must always be added")
+	}
+}
+
+// Aliases and merge keys must have the same meaning at both load boundaries.
+func TestPassthroughAliasesAndMergeKeys(t *testing.T) {
+	cases := []struct{ name, definitions, group string }{
+		{"aliased group", "shared: &group {name: primary, base-url: 'https://upstream.example/base', path: /inference/v1/decision, models: [{name: upstream-model, alias: decision}], keys: [{api-key: first}, {api-key: second}]}\n", "    - *group\n"},
+		{"aliased keys", "shared: &keys [{api-key: first}, {api-key: second}]\n", "    - {name: primary, base-url: 'https://upstream.example/base', path: /inference/v1/decision, models: [{name: upstream-model, alias: decision}], keys: *keys}\n"},
+		{"merged group", "shared: &group {base-url: 'https://upstream.example/base', path: /inference/v1/decision, models: [{name: upstream-model, alias: decision}], keys: [{api-key: first}, {api-key: second}]}\n", "    - {<<: *group, name: primary}\n"},
+	}
+	want := []Passthrough{{
+		Name: "primary", BaseURL: "https://upstream.example/base", Path: "/inference/v1/decision",
+		APIKeyEntries: []PassthroughKey{{APIKey: "first"}, {APIKey: "second"}},
+		Models:        []PassthroughModel{{Name: "upstream-model", Alias: "decision"}},
+	}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			data := []byte("config-version: 8\n" + tc.definitions + "api-keys:\n  passthrough:\n" + tc.group)
+			file := filepath.Join(t.TempDir(), "config.yaml")
+			if err := os.WriteFile(file, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for _, load := range []func() (*Config, error){func() (*Config, error) { return ParseConfigBytes(data) }, func() (*Config, error) { return LoadConfigOptional(file, true) }} {
+				cfg, err := load()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !reflect.DeepEqual(cfg.Passthrough, want) {
+					t.Fatalf("expanded groups = %#v, want %#v", cfg.Passthrough, want)
+				}
+			}
+		})
+	}
+}
+
+// Optional loading suppresses unrelated YAML decode errors and returns an empty config.
+func TestPassthroughOptionalLoadUnrelatedMalformedYAML(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(file, []byte("host: localhost\nhost: localhost\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := LoadConfigOptional(file, true)
+	if err != nil {
+		t.Fatalf("optional loading must suppress unrelated decode errors: %v", err)
+	}
+	if cfg == nil || cfg.Host != "" || len(cfg.Passthrough) != 0 {
+		t.Fatalf("optional loading must return an empty config, got %#v", cfg)
+	}
+}
+
+// Every refusal reaches optional startup loading as well as management parsing;
+// diagnostics must never reveal the supplied URL, path or credential.
+func TestPassthroughRejectsInvalidConfig(t *testing.T) {
+	cases := []struct{ name, old, replacement, field string }{
+		{"absolute path", "/inference/v1/decision", "https://private.invalid/sensitive", "path"},
+		{"blank key", "api-key: first", "api-key: ' '", "keys[0].api-key"},
+		{"empty keys", "keys: [{api-key: first}, {api-key: second}]", "keys: []", "keys"},
+		{"empty models", "models: [{name: upstream-model, alias: decision}]", "models: []", "models"},
+		{"empty name", "name: primary", "name: ''", "name"},
+		{"fragment", "/inference/v1/decision", "/sensitive#private", "path"},
+		{"model name", "name: upstream-model", "name: ''", "models[0].name"},
+		{"network path", "/inference/v1/decision", "//private.invalid/sensitive", "path"},
+		{"non HTTP", "https://upstream.example/base", "ftp://private.invalid/sensitive", "base-url"},
+		{"query", "https://upstream.example/base", "https://private.invalid/?sensitive", "base-url"},
+		{"relative base", "https://upstream.example/base", "/sensitive", "base-url"},
+		{"typed key", "api-key: first", "api-key: {}", "group field type"},
+		{"userinfo", "https://upstream.example/base", "https://sensitive@private.invalid", "base-url"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			data := []byte(strings.Replace(passthroughConfig, tc.old, tc.replacement, 1))
+			file := filepath.Join(t.TempDir(), "config.yaml")
+			if err := os.WriteFile(file, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for _, load := range []func() (*Config, error){func() (*Config, error) { return ParseConfigBytes(data) }, func() (*Config, error) { return LoadConfigOptional(file, true) }} {
+				_, err := load()
+				if err == nil || !strings.Contains(err.Error(), tc.field) {
+					t.Fatalf("expected field refusal %s, got %v", tc.field, err)
+				}
+				if strings.Contains(err.Error(), "sensitive") || strings.Contains(err.Error(), "private.invalid") {
+					t.Fatal("diagnostic leaked supplied value")
+				}
+			}
+		})
+	}
+	duplicate := passthroughConfig + `    - name: PRIMARY
+      base-url: https://other.example
+      path: /decision
+      models: [{name: model}]
+      keys: [{api-key: third}]
+`
+	if _, err := ParseConfigBytes([]byte(duplicate)); err == nil || !strings.Contains(err.Error(), "[1].name") {
+		t.Fatal("duplicate normalized group name accepted")
+	}
+}
