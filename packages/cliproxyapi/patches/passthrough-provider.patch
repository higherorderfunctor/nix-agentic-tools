diff --git a/internal/config/passthrough.go b/internal/config/passthrough.go
new file mode 100644
index 0000000..943ea5e
--- /dev/null
+++ b/internal/config/passthrough.go
@@ -0,0 +1,147 @@
+package config
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Passthrough configures one keyed JSON upstream, independently of chat providers.
+type Passthrough struct {
+	// APIKeyEntries contains at least one nonempty upstream credential.
+	APIKeyEntries []PassthroughKey `yaml:"api-key-entries" json:"api-key-entries"`
+	// BaseURL is an HTTP(S) base without userinfo, query or fragment.
+	BaseURL string `yaml:"base-url" json:"base-url"`
+	// DisableCooling overrides the global cooling policy when present.
+	DisableCooling *bool `yaml:"disable-cooling,omitempty" json:"disable-cooling,omitempty"`
+	// Disabled prevents synthesis while preserving the group's configuration.
+	Disabled bool `yaml:"disabled,omitempty" json:"disabled,omitempty"`
+	// Models maps client aliases to upstream model names.
+	Models []PassthroughModel `yaml:"models" json:"models"`
+	// Name identifies a group, case-insensitively, even when groups share a URL.
+	Name string `yaml:"name" json:"name"`
+	// Path is a relative or rooted upstream path without authority, query or fragment.
+	Path string `yaml:"path" json:"path"`
+	// Priority prefers higher values among eligible credentials.
+	Priority int `yaml:"priority,omitempty" json:"priority,omitempty"`
+	// RequestRetry overrides retry rounds; nil or negative inherits the global value.
+	RequestRetry *int `yaml:"request-retry,omitempty" json:"request-retry,omitempty"`
+	// RequestScopedErrors uses native upstream error classification rules.
+	RequestScopedErrors []RequestScopedErrorRule `yaml:"request-scoped-errors,omitempty" json:"request-scoped-errors,omitempty"`
+}
+
+// PassthroughKey supplies Bearer authentication for one group credential.
+type PassthroughKey struct {
+	APIKey string `yaml:"api-key" json:"api-key"`
+}
+
+// PassthroughModel exposes only an upstream name and an optional client alias.
+type PassthroughModel struct {
+	Alias string `yaml:"alias,omitempty" json:"alias,omitempty"`
+	Name  string `yaml:"name" json:"name"`
+}
+
+// GetForceMapping keeps upstream responses unchanged; aliases rewrite only requests.
+func (m PassthroughModel) GetForceMapping() bool { return false }
+
+func (m PassthroughModel) GetAlias() string { return m.Alias }
+func (m PassthroughModel) GetName() string  { return m.Name }
+
+// ProviderKey always prefixes the normalized group name, including an existing prefix.
+func (g Passthrough) ProviderKey() string {
+	return "passthrough-" + strings.ToLower(strings.TrimSpace(g.Name))
+}
+
+// PassthroughGroup binds an auth's index to its identity, never the first shared URL.
+func (cfg *Config) PassthroughGroup(provider, index string) *Passthrough {
+	i, err := strconv.Atoi(index)
+	if cfg == nil || err != nil || i < 0 || i >= len(cfg.Passthrough) {
+		return nil
+	}
+	g := &cfg.Passthrough[i]
+	if g.Disabled || g.ProviderKey() != provider {
+		return nil
+	}
+	return g
+}
+
+// ValidatePassthrough rejects unusable groups without including resolved secrets in errors.
+func (cfg *Config) ValidatePassthrough() error {
+	seen := map[string]bool{}
+	for i := range cfg.Passthrough {
+		g := &cfg.Passthrough[i]
+		bad := func(field string) error { return fmt.Errorf("api-keys.passthrough[%d].%s: invalid value", i, field) }
+		g.Name = strings.TrimSpace(g.Name)
+		if g.Name == "" || seen[g.ProviderKey()] {
+			return bad("name")
+		}
+		seen[g.ProviderKey()] = true
+		base, err := url.Parse(g.BaseURL)
+		if err != nil || (base.Scheme != "http" && base.Scheme != "https") || base.Hostname() == "" || base.User != nil || base.RawQuery != "" || base.ForceQuery || base.Fragment != "" || strings.ContainsAny(g.BaseURL, "?#") {
+			return bad("base-url")
+		}
+		path, err := url.Parse(g.Path)
+		// Absolute URLs and network-path references can replace the configured authority.
+		if err != nil || strings.TrimSpace(g.Path) == "" || path.IsAbs() || path.Host != "" || strings.HasPrefix(g.Path, "//") || path.RawQuery != "" || path.ForceQuery || path.Fragment != "" || strings.ContainsAny(g.Path, "?#") {
+			return bad("path")
+		}
+		if len(g.APIKeyEntries) == 0 {
+			return bad("keys")
+		}
+		for j := range g.APIKeyEntries {
+			g.APIKeyEntries[j].APIKey = strings.TrimSpace(g.APIKeyEntries[j].APIKey)
+			if g.APIKeyEntries[j].APIKey == "" {
+				return bad(fmt.Sprintf("keys[%d].api-key", j))
+			}
+		}
+		if len(g.Models) == 0 {
+			return bad("models")
+		}
+		for j := range g.Models {
+			g.Models[j].Name = strings.TrimSpace(g.Models[j].Name)
+			g.Models[j].Alias = strings.TrimSpace(g.Models[j].Alias)
+			if g.Models[j].Name == "" {
+				return bad(fmt.Sprintf("models[%d].name", j))
+			}
+		}
+	}
+	return nil
+}
+
+// Check this family before optional loading can suppress YAML/type errors. Other
+// decode errors keep the loader's existing policy; a decodable family fails closed.
+func validatePassthroughYAML(data []byte) error {
+	var doc yaml.Node
+	if yaml.Unmarshal(data, &doc) != nil || len(doc.Content) == 0 {
+		return nil
+	}
+	root := doc.Content[0]
+	// Leave invalid/cyclic aliases and duplicate keys to the ordinary loader.
+	// Decode before expanding aliases and merges into the nodes expandV8Groups needs.
+	var shape map[string]any
+	if err := root.Decode(&shape); err != nil {
+		return nil
+	}
+	root = expandConfigAliases(root)
+	groups := yamlPath(root, "api-keys.passthrough")
+	if groups == nil {
+		groups = yamlPath(root, "passthrough")
+	} else {
+		expanded, err := expandV8Groups(groups, "passthrough")
+		if err != nil {
+			return fmt.Errorf("api-keys.passthrough: invalid groups or keys")
+		}
+		groups = expanded
+	}
+	if groups == nil {
+		return nil
+	}
+	var cfg Config
+	if err := groups.Decode(&cfg.Passthrough); err != nil {
+		return fmt.Errorf("api-keys.passthrough: invalid group field type")
+	}
+	return cfg.ValidatePassthrough()
+}
