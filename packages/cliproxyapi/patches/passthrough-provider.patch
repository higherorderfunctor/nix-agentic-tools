+package api
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	management "github.com/router-for-me/CLIProxyAPI/v8/internal/api/handlers/management"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/redisqueue"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher/synthesizer"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+// These are production-shaped default-port URLs. DialContext connects them to
+// httptest's random bound ports without changing Host, authority or URL path.
+// This exercises HTTP routing/transport, but cannot prove actual port-80 binding.
+func TestPassthroughRouteConductorUsage(t *testing.T) {
+	var mu sync.Mutex
+	var calls []string
+	response := " {\n \"model\":\"final-model\", \"answers\":[], \"usage\":{\"input_tokens\":7,\"output_tokens\":3} }\n"
+	raw := " {\n \"model\" : \"decision\", \"state\": {\"model\":\"nested\"}, \"questions\": [] }\n"
+	upstream := func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		if strings.Contains(r.Host, ":") {
+			t.Errorf("default-port Host includes port: %q", r.Host)
+		}
+		if r.Header.Get("Content-Type") != "application/json" {
+			t.Error("missing JSON content type")
+		}
+		key := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		model := map[string]string{"/inference/free": "free-model", "/inference/paid": "paid-model", "/inference/final": "final-model"}[r.URL.Path]
+		want := strings.Replace(raw, `"decision"`, `"`+model+`"`, 1)
+		if string(body) != want {
+			t.Errorf("changed request bytes: %q, want %q", body, want)
+		}
+		mu.Lock()
+		calls = append(calls, key)
+		mu.Unlock()
+		switch key {
+		case "free-a":
+			w.Header().Set("Retry-After", "120")
+			w.WriteHeader(429)
+		case "free-b":
+			w.WriteHeader(404)
+		case "paid":
+			w.WriteHeader(503)
+		case "final":
+			_, _ = io.WriteString(w, response)
+		default:
+			t.Error("unexpected upstream key")
+			w.WriteHeader(401)
+		}
+	}
+	first := httptest.NewServer(http.HandlerFunc(upstream))
+	defer first.Close()
+	second := httptest.NewServer(http.HandlerFunc(upstream))
+	defer second.Close()
+	dialer := &net.Dialer{}
+	transport := &http.Transport{DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+		target := strings.TrimPrefix(first.URL, "http://")
+		if address == "second.example:80" {
+			target = strings.TrimPrefix(second.URL, "http://")
+		} else if address != "first.example:80" {
+			t.Errorf("unexpected destination %s", address)
+		}
+		return dialer.DialContext(ctx, network, target)
+	}}
+	defer transport.CloseIdleConnections()
+	zero, cooling := 0, false
+	cfg := &config.Config{SDKConfig: sdkconfig.SDKConfig{APIKeys: []string{"client-a", "client-b", "unlisted"}}, Passthrough: []config.Passthrough{
+		{Name: "free", BaseURL: "http://first.example", Path: "/inference/free", Priority: 30, RequestRetry: &zero, DisableCooling: &cooling, APIKeyEntries: []config.PassthroughKey{{APIKey: "free-a"}, {APIKey: "free-b"}}, Models: []config.PassthroughModel{{Name: "free-model", Alias: "decision"}}},
+		{Name: "paid", BaseURL: "http://second.example", Path: "/inference/paid", Priority: 20, RequestRetry: &zero, DisableCooling: &cooling, APIKeyEntries: []config.PassthroughKey{{APIKey: "paid"}}, Models: []config.PassthroughModel{{Name: "paid-model", Alias: "decision"}}},
+		{Name: "final", BaseURL: "http://second.example", Path: "/inference/final", Priority: 10, RequestRetry: &zero, DisableCooling: &cooling, APIKeyEntries: []config.PassthroughKey{{APIKey: "final"}}, Models: []config.PassthroughModel{{Name: "final-model", Alias: "decision"}}},
+	}}
+	for _, key := range []string{"client-a", "client-b"} {
+		cfg.KeyAllowlist = append(cfg.KeyAllowlist, config.KeyAllowlist{APIKey: key, Credentials: []config.KeyAllowlistCredential{{Provider: "passthrough-free", Kind: "apikey"}, {Provider: "passthrough-paid", Kind: "apikey"}, {Provider: "passthrough-final", Kind: "apikey"}}})
+	}
+	server := newTestServerWithConfig(t, cfg)
+	manager := server.handlers.AuthManager
+	manager.SetConfig(cfg)
+	// Zero retry rounds and interval, unlimited alternative credentials. A zero
+	// request-retry never disables trying another eligible credential in-request.
+	manager.SetRetryConfig(0, 0, 0)
+	auths, err := synthesizer.NewConfigSynthesizer().Synthesize(&synthesizer.SynthesisContext{Config: cfg, Now: time.Now(), IDGenerator: synthesizer.NewStableIDGenerator()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	reg := registry.GetGlobalRegistry()
+	for _, auth := range auths {
+		if !strings.HasPrefix(auth.Provider, "passthrough-") {
+			continue
+		}
+		reg.RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: "decision", Type: "passthrough"}})
+		id := auth.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		manager.RegisterExecutor(executor.NewPassthroughExecutor(auth.Provider, cfg))
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatal(err)
+		}
+	}
+	prevEnabled, prevStatistics := redisqueue.Enabled(), redisqueue.UsageStatisticsEnabled()
+	redisqueue.SetEnabled(false)
+	redisqueue.SetEnabled(true)
+	redisqueue.SetUsageStatisticsEnabled(true)
+	defer func() {
+		redisqueue.SetEnabled(false)
+		redisqueue.SetEnabled(prevEnabled)
+		redisqueue.SetUsageStatisticsEnabled(prevStatistics)
+	}()
+	coreusage.StartDefault(context.Background())
+	request := func(path, key, payload string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(http.MethodPost, "http://proxy.example"+path, strings.NewReader(payload))
+		req = req.WithContext(context.WithValue(req.Context(), "cliproxy.roundtripper", transport))
+		req.Header.Set("Content-Type", "application/json")
+		if key != "" {
+			req.Header.Set("Authorization", "Bearer "+key)
+		}
+		out := httptest.NewRecorder()
+		server.engine.ServeHTTP(out, req)
+		return out
+	}
+	for _, tc := range []struct {
+		key    string
+		status int
+	}{{"", 401}, {"unlisted", 503}} {
+		out := request("/v1/passthrough", tc.key, raw)
+		if out.Code != tc.status {
+			t.Fatalf("client %q: %d %s", tc.key, out.Code, out.Body.String())
+		}
+	}
+	for _, bad := range []string{`[]`, `{"model":"decision","model":"other"}`, `{"model":"decision","stream":null}`, `{"model":"decision","stream":true}`, `{"model":3}`, `{"model":" "}`} {
+		if out := request("/v1/passthrough", "client-a", bad); out.Code != 400 {
+			t.Fatalf("invalid request: %d %s", out.Code, out.Body.String())
+		}
+	}
+	mu.Lock()
+	before := len(calls)
+	mu.Unlock()
+	if before != 0 {
+		t.Fatal("unauthorized/invalid input reached upstream")
+	}
+	for _, key := range []string{"client-a", "client-b"} {
+		out := request("/v1/passthrough", key, raw)
+		if out.Code != 200 || out.Body.String() != response {
+			t.Fatalf("raw response: %d %q", out.Code, out.Body.String())
+		}
+	}
+	mu.Lock()
+	got := append([]string(nil), calls...)
+	mu.Unlock()
+	if len(got) != 5 || !((got[0] == "free-a" && got[1] == "free-b") || (got[0] == "free-b" && got[1] == "free-a")) || !reflect.DeepEqual(got[2:], []string{"paid", "final", "final"}) {
+		t.Fatalf("priority/failover/cooldown order: %v", got)
+	}
+	for _, auth := range auths {
+		if auth.Provider == "passthrough-free" || auth.Provider == "passthrough-paid" {
+			current, ok := manager.GetByID(auth.ID)
+			if !ok || current.ModelStates["decision"] == nil || current.ModelStates["decision"].NextRetryAfter.IsZero() {
+				t.Errorf("no native cooldown for %s", auth.Provider)
+			}
+		}
+	}
+	// Generic management usage queue must retain two client identities for one
+	// shared alias, and attribute tokens only to their successful attempts.
+	type record struct {
+		APIKey   string `json:"api_key"`
+		Alias    string `json:"alias"`
+		Model    string `json:"model"`
+		Provider string `json:"provider"`
+		Endpoint string `json:"endpoint"`
+		Failed   bool   `json:"failed"`
+		Tokens   struct {
+			Input  int `json:"input_tokens"`
+			Output int `json:"output_tokens"`
+		} `json:"tokens"`
+	}
+	var records []record
+	deadline := time.Now().Add(3 * time.Second)
+	for len(records) < 5 && time.Now().Before(deadline) {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest("GET", "/usage/queue?count=20", nil)
+		(&management.Handler{}).GetUsageQueue(c)
+		var batch []record
+		if err := json.Unmarshal(w.Body.Bytes(), &batch); err != nil {
+			t.Fatal(err)
+		}
+		records = append(records, batch...)
+		if len(records) < 5 {
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	successes := map[string]int{}
+	failures := 0
+	for _, rec := range records {
+		if rec.Alias != "decision" || rec.Endpoint != "POST /v1/passthrough" {
+			t.Fatalf("lost request identity: %+v", rec)
+		}
+		if rec.Failed {
+			failures++
+			if rec.APIKey != "client-a" || rec.Tokens.Input != 0 || rec.Tokens.Output != 0 {
+				t.Fatalf("failure attribution: %+v", rec)
+			}
+			continue
+		}
+		if rec.Provider != "passthrough-final" || rec.Model != "final-model" || rec.Tokens.Input != 7 || rec.Tokens.Output != 3 {
+			t.Fatalf("success attribution: %+v", rec)
+		}
+		successes[rec.APIKey]++
+	}
+	if failures != 3 || !reflect.DeepEqual(successes, map[string]int{"client-a": 1, "client-b": 1}) {
+		t.Fatalf("management records: failures=%d successes=%v count=%d", failures, successes, len(records))
+	}
+	// Every chat path must exclude this provider, even for an allowlisted key.
+	for _, path := range []string{"/v1/chat/completions", "/v1/messages", "/v1/responses"} {
+		if out := request(path, "client-a", raw); out.Code == 200 {
+			t.Errorf("raw provider reachable via %s", path)
+		}
+	}
+	mu.Lock()
+	after := len(calls)
+	mu.Unlock()
+	if after != 5 {
+		t.Fatalf("chat route reached passthrough: %v", calls)
+	}
+	// Internal registration may outlive a credential; that must never bypass
+	// selection when the conductor has no credentials left.
+	for _, a := range auths {
+		manager.Remove(context.Background(), a.ID)
+	}
+	if out := request("/v1/passthrough", "client-a", raw); out.Code == 200 {
+		t.Fatal("executed without credentials")
+	}
+}
+
+// Ensure the fixture really uses the provider executor, not a fake executor
+// which could make a direct HTTP bypass look like conductor failover.
+var _ coreauth.ProviderExecutor = (*executor.PassthroughExecutor)(nil)
