@@ -0,0 +1,66 @@
+package config
+
+import (
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+// A flattened-key implementation loses compatibility-only group fields or
+// splits a group's credentials. Compare both transformations with an explicit
+// legacy shape, including a keyless group and distinct groups sharing a URL.
+func TestV8GroupedFamilyRoundTrip(t *testing.T) {
+	const grouped = `
+- name: primary
+  base-url: https://upstream.example/v1
+  codex-shell-arg-cleanup: true
+  headers: {X-Group: primary}
+  models: [{name: upstream, alias: client}]
+  priority: 30
+  request-retry: 0
+  keys:
+    - api-key: first
+      proxy-url: http://proxy.example
+      weight: 2
+    - api-key: second
+- name: secondary
+  base-url: https://upstream.example/v1
+  keys: []
+`
+	const legacy = `
+- name: primary
+  base-url: https://upstream.example/v1
+  codex-shell-arg-cleanup: true
+  headers: {X-Group: primary}
+  models: [{name: upstream, alias: client}]
+  priority: 30
+  request-retry: 0
+  api-key-entries:
+    - api-key: first
+      proxy-url: http://proxy.example
+      weight: 2
+    - api-key: second
+- name: secondary
+  base-url: https://upstream.example/v1
+  api-key-entries: []
+`
+	decode := func(raw string) *yaml.Node {
+		t.Helper()
+		var doc yaml.Node
+		if err := yaml.Unmarshal([]byte(raw), &doc); err != nil {
+			t.Fatal(err)
+		}
+		return doc.Content[0]
+	}
+	expanded, err := expandV8Groups(decode(grouped), "openai-compatibility")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !nodesStructurallyEqual(expanded, decode(legacy)) {
+		t.Fatal("compatibility loading changed the legacy grouped shape")
+	}
+	serialized := groupLegacyKeys(decode(legacy), "openai-compatibility")
+	if !nodesStructurallyEqual(serialized, decode(grouped)) {
+		t.Fatal("compatibility serialization changed the v8 grouped shape")
+	}
+}
