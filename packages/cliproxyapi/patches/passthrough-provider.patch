@@ -0,0 +1,123 @@
+package management
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher/synthesizer"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"gopkg.in/yaml.v3"
+)
+
+// GET projects a distinct live index for every group/key; the emitted index
+// then resolves the same credential through management api-call's $TOKEN$ path.
+func TestPassthroughManagementAuthIndex(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	raw := []byte(`config-version: 8
+api-keys:
+  passthrough:
+    - name: disabled
+      disabled: true
+      base-url: https://upstream.example
+      path: /decision
+      models: [{name: model}]
+      keys: [{api-key: ignored, auth_index: stale}]
+    - name: free
+      base-url: https://upstream.example
+      path: /decision
+      models: [{name: model}]
+      keys: [{api-key: shared}, {api-key: second}]
+    - name: paid
+      base-url: https://upstream.example
+      path: /paid
+      models: [{name: model}]
+      keys: [{api-key: shared}]
+`)
+	cfg, err := config.ParseConfigBytes(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(file, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	auths, err := synthesizer.NewConfigSynthesizer().Synthesize(&synthesizer.SynthesisContext{Config: cfg, Now: time.Now(), IDGenerator: synthesizer.NewStableIDGenerator()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	for _, a := range auths {
+		if _, err := manager.Register(context.Background(), a); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h := &Handler{cfg: cfg, configFilePath: file, authManager: manager}
+	router := gin.New()
+	router.GET("/v8/management/config/*path", h.ConfigV8)
+	router.POST("/v0/management/api-call", h.APICall)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/v8/management/config/api-keys/passthrough", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("GET status %d", response.Code)
+	}
+	var groups []struct {
+		Keys []struct {
+			AuthIndex string `yaml:"auth_index"`
+		} `yaml:"keys"`
+	}
+	if err := yaml.Unmarshal(response.Body.Bytes(), &groups); err != nil {
+		t.Fatal(err)
+	}
+	if len(groups) != 3 || len(groups[1].Keys) != 2 || len(groups[2].Keys) != 1 {
+		t.Fatal("group/key projection changed")
+	}
+	if groups[0].Keys[0].AuthIndex != "" {
+		t.Fatal("disabled group exposed stale auth index")
+	}
+	seen := map[string]bool{}
+	for _, group := range groups[1:] {
+		for _, key := range group.Keys {
+			if key.AuthIndex == "" || seen[key.AuthIndex] {
+				t.Fatal("missing or colliding auth index")
+			}
+			seen[key.AuthIndex] = true
+		}
+	}
+	for _, a := range manager.List() {
+		if !seen[a.Index] {
+			t.Fatal("projection does not expose live auth index")
+		}
+	}
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer second" {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer upstream.Close()
+	body, err := json.Marshal(map[string]any{"auth_index": groups[1].Keys[1].AuthIndex, "method": "POST", "url": upstream.URL, "header": map[string]string{"Authorization": "Bearer $TOKEN$"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	response = httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/v0/management/api-call", bytes.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(response, req)
+	var result apiCallResponse
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if response.Code != http.StatusOK || result.StatusCode != http.StatusNoContent {
+		t.Fatal("management auth_index selected the wrong credential")
+	}
+}
