+	return executor.Response{}, errors.New("unused")
+}
+func (e passthroughAliasExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("unused")
+}
+
+// Use real synthesized auths in the conductor: a shared URL/key must not resolve
+// the paid alias from the free group. A file-sourced fake apikey gets no grant.
+func TestPassthroughAliasAndAllowlist(t *testing.T) {
+	cfg := passthroughGroups()
+	cfg.KeyAllowlist = []config.KeyAllowlist{
+		{APIKey: "free-client", Credentials: []config.KeyAllowlistCredential{{Provider: "passthrough-free", Kind: "apikey"}}},
+		{APIKey: "paid-client", Credentials: []config.KeyAllowlistCredential{{Provider: "passthrough-paid", Kind: "apikey"}}},
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.SetRetryConfig(0, 0, 0)
+	reg := registry.GetGlobalRegistry()
+	for _, a := range passthroughAuths(t, cfg) {
+		reg.RegisterClient(a.ID, a.Provider, []*registry.ModelInfo{{ID: "decision"}})
+		id := a.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		manager.RegisterExecutor(passthroughAliasExecutor{a.Provider})
+		if _, err := manager.Register(context.Background(), a); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, tc := range []struct{ key, provider, want string }{
+		{"free-client", "passthrough-free", "free-upstream"},
+		{"paid-client", "passthrough-paid", "paid-upstream"},
+		{"unknown", "passthrough-free", ""},
+		{"free-client", "passthrough-paid", ""},
+	} {
+		t.Run(tc.key+"/"+tc.provider, func(t *testing.T) {
+			response, err := manager.Execute(usage.WithAPIKey(context.Background(), tc.key), []string{tc.provider}, executor.Request{Model: "decision"}, executor.Options{})
+			if tc.want == "" {
+				if err == nil {
+					t.Fatal("ungranted client selected a credential")
+				}
+				return
+			}
+			if err != nil || string(response.Payload) != tc.want {
+				t.Fatalf("alias result %q, error %v; want %q", response.Payload, err, tc.want)
+			}
+		})
+	}
+	fake := &coreauth.Auth{ID: "passthrough-file-fake", Provider: "passthrough-free", Attributes: map[string]string{"api_key": "fake", "source": "file:fake"}, Status: coreauth.StatusActive}
+	fakeManager := coreauth.NewManager(nil, nil, nil)
+	fakeManager.SetConfig(cfg)
+	fakeManager.RegisterExecutor(passthroughAliasExecutor{fake.Provider})
+	reg.RegisterClient(fake.ID, fake.Provider, []*registry.ModelInfo{{ID: "decision"}})
+	t.Cleanup(func() { reg.UnregisterClient(fake.ID) })
+	if _, err := fakeManager.Register(context.Background(), fake); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fakeManager.Execute(usage.WithAPIKey(context.Background(), "free-client"), []string{fake.Provider}, executor.Request{Model: "decision"}, executor.Options{}); err == nil {
+		t.Fatal("file API key matched config-only allowlist")
+	}
+	// Reordered config must not bind an old index to another group's models.
+	cfg.Passthrough[0], cfg.Passthrough[1] = cfg.Passthrough[1], cfg.Passthrough[0]
+	if cfg.PassthroughGroup("passthrough-free", "0") != nil {
+		t.Fatal("stale config index resolved another group")
+	}
+}
