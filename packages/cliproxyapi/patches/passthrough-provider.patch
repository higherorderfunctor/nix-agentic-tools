@@ -0,0 +1,68 @@
+package executor
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+)
+
+// PassthroughProtocol isolates raw JSON from every translated chat protocol.
+const PassthroughProtocol = "passthrough"
+
+// PassthroughBody validates the client object and optionally replaces only its
+// top-level model value. Duplicate model keys and streaming cannot be executed
+// unambiguously; nested model fields and all other bytes are preserved.
+func PassthroughBody(body []byte, upstream string) (string, []byte, error) {
+	bad := errors.New("passthrough requires a JSON object with one nonempty string model and no streaming")
+	d := json.NewDecoder(bytes.NewReader(body))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return "", nil, bad
+	}
+	model, start, end, seen := "", 0, 0, false
+	for d.More() {
+		key, err := d.Token()
+		if err != nil {
+			return "", nil, bad
+		}
+		before := int(d.InputOffset())
+		var value json.RawMessage
+		if d.Decode(&value) != nil {
+			return "", nil, bad
+		}
+		switch key {
+		case "model":
+			if seen || json.Unmarshal(value, &model) != nil || strings.TrimSpace(model) == "" {
+				return "", nil, bad
+			}
+			seen = true
+			start = before
+			for start < len(body) && (body[start] == ':' || body[start] == ' ' || body[start] == '\n' || body[start] == '\t' || body[start] == '\r') {
+				start++
+			}
+			end = int(d.InputOffset())
+		case "stream":
+			var stream *bool
+			if json.Unmarshal(value, &stream) != nil || stream == nil || *stream {
+				return "", nil, bad
+			}
+		}
+	}
+	if _, err = d.Token(); err != nil || !seen {
+		return "", nil, bad
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return "", nil, bad
+	}
+	if upstream == "" || model == upstream {
+		return model, append([]byte(nil), body...), nil
+	}
+	replacement, _ := json.Marshal(upstream)
+	out := make([]byte, 0, len(body)+len(replacement))
+	out = append(out, body[:start]...)
+	out = append(out, replacement...)
+	out = append(out, body[end:]...)
+	return model, out, nil
+}
