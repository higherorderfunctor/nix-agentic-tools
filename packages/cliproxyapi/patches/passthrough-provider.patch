diff --git a/internal/watcher/synthesizer/passthrough.go b/internal/watcher/synthesizer/passthrough.go
new file mode 100644
index 0000000..371c760
--- /dev/null
+++ b/internal/watcher/synthesizer/passthrough.go
@@ -0,0 +1,52 @@
+package synthesizer
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func (s *ConfigSynthesizer) synthesizePassthrough(ctx *SynthesisContext) []*coreauth.Auth {
+	var out []*coreauth.Auth
+	for i, group := range ctx.Config.Passthrough {
+		if group.Disabled {
+			continue
+		}
+		provider := group.ProviderKey()
+		// The watcher compares attributes. Path, models and policy changes must replace
+		// the old auth even though its credential identity stays stable across reloads.
+		keys := group.APIKeyEntries
+		group.APIKeyEntries = nil
+		raw, _ := json.Marshal(group)
+		hash := sha256.Sum256(raw)
+		for j, key := range keys {
+			id, token := ctx.IDGenerator.Next(provider, key.APIKey, group.BaseURL)
+			attrs := map[string]string{
+				"api_key":          key.APIKey,
+				"base_url":         group.BaseURL,
+				"config_hash":      hex.EncodeToString(hash[:]),
+				"config_index":     strconv.Itoa(i),
+				"key_index":        strconv.Itoa(j),
+				"passthrough_path": group.Path,
+				"priority":         strconv.Itoa(group.Priority),
+				"provider_key":     provider,
+				"source":           fmt.Sprintf("config:%s[%s]", provider, token),
+			}
+			metadata := map[string]any{}
+			if group.DisableCooling != nil {
+				metadata["disable_cooling"] = *group.DisableCooling
+			}
+			addRequestRetryToMetadata(group.RequestRetry, metadata)
+			addRequestScopedErrorsToMetadata(group.RequestScopedErrors, metadata)
+			out = append(out, &coreauth.Auth{
+				ID: id, Provider: provider, Label: group.Name, Status: coreauth.StatusActive,
+				Attributes: attrs, Metadata: metadata, CreatedAt: ctx.Now, UpdatedAt: ctx.Now,
+			})
+		}
+	}
+	return out
+}
diff --git a/internal/watcher/synthesizer/passthrough_test.go b/internal/watcher/synthesizer/passthrough_test.go
new file mode 100644
index 0000000..fa13e1b
--- /dev/null
+++ b/internal/watcher/synthesizer/passthrough_test.go
@@ -0,0 +1,140 @@
+package synthesizer
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+)
+
+func passthroughGroups() *config.Config {
+	return &config.Config{Passthrough: []config.Passthrough{
+		{Name: "free", BaseURL: "https://upstream.example", Path: "/decision", Priority: 30, APIKeyEntries: []config.PassthroughKey{{APIKey: "shared"}, {APIKey: "other"}}, Models: []config.PassthroughModel{{Name: "free-upstream", Alias: "decision"}}},
+		{Name: "paid", BaseURL: "https://upstream.example", Path: "/paid", APIKeyEntries: []config.PassthroughKey{{APIKey: "shared"}}, Models: []config.PassthroughModel{{Name: "paid-upstream", Alias: "decision"}}},
+	}}
+}
+
+func passthroughAuths(t *testing.T, cfg *config.Config) []*coreauth.Auth {
+	t.Helper()
+	auths, err := NewConfigSynthesizer().Synthesize(&SynthesisContext{Config: cfg, Now: time.Unix(1, 0), IDGenerator: NewStableIDGenerator()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return auths
+}
+
+// Group and credential both contribute to identity. Reloading a path preserves
+// identity but changes attributes, and disabling a group removes its auths.
+func TestPassthroughSynthesisReload(t *testing.T) {
+	cfg := passthroughGroups()
+	zero, cooling := 0, false
+	cfg.Passthrough[0].RequestRetry = &zero
+	cfg.Passthrough[0].DisableCooling = &cooling
+	first := passthroughAuths(t, cfg)
+	if len(first) != 3 || first[0].ID == first[1].ID || first[0].ID == first[2].ID {
+		t.Fatal("group/key identities collide")
+	}
+	if first[0].Provider != "passthrough-free" || first[0].Attributes["priority"] != "30" || first[0].Metadata["request_retry"] != 0 || first[0].Metadata["disable_cooling"] != false {
+		t.Fatal("group policy not synthesized")
+	}
+	for _, a := range first {
+		if !coreauth.IsConfigAPIKeyAuth(a) || a.AuthKind() != coreauth.AuthKindAPIKey {
+			t.Fatal("config credential misclassified")
+		}
+	}
+	cfg.Passthrough[0].Path = "/changed"
+	second := passthroughAuths(t, cfg)
+	if first[0].ID != second[0].ID || first[0].Attributes["config_hash"] == second[0].Attributes["config_hash"] || second[0].Attributes["passthrough_path"] != "/changed" {
+		t.Fatal("reload retains stale path")
+	}
+	cfg.Passthrough[0].Disabled = true
+	remaining := passthroughAuths(t, cfg)
+	if len(remaining) != 1 || remaining[0].ID != first[2].ID || remaining[0].Attributes["config_index"] != "1" {
+		t.Fatal("disabled group synthesized or shifted identity")
+	}
+}
+
+type passthroughAliasExecutor struct{ provider string }
+
+func (e passthroughAliasExecutor) Identifier() string { return e.provider }
+func (e passthroughAliasExecutor) Execute(_ context.Context, _ *coreauth.Auth, req executor.Request, _ executor.Options) (executor.Response, error) {
+	return executor.Response{Payload: []byte(req.Model)}, nil
+}
+func (e passthroughAliasExecutor) ExecuteStream(context.Context, *coreauth.Auth, executor.Request, executor.Options) (*executor.StreamResult, error) {
+	return nil, errors.New("unused")
+}
+func (e passthroughAliasExecutor) Refresh(_ context.Context, a *coreauth.Auth) (*coreauth.Auth, error) {
+	return a, nil
+}
+func (e passthroughAliasExecutor) CountTokens(context.Context, *coreauth.Auth, executor.Request, executor.Options) (executor.Response, error) {
+	return executor.Response{}, errors.New("unused")
+}
+func (e passthroughAliasExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("unused")
+}
+
+// Use real synthesized auths in the conductor: a shared URL/key must not resolve
+// the paid alias from the free group. A file-sourced fake apikey gets no grant.
+func TestPassthroughAliasAndAllowlist(t *testing.T) {
+	cfg := passthroughGroups()
+	cfg.KeyAllowlist = []config.KeyAllowlist{
+		{APIKey: "free-client", Credentials: []config.KeyAllowlistCredential{{Provider: "passthrough-free", Kind: "apikey"}}},
+		{APIKey: "paid-client", Credentials: []config.KeyAllowlistCredential{{Provider: "passthrough-paid", Kind: "apikey"}}},
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.SetRetryConfig(0, 0, 0)
+	reg := registry.GetGlobalRegistry()
+	for _, a := range passthroughAuths(t, cfg) {
+		reg.RegisterClient(a.ID, a.Provider, []*registry.ModelInfo{{ID: "decision"}})
+		id := a.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		manager.RegisterExecutor(passthroughAliasExecutor{a.Provider})
+		if _, err := manager.Register(context.Background(), a); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, tc := range []struct{ key, provider, want string }{
+		{"free-client", "passthrough-free", "free-upstream"},
+		{"paid-client", "passthrough-paid", "paid-upstream"},
+		{"unknown", "passthrough-free", ""},
+		{"free-client", "passthrough-paid", ""},
+	} {
+		t.Run(tc.key+"/"+tc.provider, func(t *testing.T) {
+			response, err := manager.Execute(usage.WithAPIKey(context.Background(), tc.key), []string{tc.provider}, executor.Request{Model: "decision"}, executor.Options{})
+			if tc.want == "" {
+				if err == nil {
+					t.Fatal("ungranted client selected a credential")
+				}
+				return
+			}
+			if err != nil || string(response.Payload) != tc.want {
+				t.Fatalf("alias result %q, error %v; want %q", response.Payload, err, tc.want)
+			}
+		})
+	}
+	fake := &coreauth.Auth{ID: "passthrough-file-fake", Provider: "passthrough-free", Attributes: map[string]string{"api_key": "fake", "source": "file:fake"}, Status: coreauth.StatusActive}
+	fakeManager := coreauth.NewManager(nil, nil, nil)
+	fakeManager.SetConfig(cfg)
+	fakeManager.RegisterExecutor(passthroughAliasExecutor{fake.Provider})
+	reg.RegisterClient(fake.ID, fake.Provider, []*registry.ModelInfo{{ID: "decision"}})
+	t.Cleanup(func() { reg.UnregisterClient(fake.ID) })
+	if _, err := fakeManager.Register(context.Background(), fake); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fakeManager.Execute(usage.WithAPIKey(context.Background(), "free-client"), []string{fake.Provider}, executor.Request{Model: "decision"}, executor.Options{}); err == nil {
+		t.Fatal("file API key matched config-only allowlist")
+	}
+	// Reordered config must not bind an old index to another group's models.
+	cfg.Passthrough[0], cfg.Passthrough[1] = cfg.Passthrough[1], cfg.Passthrough[0]
+	if cfg.PassthroughGroup("passthrough-free", "0") != nil {
+		t.Fatal("stale config index resolved another group")
+	}
+}
