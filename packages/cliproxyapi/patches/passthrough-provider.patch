+package passthrough
+
+import (
+	"io"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// Handler uses the same access context and conductor plumbing as other routes.
+type Handler struct{ *handlers.BaseAPIHandler }
+
+// Models satisfies the shared context interface without publishing a catalog.
+func (h *Handler) Models() []map[string]any { return nil }
+func (h *Handler) HandlerType() string      { return coreexecutor.PassthroughProtocol }
+func (h *Handler) Execute(c *gin.Context) {
+	body, err := io.ReadAll(c.Request.Body)
+	if err != nil {
+		h.WriteErrorResponse(c, &interfaces.ErrorMessage{StatusCode: http.StatusBadRequest, Error: err})
+		return
+	}
+	model, _, err := coreexecutor.PassthroughBody(body, "")
+	if err != nil {
+		h.WriteErrorResponse(c, &interfaces.ErrorMessage{StatusCode: http.StatusBadRequest, Error: err})
+		return
+	}
+	ctx, cancel := h.GetContextWithCancel(h, c, c.Request.Context())
+	defer cancel()
+	response, headers, failure := h.ExecuteWithAuthManager(ctx, h.HandlerType(), model, body, "")
+	if failure != nil {
+		h.WriteErrorResponse(c, failure)
+		cancel(failure.Error)
+		return
+	}
+	handlers.WriteUpstreamHeaders(c.Writer.Header(), headers)
+	c.Data(http.StatusOK, "application/json", response)
+}
