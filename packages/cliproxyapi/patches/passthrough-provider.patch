+package registry
+
+import "testing"
+
+// Internal selection needs the private alias. Every public catalog must omit
+// it, including before an allowlist exists, and retain a colliding chat alias.
+func TestPassthroughCatalogIsolation(t *testing.T) {
+	r := GetGlobalRegistry()
+	for _, id := range []string{"passthrough-catalog", "chat-catalog"} {
+		id := id
+		t.Cleanup(func() { r.UnregisterClient(id) })
+	}
+	r.RegisterClient("passthrough-catalog", "passthrough-private", []*ModelInfo{{ID: "private-decision", Type: "passthrough"}, {ID: "shared-decision", Type: "passthrough", OwnedBy: "passthrough-private"}})
+	assertCatalog := func(shared bool) {
+		t.Helper()
+		for _, format := range []string{"openai", "claude", "codex", "gemini"} {
+			found := false
+			for _, model := range r.GetAvailableModels(format) {
+				id, _ := model["id"].(string)
+				name, _ := model["name"].(string)
+				if id == "private-decision" || name == "private-decision" || name == "models/private-decision" {
+					t.Errorf("private alias leaked in %s", format)
+				}
+				if id == "shared-decision" || name == "shared-decision" || name == "models/shared-decision" {
+					found = true
+				}
+			}
+			if shared != found {
+				t.Errorf("shared alias public=%v, want %v in %s", found, shared, format)
+			}
+		}
+		for _, info := range r.GetAvailableModelInfos() {
+			if info.Type == "passthrough" || info.ID == "private-decision" {
+				t.Error("raw info catalog leaked")
+			}
+		}
+		if len(r.GetAvailableModelsByProvider("passthrough-private")) != 0 {
+			t.Error("provider catalog leaked")
+		}
+	}
+	if len(r.GetModelProviders("private-decision")) != 1 {
+		t.Fatal("internal alias unavailable")
+	}
+	assertCatalog(false)
+	r.RegisterClient("chat-catalog", "chat", []*ModelInfo{{ID: "shared-decision", Name: "shared-decision", Type: "openai", OwnedBy: "chat"}})
+	assertCatalog(true)
+	r.UnregisterClient("chat-catalog")
+	assertCatalog(false)
+}
diff --git a/internal/runtime/executor/passthrough_executor.go b/internal/runtime/executor/passthrough_executor.go
new file mode 100644
index 0000000..99eb4bf
--- /dev/null
+++ b/internal/runtime/executor/passthrough_executor.go
@@ -0,0 +1,168 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// PassthroughExecutor submits one raw JSON attempt; the conductor owns retries,
+// credential selection and cooldown. It never invokes a chat translator.
+type PassthroughExecutor struct {
+	cfg      *config.Config
+	provider string
+}
+
+func NewPassthroughExecutor(provider string, cfg *config.Config) *PassthroughExecutor {
+	return &PassthroughExecutor{cfg: cfg, provider: provider}
+}
+func (e *PassthroughExecutor) Identifier() string { return e.provider }
+func (e *PassthroughExecutor) RequestToFormat(coreexecutor.Request, coreexecutor.Options) translator.Format {
+	return translator.FromString(coreexecutor.PassthroughProtocol)
+}
+
+// Reject chat entry and exit protocols even if a caller bypasses route filtering.
+func (e *PassthroughExecutor) Execute(ctx context.Context, auth *coreauth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (resp coreexecutor.Response, err error) {
+	if opts.Stream || opts.SourceFormat.String() != coreexecutor.PassthroughProtocol || coreexecutor.ResponseFormatOrSource(opts).String() != coreexecutor.PassthroughProtocol {
+		return resp, passthroughError{code: http.StatusBadRequest, message: "passthrough protocol required"}
+	}
+	if auth == nil {
+		return resp, passthroughError{code: http.StatusUnauthorized, message: "missing passthrough credential"}
+	}
+	group := e.cfg.PassthroughGroup(auth.Provider, auth.Attributes["config_index"])
+	if group == nil || auth.Provider != e.provider {
+		return resp, passthroughError{code: http.StatusUnauthorized, message: "passthrough group removed"}
+	}
+	_, payload, err := coreexecutor.PassthroughBody(req.Payload, req.Model)
+	if err != nil {
+		return resp, passthroughError{code: http.StatusBadRequest, message: err.Error()}
+	}
+	ctx = helps.EnsureSessionContext(ctx, opts, req.Payload)
+	reporter := helps.NewExecutorUsageReporter(ctx, e, req.Model, auth)
+	defer reporter.TrackFailure(ctx, &err)
+	url := strings.TrimRight(group.BaseURL, "/") + "/" + strings.TrimLeft(group.Path, "/")
+	upstream, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(payload))
+	if err != nil {
+		return resp, errors.New("invalid passthrough request")
+	}
+	upstream.Header.Set("Content-Type", "application/json")
+	upstream.Header.Set("Accept", "application/json")
+	if strings.TrimSpace(auth.Attributes["api_key"]) == "" {
+		return resp, passthroughError{code: http.StatusUnauthorized, message: "missing passthrough API key"}
+	}
+	upstream.Header.Set("Authorization", "Bearer "+auth.Attributes["api_key"])
+	client := helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0)
+	// Redirects can move a secret-bearing raw body to another authority. The
+	// configured destination is the only supported target, including on 307/308.
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	response, err := client.Do(upstream)
+	if err != nil {
+		if ctx.Err() != nil {
+			return resp, ctx.Err()
+		}
+		return resp, errors.New("passthrough upstream request failed")
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return resp, err
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return resp, passthroughError{code: response.StatusCode, message: string(body), retryAfter: passthroughRetryAfter(response.Header)}
+	}
+	detail, err := passthroughUsage(body)
+	if err != nil {
+		return resp, passthroughError{code: http.StatusBadGateway, message: err.Error()}
+	}
+	reporter.Publish(ctx, detail)
+	return coreexecutor.Response{Payload: body, Headers: response.Header.Clone()}, nil
+}
+
+// Missing usage is valid for JSON endpoints; present counters must be integral
+// and nonnegative so malformed upstream accounting cannot be published.
+func passthroughUsage(body []byte) (usage.Detail, error) {
+	var object map[string]json.RawMessage
+	var detail usage.Detail
+	bad := errors.New("invalid passthrough usage")
+	if json.Unmarshal(body, &object) != nil || object == nil {
+		return detail, bad
+	}
+	raw, exists := object["usage"]
+	if !exists {
+		return detail, nil
+	}
+	var counters map[string]json.RawMessage
+	if json.Unmarshal(raw, &counters) != nil || counters == nil {
+		return detail, bad
+	}
+	for _, counter := range []struct {
+		name   string
+		target *int64
+	}{{"input_tokens", &detail.InputTokens}, {"output_tokens", &detail.OutputTokens}} {
+		if value, ok := counters[counter.name]; ok {
+			if string(value) == "null" || json.Unmarshal(value, counter.target) != nil || *counter.target < 0 {
+				return usage.Detail{}, bad
+			}
+		}
+	}
+	if detail.InputTokens > int64(^uint64(0)>>1)-detail.OutputTokens {
+		return usage.Detail{}, bad
+	}
+	detail.TotalTokens = detail.InputTokens + detail.OutputTokens
+	return detail, nil
+}
+
+type passthroughError struct {
+	code       int
+	message    string
+	retryAfter *time.Duration
+}
+
+func (e passthroughError) Error() string              { return e.message }
+func (e passthroughError) StatusCode() int            { return e.code }
+func (e passthroughError) RetryAfter() *time.Duration { return e.retryAfter }
+
+func passthroughRetryAfter(headers http.Header) *time.Duration {
+	raw := headers.Get("Retry-After")
+	if seconds, err := strconv.ParseInt(raw, 10, 32); err == nil && seconds >= 0 {
+		duration := time.Duration(seconds) * time.Second
+		return &duration
+	}
+	if date, err := http.ParseTime(raw); err == nil {
+		duration := time.Until(date)
+		if duration < 0 {
+			duration = 0
+		}
+		return &duration
+	}
+	return nil
+}
+
+func (e *PassthroughExecutor) ExecuteStream(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	return nil, passthroughError{code: http.StatusBadRequest, message: "passthrough streaming is unsupported"}
+}
+func (e *PassthroughExecutor) CountTokens(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, passthroughError{code: http.StatusBadRequest, message: "passthrough token counting is unsupported"}
+}
+func (e *PassthroughExecutor) Refresh(_ context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	return auth, nil
+}
+
+// Management api-call already owns arbitrary authenticated HTTP requests. This
+// executor accepts only the configured JSON endpoint through Execute.
+func (e *PassthroughExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("use management api-call for passthrough HTTP requests")
+}
diff --git a/internal/runtime/executor/passthrough_executor_test.go b/internal/runtime/executor/passthrough_executor_test.go
new file mode 100644
index 0000000..fa5ef36
--- /dev/null
+++ b/internal/runtime/executor/passthrough_executor_test.go
@@ -0,0 +1,136 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+func TestPassthroughExecutorProtocolAndCancellation(t *testing.T) {
+	entered := make(chan struct{})
+	canceled := make(chan struct{})
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Drain the POST body so HTTP/1 disconnect detection can observe cancellation.
+		if _, err := io.Copy(io.Discard, r.Body); err != nil {
+			t.Errorf("read request body: %v", err)
+			return
+		}
+		close(entered)
+		select {
+		case <-r.Context().Done():
+			close(canceled)
+		case <-release:
+		}
+	}))
+	t.Cleanup(func() {
+		close(release)
+		server.Close()
+	})
+	cfg := &config.Config{Passthrough: []config.Passthrough{{Name: "test", BaseURL: server.URL, Path: "/decision"}}}
+	auth := &coreauth.Auth{Provider: "passthrough-test", Attributes: map[string]string{"api_key": "key", "config_index": "0"}}
+	e := NewPassthroughExecutor(auth.Provider, cfg)
+	req := coreexecutor.Request{Model: "upstream", Payload: []byte(`{"model":"alias"}`)}
+	options := coreexecutor.Options{SourceFormat: translator.FromString(coreexecutor.PassthroughProtocol)}
+	for _, protocol := range []string{"claude", "openai", "openai-response", ""} {
+		wrong := options
+		wrong.SourceFormat = translator.FromString(protocol)
+		if _, err := e.Execute(context.Background(), auth, req, wrong); err == nil {
+			t.Errorf("accepted chat entry %q", protocol)
+		}
+		wrong = options
+		wrong.ResponseFormat = translator.FromString("openai")
+		if _, err := e.Execute(context.Background(), auth, req, wrong); err == nil {
+			t.Error("accepted chat exit")
+		}
+	}
+	if _, err := e.ExecuteStream(context.Background(), auth, req, options); err == nil {
+		t.Error("accepted streaming")
+	}
+	if _, err := e.CountTokens(context.Background(), auth, req, options); err == nil {
+		t.Error("accepted counting")
+	}
+	missing := auth.Clone()
+	missing.Attributes["api_key"] = ""
+	if _, err := e.Execute(context.Background(), missing, req, options); err == nil {
+		t.Error("accepted missing upstream key")
+	}
+	select {
+	case <-entered:
+		t.Fatal("refused execution reached upstream")
+	default:
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := e.Execute(ctx, auth, req, options); done <- err }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("upstream not entered")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("cancellation: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("execution did not cancel")
+	}
+	select {
+	case <-canceled:
+	case <-time.After(3 * time.Second):
+		t.Fatal("upstream context did not cancel")
+	}
+}
+
+func TestPassthroughBodyAndUsage(t *testing.T) {
+	raw := []byte(" {\n \"model\" : \"alias\", \"state\":{\"model\":\"nested\"},\"x\":1e2 } ")
+	want := " {\n \"model\" : \"upstream\", \"state\":{\"model\":\"nested\"},\"x\":1e2 } "
+	model, out, err := coreexecutor.PassthroughBody(raw, "upstream")
+	if err != nil || model != "alias" || string(out) != want {
+		t.Fatalf("raw rewrite: %q %q %v", model, out, err)
+	}
+	_, same, err := coreexecutor.PassthroughBody(raw, "alias")
+	if err != nil || string(same) != string(raw) {
+		t.Fatal("unchanged model modified bytes")
+	}
+	for _, bad := range []string{`null`, `[]`, `{"model":"a","model":"b"}`, `{"model":null}`, `{"model":"a"} {}`, `{"model":"decision","stream":null}`, `{"model":"a","stream":true}`, `{"model":"a","stream":"false"}`} {
+		if _, _, err := coreexecutor.PassthroughBody([]byte(bad), "x"); err == nil {
+			t.Errorf("accepted %s", bad)
+		}
+	}
+	for _, tc := range []struct {
+		body          string
+		input, output int64
+		bad           bool
+	}{
+		{`{"answers":[]}`, 0, 0, false},
+		{`{"usage":{"input_tokens":7,"output_tokens":3}}`, 7, 3, false},
+		{`{"usage":{"input_tokens":-1}}`, 0, 0, true},
+		{`{"usage":{"output_tokens":1.5}}`, 0, 0, true},
+		{`{"usage":{"input_tokens":null}}`, 0, 0, true},
+		{`{"usage":{"input_tokens":"1"}}`, 0, 0, true},
+		{`{"usage":{"input_tokens":9223372036854775807,"output_tokens":1}}`, 0, 0, true},
+		{`{"usage":null}`, 0, 0, true},
+	} {
+		detail, err := passthroughUsage([]byte(tc.body))
+		if (err != nil) != tc.bad || (!tc.bad && (detail.InputTokens != tc.input || detail.OutputTokens != tc.output || detail.TotalTokens != tc.input+tc.output)) {
+			t.Errorf("usage %s: %+v %v", tc.body, detail, err)
+		}
+	}
+	retry := passthroughRetryAfter(http.Header{"Retry-After": []string{"120"}})
+	if retry == nil || *retry != 120*time.Second {
+		t.Fatal("lost Retry-After")
+	}
+}
