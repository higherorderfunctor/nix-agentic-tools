{
  "clients": {
    "harness": {
      "grants": ["anthropic"],
      "token_file": "/run/airlock/harness-token"
    }
  },
  "credentials": {
    "claude": {
      "auth": {
        "file": "/run/airlock/claude-token",
        "type": "oauth_bearer"
      },
      "provider": "claude"
    }
  },
  "groups": {
    "anthropic": {
      "intercept": ["api.anthropic.com"],
      "members": { "claude": { "models": [] } },
      "primary": "claude",
      "protocol": "anthropic"
    }
  },
  "listen": "127.0.0.1:8080",
  "providers": { "claude": { "preset": "claude" } },
  "state_dir": "/var/lib/airlock",
  "unknown_hosts": "tunnel"
}
