+def route_model(content: Iterable[ContentType]) -> tuple[str | None, bool]:
+    """Return the model configured for exactly this content set, or the default model.
+
+    :return: The model (None means Semble's own) and whether a configured table had no entry for this set.
+    """
+    selected = sorted({content_type.value for content_type in content})
+    for entry in MODELS:
+        if entry["content"] == selected:
+            return entry["model"], False
+    return DEFAULT_MODEL, bool(MODELS)
