+def _model_keys(*, cli: bool) -> list[str]:
+    """Return the model keys --model accepts. MCP always accepts the default entry."""
+    return [key for key, entry in MODELS.items() if entry["enabled"] or (not cli and key == "default")]
+
+
+def _add_model_arg(p: argparse.ArgumentParser, keys: list[str], *, subcommand: bool = False) -> None:
+    """Add --model. A subcommand copy uses SUPPRESS so it does not clobber a value given before the subcommand."""
+    p.add_argument(
+        "--model",
+        choices=keys,
+        default=argparse.SUPPRESS if subcommand else None,
+        metavar="KEY",
+        help=f"Configured embedding model to use. Choices: {', '.join(keys)}. Default: default.",
+    )
+
+
+def _select_model(parser: argparse.ArgumentParser, key: str | None, *, cli: bool) -> dict:
+    """Return the configured model entry and point Semble at its model, if it names one."""
+    if key is None:
+        key = "default"
+        if cli and not MODELS[key]["enabled"]:
+            parser.error(
+                f"the default model is disabled; pass --model (choose from {', '.join(map(repr, _model_keys(cli=True)))})"
+            )
+    entry = MODELS[key]
+    if entry["model"] is not None:
+        os.environ["SEMBLE_MODEL_NAME"] = entry["model"]
+    return entry
+
+
+def _dispatch_arg(argv: list[str]) -> str | None:
+    """Return the first argument after any leading --model option."""
+    index = 1
+    while index < len(argv):
+        if argv[index] == "--model":
+            index += 2
+        elif argv[index].startswith("--model="):
+            index += 1
+        else:
+            return argv[index]
+    return None
+
+
