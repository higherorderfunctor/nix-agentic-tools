diff --git a/test/thinking.test.ts b/test/thinking.test.ts
new file mode 100644
--- /dev/null
+++ b/test/thinking.test.ts
@@ -0,0 +1,190 @@
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent"
+import { describe, expect, it, vi } from "vitest"
+import { runWorkflow } from "../src/engine/run-workflow.ts"
+import type { AgentRequest } from "../src/engine/types.ts"
+import { createAgentStep, createWorkflow, type ThinkingLevel } from "../src/flow/index.ts"
+import { createPiAgentBridge } from "../src/host/pi-agent.ts"
+import type { ModelRegistry } from "../src/host/pi-agent-messages.ts"
+import { assistantLine, scriptedSubagent } from "./fake-subagent.ts"
+import { agentRequest, createTestHost, tempSessionsDir } from "./helpers.ts"
+
+const registry = { find: () => ({ provider: "test", id: "model" }) } as unknown as ModelRegistry
+const resolver = (args: readonly string[]) => ({ command: "pi", args })
+
+// All workers are scripted; these tests never invoke a harness or an inference endpoint.
+describe("per-step thinking", () => {
+	it("forwards distinct levels for the same model and leaves omission undefined", async () => {
+		const requests: AgentRequest[] = []
+		const { host } = createTestHost({
+			startAgent: (request) => {
+				requests.push(request)
+				return { sendAndAwaitEnd: async () => ({ text: "done" }), getConversation: () => [], dispose: () => {} }
+			},
+		})
+		const workflow = createWorkflow({ name: "thinking" })
+			.then(createAgentStep({ name: "low", model: "test/model", thinking: "low", prompt: () => "go" }))
+			.then(createAgentStep({ name: "high", model: "test/model", thinking: "high", prompt: () => "go" }))
+			.then(createAgentStep({ name: "off", thinking: "off", prompt: () => "go" }))
+			.then(createAgentStep({ name: "default", prompt: () => "go" }))
+			.commit()
+		expect((await runWorkflow(workflow, undefined, host)).status).toBe("completed")
+		expect(requests.map(({ thinking }) => thinking)).toEqual(["low", "high", "off", undefined])
+		expect(requests.slice(0, 2).map(({ model }) => model)).toEqual(["test/model", "test/model"])
+	})
+
+	it.each(["background", "isolated"] as const)(
+		"passes explicit thinking on every %s spawn, including repairs",
+		async (mode) => {
+			const { spawn, calls } = scriptedSubagent(`${assistantLine("done", 1)}\n`)
+			const start = createPiAgentBridge(
+				{ on: () => {} } as unknown as ExtensionAPI,
+				resolver,
+				spawn,
+			)(registry, tempSessionsDir())
+			for (const thinking of ["low", "high", "max", "off", undefined] as const) {
+				const session = start(
+					agentRequest({ [mode]: true, thinking, model: "test/model", stepName: `worker-${thinking}` }),
+				)
+				await session.sendAndAwaitEnd("go")
+				await session.sendAndAwaitEnd("repair")
+				session.dispose()
+			}
+			expect(calls).toHaveLength(10)
+			for (let index = 0; index < calls.length; index++) {
+				const args = calls[index]!.args
+				const level = ["low", "high", "max", "off", undefined][Math.floor(index / 2)]
+				expect(args.includes("--thinking")).toBe(level !== undefined)
+				if (level !== undefined) expect(args[args.indexOf("--thinking") + 1]).toBe(level)
+				if (index % 2 === 1) expect(args[4]).toBe(calls[index - 1]!.args[4])
+			}
+		},
+	)
+
+	it("restores foreground overrides after successful completion before an omitted step", async () => {
+		let level: ThinkingLevel = "medium"
+		const observed: ThinkingLevel[] = []
+		const handlers = new Map<string, (event: unknown, ctx: unknown) => void>()
+		const pi = {
+			on: (event: string, handler: (event: unknown, ctx: unknown) => void) => {
+				handlers.set(event, handler)
+			},
+			getThinkingLevel: () => level,
+			setThinkingLevel: (value: ThinkingLevel) => {
+				level = value
+			},
+			sendMessage: () => {
+				observed.push(level)
+				queueMicrotask(() => {
+					handlers.get("agent_end")!({ messages: [] }, {})
+					handlers.get("agent_settled")!({}, {})
+				})
+			},
+		} as unknown as ExtensionAPI
+		const start = createPiAgentBridge(pi)(registry, tempSessionsDir())
+		for (const thinking of ["low", "high", undefined] as const) {
+			const session = start(agentRequest({ stepName: `worker-${thinking}`, thinking }))
+			await session.sendAndAwaitEnd("go")
+			session.dispose()
+			expect(level).toBe("medium")
+		}
+		expect(observed).toEqual(["low", "high", "medium"])
+	})
+
+	it("restores the selected model baseline after repairs, failure, and cancellation", async () => {
+		let level: ThinkingLevel = "low"
+		const order: string[] = []
+		const pi = {
+			on: () => {},
+			setModel: async () => {
+				level = "medium"
+				order.push("model")
+				return true
+			},
+			getThinkingLevel: () => level,
+			setThinkingLevel: (value: ThinkingLevel) => {
+				level = value
+				order.push(value)
+			},
+			sendMessage: vi.fn(() => {
+				order.push(`send:${level}`)
+				throw new Error("scripted failure")
+			}),
+		} as unknown as ExtensionAPI
+		const start = createPiAgentBridge(pi)(registry, tempSessionsDir())
+		const session = start(agentRequest({ stepName: "foreground", model: "test/model", thinking: "high" }))
+		await expect(session.sendAndAwaitEnd("go")).rejects.toThrow("scripted failure")
+		await expect(session.sendAndAwaitEnd("repair")).rejects.toThrow("scripted failure")
+		session.dispose()
+		expect(order).toEqual(["model", "high", "send:high", "model", "high", "send:high", "medium"])
+		expect(level).toBe("medium")
+		const cancelled = start(agentRequest({ stepName: "cancelled", thinking: "off", signal: AbortSignal.abort() }))
+		await expect(cancelled.sendAndAwaitEnd("go")).rejects.toThrow("aborted")
+		cancelled.dispose()
+		expect(level).toBe("medium")
+		const omitted = start(agentRequest({ stepName: "omitted" }))
+		await expect(omitted.sendAndAwaitEnd("go")).rejects.toThrow("scripted failure")
+		omitted.dispose()
+		expect(level).toBe("medium")
+	})
+	it("restores the actual baseline of each distinct selected model", async () => {
+		let level: ThinkingLevel = "medium"
+		const baselines: Record<string, ThinkingLevel> = { first: "low", second: "max" }
+		const pi = {
+			on: () => {},
+			setModel: async (model: { id: string }) => {
+				level = baselines[model.id]!
+				return true
+			},
+			getThinkingLevel: () => level,
+			setThinkingLevel: (value: ThinkingLevel) => {
+				level = value
+			},
+			sendMessage: () => {
+				throw new Error("scripted failure")
+			},
+		} as unknown as ExtensionAPI
+		const models = { find: (_provider: string, id: string) => ({ id }) } as unknown as ModelRegistry
+		const start = createPiAgentBridge(pi)(models, tempSessionsDir())
+		for (const model of ["first", "second"]) {
+			const session = start(agentRequest({ stepName: model, model: `test/${model}`, thinking: "high" }))
+			await expect(session.sendAndAwaitEnd("go")).rejects.toThrow("scripted failure")
+			expect(level).toBe("high")
+			session.dispose()
+			expect(level).toBe(baselines[model])
+		}
+	})
+
+	it("restores thinking when an active foreground turn is cancelled", async () => {
+		let level: ThinkingLevel = "medium"
+		const handlers = new Map<string, (event: unknown, ctx: unknown) => void>()
+		const pi = {
+			on: (event: string, handler: (event: unknown, ctx: unknown) => void) => {
+				handlers.set(event, handler)
+			},
+			getThinkingLevel: () => level,
+			setThinkingLevel: (value: ThinkingLevel) => {
+				level = value
+			},
+			sendMessage: () => {},
+		} as unknown as ExtensionAPI
+		const controller = new AbortController()
+		const control = {
+			abort: vi.fn(() => {
+				handlers.get("agent_end")!({ messages: [] }, {})
+				handlers.get("agent_settled")!({}, {})
+			}),
+			waitForIdle: () => new Promise<void>(() => {}),
+			isIdle: () => false,
+			hasPendingMessages: () => false,
+		}
+		const start = createPiAgentBridge(pi)(registry, tempSessionsDir(), control as never)
+		const session = start(agentRequest({ stepName: "active", thinking: "high", signal: controller.signal }))
+		const turn = session.sendAndAwaitEnd("go")
+		expect(level).toBe("high")
+		controller.abort()
+		expect((await turn).cancelled).toBe(true)
+		expect(control.abort).toHaveBeenCalledOnce()
+		session.dispose()
+		expect(level).toBe("medium")
+	})
+})
