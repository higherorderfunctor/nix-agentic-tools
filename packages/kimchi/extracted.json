        "multiple": false,
        "names": ["--use-theme"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "name[/name]"
      },
      {
        "help": "Force verbose startup (overrides quietStartup)",
        "multiple": false,
        "names": ["--verbose"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Show the kimchi version",
        "multiple": false,
        "names": ["--version", "-v"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
