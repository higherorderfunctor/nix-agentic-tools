        "names": ["--session-id"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "id"
      },
      {
        "help": "Load a skill file or directory (can be used multiple times)",
        "multiple": true,
        "names": ["--skill"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "path"
