      {
        "help": "Disable startup network operations (same as PI_OFFLINE=1)",
        "multiple": false,
        "names": ["--offline"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Replace the merged permissions config with this file",
        "multiple": false,
        "names": ["--permissions-config"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": "path"
      },
      {
        "help": "Start in plan mode (read-only)",
        "multiple": false,
        "names": ["--plan"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": null
      },
      {
        "help": "Non-interactive mode: process prompt and exit",
        "multiple": false,
        "names": ["--print", "-p"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Load a prompt template file or directory (can be used multiple times)",
        "multiple": true,
        "names": ["--prompt-template"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "path"
      },
      {
        "help": "Provider (default: kimchi-dev)",
        "multiple": false,
        "names": ["--provider"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": "name"
