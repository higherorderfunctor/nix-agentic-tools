  "config": {
    "keys": {
      "apiKey": {
        "project": true,
        "type": "string"
      },
      "api_key": {
        "aliasFor": "apiKey",
        "project": true,
        "type": "string"
      },
      "deviceId": {
        "project": true,
        "type": "string"
      },
      "device_id": {
        "aliasFor": "deviceId",
        "project": true,
        "type": "string"
      },
      "gitTokens": {
        "additionalProperties": {
          "type": "string"
        },
        "project": false,
        "type": "object"
      },
      "llmEndpoint": {
        "project": true,
        "type": "string"
      },
      "maxToolResultChars": {
        "inert": true,
        "project": true,
        "type": "number",
        "warning": "read only to detect obsolete configuration; it has no runtime effect"
      },
      "mcpSearch": {
        "inert": true,
        "project": true,
        "properties": {
          "bm25B": {
            "type": "number"
          },
          "bm25K1": {
            "type": "number"
          },
          "fieldWeights": {
            "properties": {
              "description": {
                "type": "number"
              },
              "name": {
                "type": "number"
              },
              "schemaKey": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "strategy": {
            "enum": ["bm25", "regex"],
            "type": "enum"
          }
        },
        "type": "object",
        "warning": "read only to detect obsolete configuration; it has no runtime effect"
      },
      "mcpSearchLimit": {
        "inert": true,
        "project": true,
        "type": "number",
        "warning": "read only to detect obsolete configuration; it has no runtime effect"
      },
      "migrationState": {
        "enum": ["done", "skip-forever"],
        "project": true,
        "type": "enum"
      },
      "onboarding": {
        "project": false,
        "properties": {
          "hideSessionModeDialog": {
            "type": "boolean"
          },
          "sessionModeWizardSeenAt": {
            "type": "string"
          },
          "studioOnboardingSeenAt": {
            "type": "string"
          },
          "teleportHelpSeenAt": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "preferences": {
        "project": false,
        "properties": {
          "hideTips": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "redaction": {
        "project": true,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "skillPaths": {
        "items": {
          "type": "string"
        },
        "project": true,
        "type": "array"
      },
      "surveys": {
        "additionalProperties": {
          "properties": {
            "seenAt": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "project": false,
        "type": "object"
      },
      "telemetry": {
        "project": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "metricsEndpoint": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "teleport": {
        "project": false,
        "properties": {
          "compactHint": {
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "projectTier": {
      "gatedByProjectTrust": true,
      "honoredKeys": [
        "apiKey",
        "api_key",
        "deviceId",
        "device_id",
        "llmEndpoint",
        "maxToolResultChars",
        "mcpSearch",
        "mcpSearchLimit",
        "migrationState",
        "redaction",
        "skillPaths"
      ]
    }
  },
  "environment": {
    "variables": {
      "KIMCHI_ACTIVE_FERMENT": {
        "consumerOverridable": true,
        "controls": "active ferment identifier inherited by worker processes",
        "readBy": ["kimchi"]
      },
      "KIMCHI_AGENT_PERSONA": {
        "consumerOverridable": true,
        "controls": "persona selected for an agent worker",
        "readBy": ["kimchi"]
      },
      "KIMCHI_API_KEY": {
        "consumerOverridable": true,
        "controls": "Kimchi API authentication; overrides config.json",
        "readBy": ["kimchi"]
      },
      "KIMCHI_AUTO_GIT_INIT": {
        "consumerOverridable": true,
        "controls": "automatic git initialization for ferment work",
        "readBy": ["kimchi"]
      },
      "KIMCHI_CLIPBOARD_FORCE": {
        "consumerOverridable": true,
        "controls": "clipboard backend override",
        "readBy": ["kimchi"]
      },
      "KIMCHI_CODING_AGENT_DIR": {
        "consumerOverridable": false,
        "controls": "Kimchi harness configuration directory",
        "readBy": ["kimchi"],
        "reason": "entry.ts overwrites it with ~/.config/kimchi/harness"
      },
      "KIMCHI_DAP_BINARIES": {
        "consumerOverridable": true,
        "controls": "DAP adapter binary overrides",
        "readBy": ["kimchi"]
      },
      "KIMCHI_DEBUG_PROMPTS": {
        "consumerOverridable": true,
        "controls": "prompt debugging output",
        "readBy": ["kimchi"]
      },
      "KIMCHI_DEBUG_SESSION": {
        "consumerOverridable": true,
        "controls": "session debugging output",
        "readBy": ["kimchi"]
      },
      "KIMCHI_DISABLE_BUILTIN_PROVIDERS": {
        "consumerOverridable": false,
        "controls": "suppression of pi built-in providers",
        "readBy": ["pi"],
        "reason": "entry.ts overwrites it with 1"
      },
      "KIMCHI_FERMENTS_DIR": {
        "consumerOverridable": true,
        "controls": "ferment state directory",
        "readBy": ["kimchi"]
      },
      "KIMCHI_FERMENT_DISABLE_PARALLEL": {
        "consumerOverridable": true,
        "controls": "parallel ferment execution",
        "readBy": ["kimchi"]
      },
      "KIMCHI_FERMENT_LOCK_DIR": {
        "consumerOverridable": true,
        "controls": "ferment lock directory",
        "readBy": ["kimchi"]
      },
      "KIMCHI_FERMENT_LOCK_MAX_AGE_MS": {
        "consumerOverridable": true,
        "controls": "ferment stale-lock age",
        "readBy": ["kimchi"]
      },
      "KIMCHI_IDE_LOCKFILE_DIR": {
        "consumerOverridable": true,
        "controls": "IDE lock-file directory",
        "readBy": ["kimchi"]
      },
      "KIMCHI_LSP_BINARIES": {
        "consumerOverridable": true,
        "controls": "LSP server binary overrides",
        "readBy": ["kimchi"]
      },
      "KIMCHI_MCP_E2E_KEYRING_DIR": {
        "consumerOverridable": true,
        "controls": "MCP end-to-end test keyring directory",
        "readBy": ["kimchi"]
      },
      "KIMCHI_NO_PROXY": {
        "consumerOverridable": true,
        "controls": "explicit proxy bypass list",
        "readBy": ["kimchi"]
      },
      "KIMCHI_NO_UPDATE_CHECK": {
        "consumerOverridable": true,
        "controls": "background Kimchi update check",
        "readBy": ["kimchi"]
      },
      "KIMCHI_OAUTH_TEMPLATE_DIR": {
        "consumerOverridable": false,
        "controls": "OAuth result-page template directory",
        "readBy": ["kimchi"],
        "reason": "entry.ts derives and overwrites it from PI_PACKAGE_DIR"
      },
      "KIMCHI_OLLAMA_HOST": {
        "consumerOverridable": true,
        "controls": "Ollama host URL",
        "readBy": ["kimchi"]
      },
      "KIMCHI_ORIGINAL_PI_CODING_AGENT_DIR": {
