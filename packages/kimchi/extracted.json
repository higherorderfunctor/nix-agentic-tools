{
  "cli": {
    "commands": {
      "kimchi": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi"]
      },
      "kimchi auth": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "auth"]
      },
      "kimchi claude": {
        "help": "Configure Claude Code to use Kimchi (and launch it)",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "claude"]
      },
      "kimchi codex": {
        "help": "Configure Codex to use Kimchi (and launch it)",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "codex"]
      },
      "kimchi config": {
        "help": "Inspect or change kimchi config (e.g. telemetry)",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          },
          {
            "origin": "pi",
            "reachable": false,
            "reason": "Kimchi's top-level dispatcher handles this command first"
          }
        ],
        "path": ["kimchi", "config"]
      },
      "kimchi cursor": {
        "help": "Configure Cursor to use Kimchi",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "cursor"]
      },
      "kimchi gsd2": {
        "help": "Install / configure GSD2 with Kimchi",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "gsd2"]
      },
      "kimchi install": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "install"]
      },
      "kimchi list": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "list"]
      },
      "kimchi login": {
        "help": "Log in via browser and update your API key",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "login"]
      },
      "kimchi mcp": {
        "help": "MCP server utilities (probe and diagnostics)",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "mcp"]
      },
      "kimchi openclaw": {
        "help": "Configure OpenClaw to use Kimchi",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "openclaw"]
      },
      "kimchi opencode": {
        "help": "Configure OpenCode to use Kimchi (and launch it)",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "opencode"]
      },
      "kimchi remove": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "remove"]
      },
      "kimchi resources": {
        "help": "Enable or disable Kimchi hooks, tools, extensions, and plugins",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "resources"]
      },
      "kimchi setup": {
        "help": "Run the interactive setup wizard",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "setup"]
      },
      "kimchi setup-tools": {
        "help": "Configure coding tools in one pass",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "setup-tools"]
      },
      "kimchi uninstall": {
        "implementations": [
          {
            "origin": "pi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "uninstall"]
      },
      "kimchi update": {
        "help": "Check for and install Kimchi/package updates",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          },
          {
            "origin": "pi",
            "reachable": false,
            "reason": "Kimchi's top-level dispatcher handles this command first"
          }
        ],
        "path": ["kimchi", "update"]
      },
      "kimchi version": {
        "help": "Print the kimchi version",
        "implementations": [
          {
            "origin": "kimchi",
            "reachable": true
          }
        ],
        "path": ["kimchi", "version"]
      }
    },
    "globalFlags": [
      {
        "help": "Add session permission allow rules (comma-separated)",
        "multiple": true,
        "names": ["--allow-tool"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": "rule"
      },
      {
        "help": "API key (defaults to env vars)",
        "multiple": false,
        "names": ["--api-key"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "key"
      },
      {
        "help": "Append text or file contents to the system prompt (can be used multiple times)",
        "multiple": true,
        "names": ["--append-system-prompt"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "text"
      },
      {
        "help": "Trust project-local files for this run",
        "multiple": false,
        "names": ["--approve", "-a"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Start in auto mode (run freely, classifier guards)",
        "multiple": false,
        "names": ["--auto"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": null
      },
      {
        "help": "Resume the most recent session",
        "multiple": false,
        "names": ["--continue", "-c"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Add session permission deny rules (comma-separated)",
        "multiple": true,
        "names": ["--deny-tool"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": "rule"
      },
      {
        "help": "Enable experimental features, including the kimchi-dev/auto model",
        "multiple": false,
        "names": ["--enable-experimental-features"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": null
      },
      {
        "help": "Comma-separated denylist of tool names to disable Applies to built-in, extension, and custom tools",
        "multiple": false,
        "names": ["--exclude-tools", "-xt"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "tools"
      },
      {
        "help": "Export a session to HTML and exit",
        "multiple": false,
        "names": ["--export"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": "file"
      },
      {
        "help": "Load an extension file (can be used multiple times)",
        "multiple": true,
        "names": ["--extension", "-e"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "path"
      },
      {
        "help": "Fork specific session file or partial UUID into a new session",
        "multiple": false,
        "names": ["--fork"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "path|id"
      },
      {
        "help": "Show this help",
        "multiple": false,
        "names": ["--help", "-h"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Print available models (optionally fuzzy-filtered)",
        "multiple": false,
        "names": ["--list-models"],
        "optionalValue": true,
        "origin": ["kimchi", "pi"],
        "valueName": "search"
      },
      {
        "help": "Use a specific MCP configuration file",
        "multiple": false,
        "names": ["--mcp-config"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": "path"
      },
      {
        "help": "Output mode: text (default), json, rpc, acp",
        "multiple": false,
        "names": ["--mode"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": "mode"
      },
      {
        "help": "Model id or pattern, optionally `provider/id` and/or `:<thinking>`. Use `multi-model` for orchestrated multi-model mode.",
        "multiple": false,
        "names": ["--model"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": "pattern"
      },
      {
        "help": "Comma-separated model patterns for Ctrl+P cycling Supports globs (anthropic/*, *sonnet*) and fuzzy matching",
        "multiple": false,
        "names": ["--models"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "patterns"
      },
      {
        "help": "Explicitly select multi-model orchestration (same as `--model multi-model`)",
        "multiple": false,
        "names": ["--multi-model"],
        "optionalValue": false,
        "origin": ["kimchi"],
        "valueName": null
      },
      {
        "help": "Set session display name",
        "multiple": false,
        "names": ["--name", "-n"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": "name"
      },
      {
        "help": "Ignore project-local files for this run",
        "multiple": false,
        "names": ["--no-approve"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Disable built-in tools by default but keep extension/custom tools enabled",
        "multiple": false,
        "names": ["--no-builtin-tools", "-nbt"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Disable AGENTS.md and CLAUDE.md discovery and loading",
        "multiple": false,
        "names": ["--no-context-files", "-nc"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Disable extension discovery (explicit -e paths still work)",
        "multiple": false,
        "names": ["--no-extensions", "-ne"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Disable prompt template discovery and loading",
        "multiple": false,
        "names": ["--no-prompt-templates", "-np"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Run ephemerally — don't write a session file",
        "multiple": false,
        "names": ["--no-session"],
        "optionalValue": false,
        "origin": ["kimchi", "pi"],
        "valueName": null
      },
      {
        "help": "Disable skills discovery and loading",
        "multiple": false,
        "names": ["--no-skills", "-ns"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Disable theme discovery and loading",
        "multiple": false,
        "names": ["--no-themes"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
      },
      {
        "help": "Disable all tools by default (built-in and extension)",
        "multiple": false,
        "names": ["--no-tools", "-nt"],
        "optionalValue": false,
        "origin": ["pi"],
        "valueName": null
