{
  "assertions": [
    {
      "id": "autosquash-is-not-a-restructure-recovery",
      "pattern": "git rebase -i --autosquash",
      "present": false
    },
    {
      "id": "do-not-recreate-local-main",
      "pattern": "git (?:checkout -B|switch -C) main\\b",
      "present": false
    },
    {
      "id": "no-interactive-revise-repair",
      "pattern": "git revise -i\\b",
      "present": false
    },
    {
      "id": "no-one-commit-move-repair",
      "pattern": "git move -x\\b",
      "present": false
    },
    {
      "id": "no-unscoped-restack-repair",
      "pattern": "(?:run `git restack`|bare one would restack)",
      "present": false
    },
    {
      "id": "route-forward-move-panics",
      "pattern": "^description:(?:(?!^---$).)*git move -F panics",
      "present": true
    },
    {
      "id": "route-soft-reset-restructures",
      "pattern": "^description:(?:(?!^---$).)*reset --soft",
      "present": true
    },
    {
      "id": "stop-rather-than-run-rewrite-repairs",
      "pattern": "Do not improvise a rebase, move, revise, or restack repair",
      "present": true
    },
    {
      "id": "stop-rather-than-delete-a-global-backup",
      "pattern": "Do not create or delete a generic repository-global backup branch",
      "present": true
    }
  ],
  "block_ids": [],
  "block_roles": [],
  "env": {},
  "expected": {
    "description": "Plan routing must cover restructuring and recovery; the skill must not authorize destructive repairs",
    "invariants": ["I1", "I2", "I3", "I4", "I5", "I6"]
  },
  "id": "R5-unclear-plan",
  "kind": "static-set",
  "path": "skills/stack-plan/SKILL.md",
  "topology": "T4"
}
