+#[test]
+fn test_restack_unresolvable_default_and_explicit_revset_fail_closed() -> eyre::Result<()> {
+    let git = make_git()?;
+    git.init_repo()?;
+    git.detach_head()?;
+    let originals = make_restack_test_stack(&git, "own")?;
+    git.run(&["checkout", "--detach", &originals[0]])?;
+    git.run(&["commit", "--amend", "-m", "amended own root"])?;
+    let replacement = resolve_restack_test_ref(&git, "HEAD")?;
+    git.run(&[
+        "config",
+        "branchless.restack.defaultRevset",
+        CURRENT_STACK_DEFAULT_REVSET,
+    ])?;
+
+    for explicit in [true, false] {
+        let args = if explicit {
+            vec![CURRENT_STACK_DEFAULT_REVSET]
+        } else {
+            vec![]
+        };
+        let (stdout, stderr) = git.branchless_with_options(
+            "restack",
+            &args,
+            &GitRunOptions {
+                expected_exit_code: 1,
+                ..Default::default()
+            },
+        )?;
+        assert!(
+            stdout.is_empty(),
+            "restack must stop before doing work: {stdout}"
+        );
+        let stderr = stderr.replace(CURRENT_STACK_DEFAULT_REVSET, "<default>");
+        if explicit {
+            insta::assert_snapshot!(stderr, @"
+            Evaluation error for expression '<default>': no commit, branch, or reference with the name 'origin/main' could be found
+            ");
+        } else {
+            insta::assert_snapshot!(stderr, @r#"
+            Error: could not resolve branchless.restack.defaultRevset: evaluation error in "<default>": no commit, branch, or reference with the name 'origin/main' could be found; pass a revset explicitly to git restack.
+            "#);
+        }
+        for (suffix, original) in ["root", "middle", "tip"].into_iter().zip(&originals) {
+            assert_eq!(
+                resolve_restack_test_ref(&git, &format!("own-{suffix}"))?,
+                *original
+            );
+        }
+        assert_eq!(resolve_restack_test_ref(&git, "HEAD")?, replacement);
+        let (descendants, _) = git.branchless(
+            "query",
+            &[
+                "--raw",
+                &format!("descendants({replacement}) - {replacement}"),
+            ],
+        )?;
+        assert!(
+            descendants.is_empty(),
+            "commits must stay abandoned: {descendants}"
+        );
+    }
+    Ok(())
+}
