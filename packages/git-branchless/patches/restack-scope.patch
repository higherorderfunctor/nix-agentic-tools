+#[test]
+fn test_restack_default_revset() -> eyre::Result<()> {
+    // Two abandoned sibling stacks distinguish the configured selection, an
+    // explicit override, and the unset draft() default.
+    for (default, explicit, expected) in [
+        (Some("first"), false, [true, false]),
+        (Some("first"), true, [false, true]),
+        (Some("invalid("), true, [false, true]),
+        (Some("none()"), false, [false, false]),
+        (None, false, [true, true]),
+    ] {
+        let git = make_git()?;
+        git.init_repo()?;
+        let mut originals = Vec::new();
+        let mut replacements = Vec::new();
+        for name in ["first", "second"] {
+            git.run(&["checkout", "--detach", "master"])?;
+            let original_oid = git.commit_file(name, 1)?;
+            git.commit_file(&format!("{name}-child"), 2)?;
+            git.run(&["checkout", &original_oid.to_string()])?;
+            git.run(&["commit", "--amend", "-m", &format!("amended {name}")])?;
+            originals.push(original_oid.to_string());
+            replacements.push(git.get_repo()?.get_head_info()?.oid.unwrap());
+        }
+        if let Some(default) = default {
+            let default = if default == "first" {
+                originals[0].as_str()
+            } else {
+                default
+            };
+            git.run(&["config", "branchless.restack.defaultRevset", default])?;
+        }
+        let args = if explicit {
+            vec![originals[1].as_str()]
+        } else {
+            vec![]
+        };
+        git.branchless("restack", &args)?;
+        for (replacement, should_restack) in replacements.iter().zip(expected) {
+            let (descendants, _) = git.branchless(
+                "query",
+                &[
+                    "--raw",
+                    &format!("descendants({replacement}) - {replacement}"),
+                ],
+            )?;
+            assert_eq!(
+                descendants.lines().count(),
+                usize::from(should_restack),
+                "default={default:?}, explicit={explicit}, replacement={replacement}",
+            );
+        }
+    }
+    Ok(())
+}
+
+const CURRENT_STACK_DEFAULT_REVSET: &str =
+    "descendants(roots((stack() & ::HEAD) - ::origin/main)) - ::origin/main";
+
+fn resolve_restack_test_ref(git: &Git, name: &str) -> eyre::Result<String> {
+    let (stdout, _) = git.run(&["rev-parse", name])?;
+    Ok(stdout.trim().to_owned())
+}
+
+fn make_restack_test_stack(git: &Git, prefix: &str) -> eyre::Result<Vec<String>> {
+    let mut commits = Vec::new();
+    for (index, suffix) in ["root", "middle", "tip"].into_iter().enumerate() {
+        let name = format!("{prefix}-{suffix}");
+        let oid = git.commit_file(&name, index.try_into()?)?;
+        git.run(&["branch", &name])?;
+        commits.push(oid.to_string());
+    }
+    Ok(commits)
+}
+
+#[test]
+fn test_restack_current_stack_default_in_linked_worktrees() -> eyre::Result<()> {
+    for amended_index in [0, 1] {
+        // Both worktrees have abandoned descendants and stale branches beyond a
+        // stale local main. Only the current stack's predecessors should be added.
+        let git = make_git()?;
+        git.init_repo()?;
+        git.run(&["branch", "-m", "master", "main"])?;
+        git.run(&["config", "branchless.core.mainBranch", "main"])?;
+        let stale_main = resolve_restack_test_ref(&git, "main")?;
+        git.detach_head()?;
+        let base = git.commit_file("remote-base", 1)?.to_string();
+        git.run(&["update-ref", "refs/remotes/origin/main", &base])?;
+        git.run(&[
+            "config",
+            "branchless.restack.defaultRevset",
+            CURRENT_STACK_DEFAULT_REVSET,
+        ])?;
+
+        let own_wrapper = make_git_worktree(&git, "own")?;
+        let own = &own_wrapper.worktree;
+        let sibling_wrapper = make_git_worktree(&git, "sibling")?;
+        let sibling = &sibling_wrapper.worktree;
+        let own_originals = make_restack_test_stack(own, "own")?;
+        let sibling_originals = make_restack_test_stack(sibling, "sibling")?;
+        sibling.run(&["checkout", "--detach", &sibling_originals[0]])?;
+        sibling.run(&["commit", "--amend", "-m", "amended sibling root"])?;
+        let sibling_replacement = resolve_restack_test_ref(sibling, "HEAD")?;
+
+        own.run(&["checkout", "--detach", &own_originals[amended_index]])?;
+        // Recover the amended root or middle commit through both rewrites.
+        let amended_suffix = ["root", "middle"][amended_index];
+        for iteration in ["once", "twice"] {
+            let message = format!("amended own {amended_suffix} {iteration}");
+            own.run(&["commit", "--amend", "-m", &message])?;
+        }
+        let own_replacement = resolve_restack_test_ref(own, "HEAD")?;
+        own.branchless("restack", &[])?;
+        let mut parent = base.clone();
+        for (index, suffix) in ["root", "middle", "tip"].into_iter().enumerate() {
+            let branch = format!("own-{suffix}");
+            let oid = resolve_restack_test_ref(own, &branch)?;
+            if index < amended_index {
+                assert_eq!(oid, own_originals[index]);
+            } else {
+                assert_ne!(oid, own_originals[index]);
+            }
+            if index == amended_index {
+                assert_eq!(oid, own_replacement);
+            }
+            assert_eq!(
+                resolve_restack_test_ref(own, &format!("{branch}^"))?,
+                parent
+            );
+            parent = oid;
+            assert_eq!(
+                resolve_restack_test_ref(sibling, &format!("sibling-{suffix}"))?,
+                sibling_originals[index],
+                "sibling branch must stay unchanged",
+            );
+            assert_eq!(
+                resolve_restack_test_ref(sibling, &format!("sibling-{suffix}^"))?,
+                if index == 0 {
+                    &base
+                } else {
+                    &sibling_originals[index - 1]
+                }
+                .as_str(),
+                "sibling ancestry must stay unchanged",
+            );
+        }
+        assert_eq!(resolve_restack_test_ref(own, "HEAD")?, own_replacement);
+        assert_eq!(
+            resolve_restack_test_ref(sibling, "HEAD")?,
+            sibling_replacement
+        );
+        let (descendants, _) = own.branchless(
+            "query",
+            &[
+                "--raw",
+                &format!("descendants({sibling_replacement}) - {sibling_replacement}"),
+            ],
+        )?;
+        assert!(
+            descendants.is_empty(),
+            "sibling descendants must stay abandoned: {descendants}"
+        );
+        assert_eq!(resolve_restack_test_ref(own, "main")?, stale_main);
+        assert_eq!(resolve_restack_test_ref(own, "origin/main")?, base);
+    }
+    Ok(())
+}
