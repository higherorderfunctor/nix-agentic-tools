+#[test]
+fn test_restack_explicit_branch_repair_requires_configured_default() -> eyre::Result<()> {
+    for (default, explicit, expected) in [
+        (None, "first", [true, true]),
+        (None, "none()", [true, true]),
+        (Some("none()"), "first", [true, false]),
+        (Some("none()"), "none()", [false, false]),
+    ] {
+        let git = make_git()?;
+        git.init_repo()?;
+        let mut originals = Vec::new();
+        let mut replacements = Vec::new();
+        for name in ["first", "second"] {
+            git.run(&["checkout", "--detach", "master"])?;
+            originals.push(git.commit_file(name, 1)?.to_string());
+            git.run(&["branch", name])?;
+            git.run(&["commit", "--amend", "-m", &format!("amended {name}")])?;
+            replacements.push(resolve_restack_test_ref(&git, "HEAD")?);
+        }
+        if let Some(default) = default {
+            git.run(&["config", "branchless.restack.defaultRevset", default])?;
+        }
+        git.branchless("restack", &[explicit])?;
+        for (index, name) in ["first", "second"].into_iter().enumerate() {
+            let expected_oid = if expected[index] {
+                &replacements[index]
+            } else {
+                &originals[index]
+            };
+            assert_eq!(
+                &resolve_restack_test_ref(&git, name)?,
+                expected_oid,
+                "default={default:?}, explicit={explicit}, branch={name}",
+            );
+        }
+    }
+    Ok(())
+}
