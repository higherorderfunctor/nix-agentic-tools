+/// Add obsolete draft commits whose newest rewrite is in the selection.
+#[instrument]
+fn expand_restack_selection(
+    dag: &Dag,
+    event_replayer: &EventReplayer,
+    event_cursor: EventCursor,
+    selection: CommitSet,
+) -> eyre::Result<CommitSet> {
+    let mut selection: HashSet<NonZeroOid> =
+        dag.commit_set_to_vec(&selection)?.into_iter().collect();
+    // Include hidden rewrite intermediates, but never add public predecessors.
+    let obsolete_draft = dag
+        .query_obsolete_commits()
+        .difference(dag.query_public_commits_slow()?);
+    for oid in dag.commit_set_to_vec(&obsolete_draft)? {
+        if let Some(MaybeZeroOid::NonZero(target)) =
+            find_rewrite_target(event_replayer, event_cursor, oid)
+        {
+            if selection.contains(&target) {
+                selection.insert(oid);
+            }
+        }
+    }
+    Ok(selection.into_iter().collect())
+}
