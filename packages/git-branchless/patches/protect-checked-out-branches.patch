+    /// Open every linked worktree and the main repository if it has a working copy.
+    #[instrument]
+    pub fn get_worktree_repos(&self) -> Result<Vec<Self>> {
+        let parent_repo = self.open_worktree_parent_repo()?;
+        let main_repo = parent_repo.as_ref().unwrap_or(self);
+        let mut repos = Vec::new();
+        if !main_repo.inner.is_bare() {
+            repos.push(main_repo.try_clone()?);
+        }
+        let names = main_repo.inner.worktrees().map_err(Error::ReadWorktrees)?;
+        for name in names.iter() {
+            let name = name.ok_or(Error::DecodeUtf8 {
+                item: "worktree name",
+            })?;
+            let worktree = main_repo
+                .inner
+                .find_worktree(name)
+                .map_err(Error::ReadWorktrees)?;
+            let inner = git2::Repository::open_from_worktree(&worktree).map_err(Error::OpenRepo)?;
+            repos.push(Self { inner });
+        }
+        Ok(repos)
     }

