+/// Refuse a batch of branch changes if any branch is checked out in another worktree.
+/// Worktree discovery errors propagate so that an incomplete scan cannot authorize a move.
+pub fn check_branches_not_checked_out(
+    repo: &Repo,
+    branch_names: &HashSet<ReferenceName>,
+) -> eyre::Result<()> {
+    if branch_names.is_empty() || !get_protect_checked_out_branches(repo)? {
+        return Ok(());
+    }
+
+    let current_git_dir = std::fs::canonicalize(repo.get_path())
+        .wrap_err("Resolving the current worktree Git directory")?;
+    for worktree_repo in repo.get_worktree_repos()? {
+        let git_dir = std::fs::canonicalize(worktree_repo.get_path())
+            .wrap_err("Resolving a worktree Git directory")?;
+        if git_dir == current_git_dir {
+            continue;
+        }
+        let head_info = worktree_repo.get_head_info()?;
+        if let Some(branch_name) = head_info.reference_name {
+            if branch_names.contains(&branch_name) {
+                let path = worktree_repo.get_working_copy_path().ok_or_else(|| {
+                    eyre::eyre!(
+                        "Could not determine worktree path for {}",
+                        branch_name.as_str()
+                    )
+                })?;
+                eyre::bail!(
+                    "cannot force update the branch '{}' used by worktree at '{}'",
+                    CategorizedReferenceName::new(&branch_name).render_suffix(),
+                    path.display(),
+                );
+            }
+        }
+    }
+    Ok(())
+}

