+use std::collections::{HashMap, HashSet};
+use std::time::SystemTime;
+
+use branchless::core::effects::Effects;
+use branchless::core::eventlog::EventLogDb;
+use branchless::core::formatting::Glyphs;
+use branchless::core::repo_ext::RepoExt;
+use branchless::core::rewrite::{
+    ExecuteRebasePlanOptions, RebaseCommand, RebasePlan, execute_rebase_plan, move_branches,
+};
+use branchless::core::worktree::check_branches_not_checked_out;
+use branchless::git::{MaybeZeroOid, NonZeroOid};
+use branchless::testing::{Git, make_git, make_git_worktree};
+
+fn move_branches_for_test(
+    git: &Git,
+    rewritten_oids: &HashMap<NonZeroOid, MaybeZeroOid>,
+) -> eyre::Result<()> {
+    let repo = git.get_repo()?;
+    let conn = repo.get_db_conn()?;
+    let event_log_db = EventLogDb::new(&conn)?;
+    let event_tx_id = event_log_db.make_transaction_id(SystemTime::now(), "test move branches")?;
+    move_branches(
+        &Effects::new_suppress_for_test(Glyphs::text()),
+        &git.get_git_run_info(),
+        &repo,
+        event_tx_id,
+        rewritten_oids,
+    )
+}
+
+#[test]
+fn test_move_branches_worktree_guard_preflights_whole_batch() -> eyre::Result<()> {
+    let git = make_git()?;
+    git.init_repo()?;
+    let old_oid = git.commit_file("topic", 1)?;
+    git.run(&["branch", "a-free"])?;
+    git.run(&["branch", "z-busy"])?;
+    let new_oid = git.commit_file("destination", 2)?;
+    let worktree = make_git_worktree(&git, "linked")?;
+    worktree.worktree.run(&["checkout", "z-busy"])?;
+    let refs_before = git.get_repo()?.get_branch_oid_to_names()?;
+    let status_before = worktree.worktree.run(&["status", "--porcelain"])?;
+    let worktree_path = worktree
+        .worktree
+        .get_repo()?
+        .get_working_copy_path()
+        .unwrap();
+
+    for target in [MaybeZeroOid::NonZero(new_oid), MaybeZeroOid::Zero] {
+        let rewritten_oids = HashMap::from([(old_oid, target)]);
+        let err = move_branches_for_test(&git, &rewritten_oids).unwrap_err();
+        assert_eq!(
+            err.to_string(),
+            format!(
+                "cannot force update the branch 'z-busy' used by worktree at '{}'",
+                worktree_path.display(),
+            ),
+        );
+        assert_eq!(git.get_repo()?.get_branch_oid_to_names()?, refs_before);
+        assert_eq!(
+            worktree.worktree.run(&["status", "--porcelain"])?,
+            status_before
+        );
+    }
+
+    // Rewriting an OID to itself does not move the protected branch.
+    move_branches_for_test(&git, &HashMap::from([(old_oid, old_oid.into())]))?;
+    assert_eq!(git.get_repo()?.get_branch_oid_to_names()?, refs_before);
+
+    git.run(&[
+        "config",
+        "branchless.core.protectCheckedOutBranches",
+        "false",
+    ])?;
+    move_branches_for_test(&git, &HashMap::from([(old_oid, new_oid.into())]))?;
+    for name in ["refs/heads/a-free", "refs/heads/z-busy"] {
+        assert_eq!(
+            git.get_repo()?.reference_name_to_oid(&name.into())?,
+            new_oid.into()
+        );
+    }
+    Ok(())
+}
+
+#[test]
+fn test_worktree_guard_main_sibling_current_and_detached() -> eyre::Result<()> {
+    let git = make_git()?;
+    git.init_repo()?;
+    git.run(&["branch", "topic"])?;
+    git.run(&["branch", "sibling"])?;
+    let linked = make_git_worktree(&git, "linked")?;
+    linked.worktree.run(&["checkout", "topic"])?;
+    let sibling = make_git_worktree(&git, "sibling")?;
+    sibling.worktree.run(&["checkout", "sibling"])?;
+    let repo = linked.worktree.get_repo()?;
+
+    // The current worktree is allowed, from either kind of checkout.
+    check_branches_not_checked_out(&repo, &HashSet::from(["refs/heads/topic".into()]))?;
+    check_branches_not_checked_out(
+        &git.get_repo()?,
+        &HashSet::from(["refs/heads/master".into()]),
+    )?;
+
+    for (name, worktree) in [("master", &*git), ("sibling", &sibling.worktree)] {
+        let err = check_branches_not_checked_out(
+            &repo,
+            &HashSet::from([format!("refs/heads/{name}").into()]),
+        )
+        .unwrap_err();
+        let path = worktree.get_repo()?.get_working_copy_path().unwrap();
+        assert_eq!(
+            err.to_string(),
+            format!(
+                "cannot force update the branch '{name}' used by worktree at '{}'",
+                path.display(),
+            )
+        );
+    }
+
+    sibling.worktree.detach_head()?;
+    check_branches_not_checked_out(&repo, &HashSet::from(["refs/heads/sibling".into()]))?;
+    Ok(())
+}
+
+#[test]
+fn test_on_disk_rebase_refuses_before_starting_git() -> eyre::Result<()> {
+    let git = make_git()?;
+    git.init_repo()?;
+    let topic_oid = git.commit_file("topic", 1)?;
+    git.run(&["branch", "topic"])?;
+    let destination_oid = git.commit_file("destination", 2)?;
+    let worktree = make_git_worktree(&git, "linked")?;
+    worktree.worktree.run(&["checkout", "topic"])?;
+    let repo = git.get_repo()?;
+    let head_before = repo.get_head_info()?;
+    let conn = repo.get_db_conn()?;
+    let event_log_db = EventLogDb::new(&conn)?;
+    let now = SystemTime::now();
+    let options = ExecuteRebasePlanOptions {
+        now,
+        event_tx_id: event_log_db.make_transaction_id(now, "test on-disk guard")?,
+        preserve_timestamps: true,
+        force_in_memory: false,
+        force_on_disk: true,
+        dry_run: false,
+        resolve_merge_conflicts: false,
+        check_out_commit_options: Default::default(),
+    };
+    let plan = RebasePlan {
+        first_dest_oid: destination_oid,
+        commands: vec![RebaseCommand::Pick {
+            original_commit_oid: topic_oid,
+            commits_to_apply_oids: vec![topic_oid],
+        }],
+    };
+    let err = execute_rebase_plan(
+        &Effects::new_suppress_for_test(Glyphs::text()),
+        &git.get_git_run_info(),
+        &repo,
+        &event_log_db,
+        &plan,
+        &options,
+    )
+    .unwrap_err();
+    assert!(
+        err.to_string()
+            .starts_with("cannot force update the branch 'topic'")
+    );
+    assert_eq!(repo.get_head_info()?, head_before);
+    assert!(!repo.get_rebase_state_dir_path().exists());
+    Ok(())
+}
