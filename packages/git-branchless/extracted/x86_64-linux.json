      "reads": {
        "git-branchless-test/src/lib.rs#resolve": ["repository"]
      },
      "status": "current",
      "type": "enum",
      "values": [
        {
          "description": "Default. Run the tests in the working copy. This requires a clean working copy. This is useful if you want to reuse build artifacts in the current directory.",
          "value": "working-copy"
        },
        {
          "description": "Run the tests in a separate worktree (managed by git-branchless). This is useful if you want to run tests in parallel, or if you want to run tests on a different commit without invalidating build artifacts in the current directory, or if you want to run tests while your working copy is dirty.",
